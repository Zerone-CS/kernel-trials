// Generic runtime-shaped BatchMatmulMaxSum; no benchmark shape dispatch.
// Derived only from the dynamic fused-base implementation of cb59f2e7.
// Tile caps bound on-chip storage; logical dimensions always come from TensorInfo.
#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "tiling/tiling_api.h"
#include "tiling/platform/platform_ascendc.h"
#include <cstdint>
#include <stdexcept>
#include <algorithm>
#include <type_traits>


using namespace AscendC;
using namespace matmul;

namespace fused_base_tile {

constexpr uint32_t kMaxBaseM = 128;

constexpr uint32_t kMaxBaseN = 64;
constexpr float kLowestFloat = -3.402823466e+38f;

struct TilingData {
    AscendC::tiling::TCubeTiling cube;
    uint32_t batch;
    uint32_t m;
    uint32_t n;
    uint32_t k;
    uint32_t mTile;
    uint32_t mBlocks;
    uint32_t nGroups;
    uint32_t workItems;
    uint32_t partialStride;
    uint32_t blockDim;
};

static_assert(sizeof(TilingData) <= 256,
              "fused base-tile parameters exceed the direct-launch limit");

__aicore__ inline uint32_t MinU32(uint32_t lhs, uint32_t rhs)
{
    return lhs < rhs ? lhs : rhs;
}

__aicore__ inline uint32_t Align32(uint32_t bytes)
{
    return (bytes + 31U) / 32U * 32U;
}

template <typename T, bool TRANS_A, bool TRANS_B>
class Kernel {
public:
    using AType = AscendC::MatmulType<AscendC::TPosition::GM,
        CubeFormat::ND, T, TRANS_A>;
    using BType = AscendC::MatmulType<AscendC::TPosition::GM,
        CubeFormat::ND, T, TRANS_B>;
    using CType = AscendC::MatmulType<AscendC::TPosition::GM,
        CubeFormat::ND, float>;
    using BiasType = AscendC::MatmulType<AscendC::TPosition::GM,
        CubeFormat::ND, float>;

    AscendC::Matmul<AType, BType, CType, BiasType> mm;

    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
        GM_ADDR partial, const TilingData &tiling, AscendC::TPipe *pipe)
    {
        tiling_ = tiling;
        x1_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x1),
            static_cast<uint64_t>(tiling.batch) * tiling.m * tiling.k);
        x2_.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x2),
            static_cast<uint64_t>(tiling.batch) * tiling.k * tiling.n);
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y), tiling.batch);
        partial_.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(partial),
            static_cast<uint64_t>(tiling.workItems) * tiling.partialStride);
        uint32_t group = AscendC::GetBlockIdx();
        if ASCEND_IS_AIV { group /= 2; }
        const uint64_t partialElements = uint64_t(tiling.workItems) * tiling.partialStride;
        const uint64_t scratchBase = (partialElements + 127U) / 128U * 128U;
        const uint64_t tileElements = uint64_t(tiling.cube.baseM) * tiling.cube.baseN;
        matrix_.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(partial) +
            scratchBase + uint64_t(group) * tileElements, tileElements);

        const uint32_t tileBytes = static_cast<uint32_t>(
            tiling.cube.baseM * tiling.cube.baseN * sizeof(float));
        const uint32_t rowBytes = Align32(
            static_cast<uint32_t>(tiling.cube.baseM) * sizeof(float));
        pipe->InitBuffer(cQueue_, 1, tileBytes);
        pipe->InitBuffer(tileMaxBuf_, rowBytes);
        pipe->InitBuffer(rowMaxBuf_, rowBytes);
    }

    __aicore__ inline void Process()
    {
        uint32_t group = AscendC::GetBlockIdx();
        if ASCEND_IS_AIV {
            group /= 2;
        }

        if (AscendC::GetSubBlockIdx() != 0) {
            AscendC::SyncAll<true>();
            return;
        }

        for (uint32_t work = group; work < tiling_.workItems;
             work += tiling_.blockDim) {
            Compute(work);
        }

        AscendC::DataCacheCleanAndInvalid<float,
            AscendC::CacheLine::ENTIRE_DATA_CACHE,
            AscendC::DcciDst::CACHELINE_OUT>(partial_);
        AscendC::SyncAll<true>();

        if (group == 0U) {
            for (uint32_t b = 0; b < tiling_.batch; ++b) {
                float total = 0.0f;
                float compensation = 0.0f;
                for (uint32_t mb = 0; mb < tiling_.mBlocks; ++mb) {
                    const uint32_t mStart = mb * tiling_.mTile;
                    const uint32_t validM = MinU32(tiling_.mTile, tiling_.m - mStart);
                    const uint32_t firstWork =
                        (b * tiling_.mBlocks + mb) * tiling_.nGroups;
                    for (uint32_t row = 0; row < validM; ++row) {
                        float rowMax = kLowestFloat;
                        for (uint32_t ng = 0; ng < tiling_.nGroups; ++ng) {
                            const uint64_t offset =
                                static_cast<uint64_t>(firstWork + ng) * tiling_.partialStride + row;
                            const float value = partial_.GetValue(offset);
                            rowMax = value > rowMax ? value : rowMax;
                        }
                        const float corrected = rowMax - compensation;
                        const float next = total + corrected;
                        compensation = (next - total) - corrected;
                        total = next;
                    }
                }
                y_.SetValue(b, total);
            }
            AscendC::DataCacheCleanAndInvalid<float,
                AscendC::CacheLine::ENTIRE_DATA_CACHE,
                AscendC::DcciDst::CACHELINE_OUT>(y_);
        }
    }

private:
    __aicore__ inline void Compute(uint32_t work)
    {
        const uint32_t nGroup = work % tiling_.nGroups;
        const uint32_t batchM = work / tiling_.nGroups;
        const uint32_t mBlock = batchM % tiling_.mBlocks;
        const uint32_t b = batchM / tiling_.mBlocks;
        const uint32_t mStart = mBlock * tiling_.mTile;
        const uint32_t validM = MinU32(tiling_.mTile, tiling_.m - mStart);
        const uint32_t baseN = static_cast<uint32_t>(tiling_.cube.baseN);
        const uint32_t totalNBlocks = (tiling_.n + baseN - 1U) / baseN;
        const uint32_t firstNBlock =
            nGroup * totalNBlocks / tiling_.nGroups;
        const uint32_t lastNBlock =
            (nGroup + 1U) * totalNBlocks / tiling_.nGroups;
        const uint32_t nStart = firstNBlock * baseN;
        const uint32_t nEnd = MinU32(tiling_.n, lastNBlock * baseN);
        const uint32_t shardN = nEnd - nStart;

        const uint64_t lhsBatch =
            static_cast<uint64_t>(b) * tiling_.m * tiling_.k;
        const uint64_t rhsBatch =
            static_cast<uint64_t>(b) * tiling_.k * tiling_.n;
        const uint64_t lhsOffset = lhsBatch +
            (TRANS_A ? mStart : static_cast<uint64_t>(mStart) * tiling_.k);
        const uint64_t rhsOffset = rhsBatch +
            (TRANS_B ? static_cast<uint64_t>(nStart) * tiling_.k : nStart);

        AscendC::LocalTensor<float> rowMax = rowMaxBuf_.Get<float>();
        AscendC::LocalTensor<float> tileMax = tileMaxBuf_.Get<float>();
        AscendC::Duplicate(rowMax, kLowestFloat,
            static_cast<uint32_t>(tiling_.cube.baseM));
        AscendC::PipeBarrier<PIPE_V>();

        mm.SetTensorA(x1_[lhsOffset], TRANS_A);
        mm.SetTensorB(x2_[rhsOffset], TRANS_B);
        mm.SetSingleShape(validM, shardN, tiling_.k);

        uint32_t localNBlock = 0;
        while (mm.template Iterate<true>()) {
            AscendC::LocalTensor<float> cTile = cQueue_.AllocTensor<float>();
            const uint32_t localNStart = localNBlock * baseN;
            const uint32_t validN = MinU32(baseN, shardN - localNStart);
            // Use a separately sized per-group GM tile. Own the GM-to-UB
            // layout explicitly instead of relying on library scratch reuse.
            mm.template GetTensorC<true>(matrix_, false, true);
            AscendC::DataCopyPad(cTile, matrix_,
                AscendC::DataCopyExtParams{static_cast<uint16_t>(validM),
                    validN * sizeof(float), 0, 0, 0},
                AscendC::DataCopyPadExtParams<float>{true, 0,
                    static_cast<uint8_t>(Align32(validN * sizeof(float)) / sizeof(float) - validN), 0});
            auto ready = GetTPipePtr()->FetchEventID(HardEvent::MTE2_V);
            SetFlag<HardEvent::MTE2_V>(ready);
            WaitFlag<HardEvent::MTE2_V>(ready);
            const uint32_t srcRepeatStride =
                Align32(validN * sizeof(float)) / 32U;
            AscendC::WholeReduceMax<float, true>(
                tileMax, cTile, static_cast<int32_t>(validN),
                static_cast<int32_t>(validM), 1, 1,
                static_cast<int32_t>(srcRepeatStride),
                AscendC::ReduceOrder::ORDER_ONLY_VALUE);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Max(rowMax, rowMax, tileMax, validM);
            // cTile is the next iteration's MTE2 destination. A PIPE_V-only
            // barrier does not order that DMA after these vector reads.
            AscendC::PipeBarrier<PIPE_ALL>();
            cQueue_.FreeTensor(cTile);
            ++localNBlock;
        }
        mm.End();

        // Every task writes row maxima, including a single N shard.
        // The final owner sums rows in logical order with compensation.
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(
            partial_[static_cast<uint64_t>(work) * tiling_.partialStride],
            rowMax, tiling_.partialStride);
        AscendC::PipeBarrier<PIPE_ALL>();

    }

private:
    AscendC::GlobalTensor<T> x1_;
    AscendC::GlobalTensor<T> x2_;
    AscendC::GlobalTensor<float> y_;
    AscendC::GlobalTensor<float> partial_;
    AscendC::GlobalTensor<float> matrix_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> cQueue_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> tileMaxBuf_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> rowMaxBuf_;
    TilingData tiling_;
};

template <typename T, bool TRANS_A, bool TRANS_B>
__aicore__ inline void Run(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    GM_ADDR partial, GM_ADDR systemWorkspace, int64_t workspacePerCore,
    const TilingData &tiling, AscendC::TPipe *pipe)
{
    uint32_t group = AscendC::GetBlockIdx();
    if ASCEND_IS_AIV {
        group /= 2;
    }
    GM_ADDR coreWorkspace = systemWorkspace + group * workspacePerCore;
    AscendC::SetSysWorkspaceForce(coreWorkspace);
    AscendC::clearWorkspace(coreWorkspace);
    Kernel<T, TRANS_A, TRANS_B> op;
    REGIST_MATMUL_OBJ(pipe, coreWorkspace, op.mm, &tiling.cube);
    op.Init(x1, x2, y, partial, tiling, pipe);
    op.Process();
}

}

#define DEFINE_FUSED_BASE_KERNEL(NAME, TYPE, TRANS_A, TRANS_B)                 \
    extern "C" __global__ __aicore__ void NAME(                              \
        GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR partial,                   \
        GM_ADDR systemWorkspace, int64_t workspacePerCore,                    \
        fused_base_tile::TilingData tiling)                                   \
    {                                                                          \
        KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);                    \
        AscendC::TPipe pipe;                                                   \
        fused_base_tile::Run<TYPE, TRANS_A, TRANS_B>(                         \
            x1, x2, y, partial, systemWorkspace, workspacePerCore,            \
            tiling, &pipe);                                                    \
    }

DEFINE_FUSED_BASE_KERNEL(batch_matmul_fused_fp16_nn, half, false, false)
DEFINE_FUSED_BASE_KERNEL(batch_matmul_fused_fp16_tn, half, true, false)
DEFINE_FUSED_BASE_KERNEL(batch_matmul_fused_fp16_nt, half, false, true)
DEFINE_FUSED_BASE_KERNEL(batch_matmul_fused_fp16_tt, half, true, true)
DEFINE_FUSED_BASE_KERNEL(batch_matmul_fused_bf16_nn, bfloat16_t, false, false)
DEFINE_FUSED_BASE_KERNEL(batch_matmul_fused_bf16_tn, bfloat16_t, true, false)
DEFINE_FUSED_BASE_KERNEL(batch_matmul_fused_bf16_nt, bfloat16_t, false, true)
DEFINE_FUSED_BASE_KERNEL(batch_matmul_fused_bf16_tt, bfloat16_t, true, true)

inline uint32_t FusedCeilDiv(uint32_t value, uint32_t divisor)
{
    return value / divisor + (value % divisor != 0);
}

inline bool GenerateFusedBaseTiling(
    platform_ascendc::PlatformAscendC *platform, int32_t dtype,
    bool transposeX1, bool transposeX2, uint32_t batch, uint32_t m,
    uint32_t n, uint32_t k, uint32_t maxCores,
    fused_base_tile::TilingData &data)
{
    if (platform == nullptr || maxCores == 0 || batch == 0 || m == 0 ||
        n == 0 || k == 0) {
        return false;
    }

    const uint32_t requestedM =
        m < fused_base_tile::kMaxBaseM ? m : fused_base_tile::kMaxBaseM;
    const uint32_t requestedBaseM = ((requestedM + 15U) / 16U * 16U) <
            fused_base_tile::kMaxBaseM ?
        ((requestedM + 15U) / 16U * 16U) : fused_base_tile::kMaxBaseM;
    const uint32_t requestedBaseN = ((n + 15U) / 16U * 16U) <
            fused_base_tile::kMaxBaseN ?
        ((n + 15U) / 16U * 16U) : fused_base_tile::kMaxBaseN;

    uint64_t ubBytes = 0;
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubBytes);
    // Reserve the maximum explicit C tile and both row buffers before sizing
    // the Matmul library's own temporary UB. This bound is shape independent.
    const uint64_t explicitUb = uint64_t(fused_base_tile::kMaxBaseM) *
        fused_base_tile::kMaxBaseN * sizeof(float) +
        2ULL * fused_base_tile::kMaxBaseM * sizeof(float);
    if (ubBytes <= explicitUb || ubBytes - explicitUb > INT32_MAX) return false;
    matmul_tiling::MatmulApiTiling tiling(*platform);
    const auto inputType = dtype == 1 ? matmul_tiling::DataType::DT_FLOAT16
                                      : matmul_tiling::DataType::DT_BFLOAT16;
    if (tiling.SetAType(matmul_tiling::TPosition::GM,
            matmul_tiling::CubeFormat::ND, inputType, transposeX1) != 0 ||
        tiling.SetBType(matmul_tiling::TPosition::GM,
            matmul_tiling::CubeFormat::ND, inputType, transposeX2) != 0 ||
        tiling.SetCType(matmul_tiling::TPosition::GM,
            matmul_tiling::CubeFormat::ND,
            matmul_tiling::DataType::DT_FLOAT) != 0 ||
        tiling.SetOrgShape(m, n, k) != 0 ||
        tiling.SetShape(requestedM, n, k) != 0 ||
        tiling.SetFixSplit(requestedBaseM, requestedBaseN, -1) != 0 ||
        tiling.SetBias(false) != 0 ||
        tiling.SetBufferSpace(-1, -1, static_cast<int32_t>(ubBytes - explicitUb)) != 0 ||
        tiling.GetTiling(data.cube) == -1) {
        return false;
    }

    if (data.cube.baseM <= 0 ||
        data.cube.baseM > static_cast<int32_t>(fused_base_tile::kMaxBaseM) ||
        data.cube.baseN <= 0 ||
        data.cube.baseN > static_cast<int32_t>(fused_base_tile::kMaxBaseN) ||
        data.cube.singleCoreM <= 0 ||
        data.cube.singleCoreM > data.cube.baseM ||
        data.cube.singleCoreN <= 0) {
        return false;
    }

    const uint32_t mTile = static_cast<uint32_t>(data.cube.singleCoreM);
    const uint32_t baseN = static_cast<uint32_t>(data.cube.baseN);
    const uint32_t mBlocks = FusedCeilDiv(m, mTile);
    const uint32_t nBlocks = FusedCeilDiv(n, baseN);
    const uint64_t naturalWork64 = static_cast<uint64_t>(batch) * mBlocks;
    if (naturalWork64 == 0 || naturalWork64 > UINT32_MAX) {
        return false;
    }
    const uint32_t naturalWork = static_cast<uint32_t>(naturalWork64);
    uint32_t nGroups = 1;
    if (naturalWork < maxCores && nBlocks > 1) {
        nGroups = FusedCeilDiv(maxCores, naturalWork);
        if (nGroups > nBlocks) {
            nGroups = nBlocks;
        }
    }
    const uint64_t workItems64 = naturalWork64 * nGroups;
    if (workItems64 == 0 || workItems64 > UINT32_MAX) {
        return false;
    }
    const uint32_t workItems = static_cast<uint32_t>(workItems64);

    data.batch = batch;
    data.m = m;
    data.n = n;
    data.k = k;
    data.mTile = mTile;
    data.mBlocks = mBlocks;
    data.nGroups = nGroups;
    data.workItems = workItems;
    data.partialStride = FusedCeilDiv(mTile, 8U) * 8U;
    data.blockDim = workItems < maxCores ? workItems : maxCores;
    return data.blockDim != 0;
}

template <typename T>
inline void LaunchFusedBase(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    GM_ADDR partial, GM_ADDR systemWorkspace, int64_t workspacePerCore,
    const fused_base_tile::TilingData &tiling,
    bool transposeX1, bool transposeX2, aclrtStream stream)
{
    if (transposeX1) {
        if (transposeX2) {
            if constexpr (std::is_same<T, half>::value) {
                batch_matmul_fused_fp16_tt<<<tiling.blockDim, nullptr, stream>>>(
                    x1, x2, y, partial, systemWorkspace, workspacePerCore, tiling);
            } else {
                batch_matmul_fused_bf16_tt<<<tiling.blockDim, nullptr, stream>>>(
                    x1, x2, y, partial, systemWorkspace, workspacePerCore, tiling);
            }
        } else if constexpr (std::is_same<T, half>::value) {
            batch_matmul_fused_fp16_tn<<<tiling.blockDim, nullptr, stream>>>(
                x1, x2, y, partial, systemWorkspace, workspacePerCore, tiling);
        } else {
            batch_matmul_fused_bf16_tn<<<tiling.blockDim, nullptr, stream>>>(
                x1, x2, y, partial, systemWorkspace, workspacePerCore, tiling);
        }
    } else if (transposeX2) {
        if constexpr (std::is_same<T, half>::value) {
            batch_matmul_fused_fp16_nt<<<tiling.blockDim, nullptr, stream>>>(
                x1, x2, y, partial, systemWorkspace, workspacePerCore, tiling);
        } else {
            batch_matmul_fused_bf16_nt<<<tiling.blockDim, nullptr, stream>>>(
                x1, x2, y, partial, systemWorkspace, workspacePerCore, tiling);
        }
    } else if constexpr (std::is_same<T, half>::value) {
        batch_matmul_fused_fp16_nn<<<tiling.blockDim, nullptr, stream>>>(
            x1, x2, y, partial, systemWorkspace, workspacePerCore, tiling);
    } else {
        batch_matmul_fused_bf16_nn<<<tiling.blockDim, nullptr, stream>>>(
            x1, x2, y, partial, systemWorkspace, workspacePerCore, tiling);
    }
}

inline bool run_fused_base_tiles(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    int32_t batch, int32_t mSize, int32_t nSize, int32_t kSize,
    int32_t dtype, int64_t availableCoreNum, aclrtStream stream,
    bool transposeX1, bool transposeX2)
{
    auto *platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    fused_base_tile::TilingData tiling{};
    const uint32_t coreLimit = platform == nullptr ? 0U :
        static_cast<uint32_t>(std::min<int64_t>(availableCoreNum,
            std::min<int64_t>(platform->GetCoreNumAic(), platform->GetCoreNumAiv() / 2)));
    if (platform == nullptr || availableCoreNum <= 0 || coreLimit == 0 ||
        !GenerateFusedBaseTiling(platform, dtype, transposeX1, transposeX2,
            static_cast<uint32_t>(batch), static_cast<uint32_t>(mSize),
            static_cast<uint32_t>(nSize), static_cast<uint32_t>(kSize),
            coreLimit, tiling)) {
        return false;
    }

    const size_t partialElements =
        static_cast<size_t>(tiling.workItems) * tiling.partialStride;
    const size_t partialBytes = (partialElements * sizeof(float) + 511U) /
        512U * 512U + static_cast<size_t>(tiling.blockDim) *
            tiling.cube.baseM * tiling.cube.baseN * sizeof(float);
    const size_t libWorkspace = platform->GetLibApiWorkSpaceSize();
    const size_t workspacePerCore = libWorkspace < 512U ? 512U : libWorkspace;
    const size_t workspaceBytes = workspacePerCore * tiling.blockDim;
    uint8_t *partial = nullptr;
    uint8_t *systemWorkspace = nullptr;
    if (aclrtMalloc(reinterpret_cast<void **>(&partial), partialBytes,
            ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS ||
        aclrtMalloc(reinterpret_cast<void **>(&systemWorkspace), workspaceBytes,
            ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        if (partial != nullptr) aclrtFree(partial);
        if (systemWorkspace != nullptr) aclrtFree(systemWorkspace);
        return false;
    }

    if (dtype == 1) {
        LaunchFusedBase<half>(x1, x2, y, partial, systemWorkspace,
            static_cast<int64_t>(workspacePerCore), tiling,
            transposeX1, transposeX2, stream);
    } else {
        LaunchFusedBase<bfloat16_t>(x1, x2, y, partial, systemWorkspace,
            static_cast<int64_t>(workspacePerCore), tiling,
            transposeX1, transposeX2, stream);
    }
    const aclError result = aclrtSynchronizeStream(stream);
    aclrtFree(partial);
    aclrtFree(systemWorkspace);

    if (result != ACL_SUCCESS) {
        throw std::runtime_error("BatchMatmulMaxSum device execution failed");
    }
    return true;
}

// Degenerate single-output dot-product family for short, aligned K ranges.
// Whole-input dimensions remain runtime metadata; unsupported shapes fall back
// before launch.
namespace tiny_single_output_shortk {

constexpr uint32_t MAX_K = 64;
constexpr uint32_t INPUT_ELEMENTS = 2 * MAX_K;
constexpr uint32_t VALUE_ELEMENTS = 2 * MAX_K;
constexpr uint32_t PRODUCT_ELEMENTS = MAX_K;
constexpr uint32_t SUM_ELEMENTS = 8;

constexpr uint32_t INPUT_OFFSET = 0;
constexpr uint32_t VALUE_OFFSET = INPUT_OFFSET + INPUT_ELEMENTS * 2;
constexpr uint32_t PRODUCT_OFFSET = VALUE_OFFSET + VALUE_ELEMENTS * sizeof(float);
constexpr uint32_t SUM_OFFSET = PRODUCT_OFFSET + PRODUCT_ELEMENTS * sizeof(float);
constexpr uint32_t UB_BYTES = SUM_OFFSET + SUM_ELEMENTS * sizeof(float);

static_assert(UB_BYTES == 1056, "short-dot static UB layout changed");
static_assert(VALUE_OFFSET % 32 == 0 && PRODUCT_OFFSET % 32 == 0 &&
    SUM_OFFSET % 32 == 0, "short-dot UB slices must remain 32-byte aligned");

template <typename T, bool SINGLE_BATCH, bool ONE_CORE>
__aicore__ inline void Run(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    uint32_t batch, uint32_t k, uint32_t blocks)
{
    InitSocState();
    LocalTensor<T> input(TPosition::VECCALC, INPUT_OFFSET, INPUT_ELEMENTS);
    LocalTensor<float> values(TPosition::VECCALC, VALUE_OFFSET, VALUE_ELEMENTS);
    LocalTensor<float> product(TPosition::VECCALC, PRODUCT_OFFSET, PRODUCT_ELEMENTS);
    LocalTensor<float> sum(TPosition::VECCALC, SUM_OFFSET, SUM_ELEMENTS);
    GlobalTensor<T> lhs;
    GlobalTensor<T> rhs;
    GlobalTensor<float> output;
    lhs.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x1),
        static_cast<uint64_t>(batch) * k);
    rhs.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x2),
        static_cast<uint64_t>(batch) * k);
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y), batch);

    constexpr event_t copyReady = static_cast<event_t>(0);
    constexpr event_t resultReady = static_cast<event_t>(0);
    const uint32_t firstBatch = ONE_CORE ? 0U : GetBlockIdx();
    const uint32_t stride = ONE_CORE ? 1U : blocks;
    for (uint32_t b = firstBatch; SINGLE_BATCH || b < batch; b += stride) {
        const uint64_t offset = static_cast<uint64_t>(b) * k;
        DataCopy(input, lhs[offset], k);
        DataCopy(input[k], rhs[offset], k);
        SetFlag<HardEvent::MTE2_V>(copyReady);
        WaitFlag<HardEvent::MTE2_V>(copyReady);
        // Keeping the inputs adjacent preserves the old one-Cast schedule.
        Cast(values, input, RoundMode::CAST_NONE, 2 * k);
        PipeBarrier<PIPE_V>();
        // One float mask covers the exact K products and their reduction.
        SetVectorMask<float, MaskMode::NORMAL>(k);
        Mul<float, false>(product, values, values[k], k, uint8_t(1),
            BinaryRepeatParams{1, 1, 1, 8, 8, 8});
        PipeBarrier<PIPE_V>();
        WholeReduceSum<float, false>(sum, product, k, 1, 1, 1, 8);
        SetFlag<HardEvent::V_MTE3>(resultReady);
        WaitFlag<HardEvent::V_MTE3>(resultReady);
        DataCopyPad(output[b], sum, DataCopyExtParams{1, sizeof(float), 0, 0, 0});
        // The next batch reuses sum and all input slices.
        PipeBarrier<PIPE_ALL>();
        if constexpr (SINGLE_BATCH) break;
    }
}

} // namespace tiny_single_output_shortk

namespace tiny_single_output_shortk {
template <typename T, bool SINGLE_BATCH, bool ONE_CORE>
__global__ __vector__ void Kernel(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    uint32_t batch, uint32_t k, uint32_t blocks)
{
    Run<T, SINGLE_BATCH, ONE_CORE>(x1, x2, y, batch, k, blocks);
}
template <typename T, bool SINGLE_BATCH>
inline void LaunchCoreClass(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    uint32_t batch, uint32_t k, uint32_t blocks, aclrtStream stream)
{
    if (blocks == 1U)
        Kernel<T, SINGLE_BATCH, true><<<blocks, nullptr, stream>>>(x1, x2, y, batch, k, blocks);
    else
        Kernel<T, SINGLE_BATCH, false><<<blocks, nullptr, stream>>>(x1, x2, y, batch, k, blocks);
}
template <typename T>
inline void Launch(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    uint32_t batch, uint32_t k, uint32_t blocks, aclrtStream stream)
{
    if (batch == blocks)
        LaunchCoreClass<T, true>(x1, x2, y, batch, k, blocks, stream);
    else
        LaunchCoreClass<T, false>(x1, x2, y, batch, k, blocks, stream);
}
} // namespace tiny_single_output_shortk

inline bool TryRunTinySingleOutputShortK(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    uint32_t batch, uint32_t m, uint32_t n, uint32_t k, int32_t dtype,
    int64_t availableCoreNum, aclrtStream stream, bool transposeX1,
    bool transposeX2)
{
    (void)transposeX1;
    (void)transposeX2;
    if ((dtype != 1 && dtype != 2) || batch == 0 || m != 1 || n != 1 ||
        k < 32 || k > tiny_single_output_shortk::MAX_K || k % 16 != 0 ||
        availableCoreNum <= 0) {
        return false;
    }
    auto *platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (platform == nullptr) return false;
    uint64_t ubBytes = 0;
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubBytes);
    const uint64_t hardware = platform->GetCoreNumAiv();
    const uint64_t blocks = std::min<uint64_t>(static_cast<uint64_t>(batch),
        std::min<uint64_t>(static_cast<uint64_t>(availableCoreNum), hardware));
    if (ubBytes < tiny_single_output_shortk::UB_BYTES || blocks == 0) return false;

    if (dtype == 1) {
        tiny_single_output_shortk::Launch<half>(x1, x2, y, batch, k,
            static_cast<uint32_t>(blocks), stream);
    } else {
        tiny_single_output_shortk::Launch<bfloat16_t>(x1, x2, y, batch, k,
            static_cast<uint32_t>(blocks), stream);
    }
    return true;
}


// BF16 TT small-channel Vector tile family.
//
// TM/TN/TK are inner tile capacities.  Batch and the logical M/N/K geometry,
// all GM addresses, loop counts, and blockDim come from runtime metadata.
// The admitted domain contains many aligned geometries; it is not a benchmark
// shape dispatch.  Every call launches exactly one Vector kernel.
namespace bf16_tt_vector_tile {

constexpr uint32_t TM = 8;
constexpr uint32_t TN = 16;
constexpr uint32_t TK = 128;
constexpr uint32_t MAX_M = 32;
constexpr uint32_t MAX_N = 64;
constexpr uint32_t MAX_K = 512;
constexpr uint32_t A_PITCH = 144;
constexpr uint32_t B_INPUT_OFFSET = TM * A_PITCH;

// Preserve the proven one-tile UB layout.  The wider-A staging area is only
// selected when M has more than one TM tile, so it cannot overlap a live old
// one-tile object.  All addresses are byte offsets and 32-byte aligned.
constexpr uint32_t OLD_A_ADDR = 0;
constexpr uint32_t OLD_PACKED_ADDR = 2048;
constexpr uint32_t INPUT_ADDR = 8192;
constexpr uint32_t OLD_A_FLOAT_ADDR = 20992;
constexpr uint32_t PRODUCT_ADDR = 24576;
constexpr uint32_t DOTS_ADDR = 57344;
constexpr uint32_t MAXIMA_ADDR = 57856;
constexpr uint32_t SUM_ADDR = 57888;
constexpr uint32_t CHUNK_DOTS_ADDR = 57920;
constexpr uint32_t TEMP_MAX_ADDR = 58432;
constexpr uint32_t TILE_SUM_ADDR = 58464;
constexpr uint32_t WIDE_A_ADDR = 58880;
constexpr uint32_t WIDE_A_FLOAT_ADDR = 67072;
constexpr uint32_t UB_HIGH_WATER = WIDE_A_FLOAT_ADDR + MAX_M * TK * sizeof(float);
// Independent scratch is used only by the one-M/N/K-tile BRS reduction.
constexpr uint32_t BLOCK_SUMS_ADDR = UB_HIGH_WATER;
constexpr uint32_t BLOCK_SUMS_ELEMENTS = TM * TN * 8U;
constexpr uint32_t BRS2_UB_HIGH_WATER =
    BLOCK_SUMS_ADDR + BLOCK_SUMS_ELEMENTS * sizeof(float);
static_assert(BLOCK_SUMS_ADDR == 83456U && BRS2_UB_HIGH_WATER == 87552U &&
    BLOCK_SUMS_ADDR % 32U == 0U, "BRS scratch layout changed");

static_assert(B_INPUT_OFFSET == 1152 && UB_HIGH_WATER == 83456,
    "BF16 TT Vector tile layout changed");
static_assert((OLD_A_ADDR | OLD_PACKED_ADDR | INPUT_ADDR | OLD_A_FLOAT_ADDR |
    PRODUCT_ADDR | DOTS_ADDR | MAXIMA_ADDR | SUM_ADDR | CHUNK_DOTS_ADDR |
    TEMP_MAX_ADDR | TILE_SUM_ADDR | WIDE_A_ADDR | WIDE_A_FLOAT_ADDR) % 32U == 0U,
    "BF16 TT Vector tile buffers must be 32-byte aligned");
static_assert(2U * MAX_M <= 255U,
    "TransDataTo5HD source repeat stride must fit its field");

template <bool SingleMTile>
__global__ __vector__ void Kernel(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    uint32_t batchSize, uint32_t runtimeMSize, uint32_t nSize, uint32_t kSize,
    uint32_t blocks)
{
    // Selected only after Supports: one existing TM tile uses the old A layout.
    // N/K/batch and launch geometry remain runtime values in both variants.
    const uint32_t mSize = SingleMTile ? TM : runtimeMSize;
    const uint32_t block = GetBlockIdx();
    InitSocState();

    LocalTensor<bfloat16_t> oldA(TPosition::VECCALC, OLD_A_ADDR, TM * TK);
    LocalTensor<bfloat16_t> oldPacked(TPosition::VECCALC,
        OLD_PACKED_ADDR, 3072);
    LocalTensor<float> inputs(TPosition::VECCALC, INPUT_ADDR, 3200);
    LocalTensor<float> oldAFloat(TPosition::VECCALC,
        OLD_A_FLOAT_ADDR, TM * TK);
    LocalTensor<float> product(TPosition::VECCALC,
        PRODUCT_ADDR, TM * TN * 64);
    LocalTensor<float> dots(TPosition::VECCALC, DOTS_ADDR, TM * TN);
    LocalTensor<float> maxima(TPosition::VECCALC, MAXIMA_ADDR, TM);
    LocalTensor<float> sum(TPosition::VECCALC, SUM_ADDR, 8);
    LocalTensor<float> chunkDots(TPosition::VECCALC,
        CHUNK_DOTS_ADDR, TM * TN);
    LocalTensor<float> tempMax(TPosition::VECCALC, TEMP_MAX_ADDR, TM);
    LocalTensor<float> tileSum(TPosition::VECCALC, TILE_SUM_ADDR, 8);
    LocalTensor<bfloat16_t> wideA(TPosition::VECCALC,
        WIDE_A_ADDR, MAX_M * TK);
    LocalTensor<float> wideAFloat(TPosition::VECCALC,
        WIDE_A_FLOAT_ADDR, MAX_M * TK);
    static_assert((TM + TN) * TK <= MAX_M * TK &&
        (TM + TN) * TK <= 3072U,
        "Combined single-M-tile A/B conversion exceeds existing buffers");

    GlobalTensor<bfloat16_t> aGm;
    GlobalTensor<bfloat16_t> bGm;
    GlobalTensor<float> output;
    aGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(x1),
        static_cast<uint64_t>(batchSize) * kSize * mSize);
    bGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(x2),
        static_cast<uint64_t>(batchSize) * nSize * kSize);
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y), batchSize);

    const BinaryRepeatParams mul{1, 1, 1, 8, 0, 16};
    const TransDataTo5HDParams oldTranspose{false, false, 8, 2, 16};
    SetVectorMask<float, MaskMode::NORMAL>(64);

    for (uint32_t batch = block; batch < batchSize; batch += blocks) {
        const uint64_t aBatch = static_cast<uint64_t>(batch) * kSize * mSize;
        const uint64_t bBatch = static_cast<uint64_t>(batch) * nSize * kSize;

        for (uint32_t m0 = 0; m0 < mSize; m0 += TM) {
            for (uint32_t n0 = 0; n0 < nSize; n0 += TN) {
                for (uint32_t k0 = 0; k0 < kSize; k0 += TK) {
                    const uint64_t aOffset = aBatch + static_cast<uint64_t>(k0) * mSize;
                    const uint64_t bOffset = bBatch + static_cast<uint64_t>(n0) * kSize + k0;

                    if constexpr (SingleMTile) {
                        // A occupies the packed staging prefix, immediately
                        // before the original B region at element 1024.
                        DataCopy(oldPacked, aGm[aOffset], TM * TK);
                    } else {
                        if (mSize == TM) {
                            DataCopy(oldA, aGm[aOffset], TM * TK);
                        } else {
                            DataCopy(wideA, aGm[aOffset], mSize * TK);
                        }
                    }
                    if (kSize == TK) {
                        DataCopy(oldPacked[1024], bGm[bOffset], TN * TK);
                    } else {
                        const DataCopyExtParams copyB{
                            static_cast<uint16_t>(TN), TK * sizeof(bfloat16_t),
                            static_cast<uint32_t>((kSize - TK) * sizeof(bfloat16_t)), 0, 0};
                        const DataCopyPadExtParams<bfloat16_t> noPad{false, 0, 0, 0};
                        DataCopyPad(oldPacked[1024], bGm[bOffset], copyB, noPad);
                    }
                    constexpr event_t copyReady = static_cast<event_t>(0);
                    SetFlag<HardEvent::MTE2_V>(copyReady);
                    WaitFlag<HardEvent::MTE2_V>(copyReady);

                    if constexpr (SingleMTile) {
                        // One count-mode Cast converts the contiguous A/B
                        // staging into the otherwise unused wide float slice.
                        Cast(wideAFloat, oldPacked, RoundMode::CAST_NONE,
                            (TM + TN) * TK);
                    } else {
                        if (mSize == TM) {
                            Cast(oldAFloat, oldA, RoundMode::CAST_NONE, TM * TK);
                        } else {
                            Cast(wideAFloat, wideA, RoundMode::CAST_NONE, mSize * TK);
                        }
                        Cast(inputs[B_INPUT_OFFSET], oldPacked[1024],
                            RoundMode::CAST_NONE, TN * TK);
                    }
                    PipeBarrier<PIPE_V>();

                    uint64_t srcA[16];
                    uint64_t dstA[16];
#pragma unroll
                    for (uint32_t i = 0; i < 16; ++i) {
                        if constexpr (SingleMTile) {
                            srcA[i] = reinterpret_cast<uint64_t>(
                                wideAFloat[i * TM].GetPhyAddr());
                        } else {
                            if (mSize == TM) {
                                srcA[i] = reinterpret_cast<uint64_t>(
                                    oldAFloat[i * TM].GetPhyAddr());
                            } else {
                                srcA[i] = reinterpret_cast<uint64_t>(
                                    wideAFloat[i * mSize + m0].GetPhyAddr());
                            }
                        }
                        dstA[i] = reinterpret_cast<uint64_t>(
                            inputs[(i / 2) * A_PITCH + (i % 2) * TM].GetPhyAddr());
                    }
                    if (mSize == TM) {
                        TransDataTo5HD<float>(dstA, srcA, oldTranspose);
                    } else {
                        const TransDataTo5HDParams transpose{
                            false, false, 8, 2, static_cast<uint8_t>(2U * mSize)};
                        TransDataTo5HD<float>(dstA, srcA, transpose);
                    }
                    PipeBarrier<PIPE_V>();

#pragma unroll
                    for (uint32_t row = 0; row < TM; ++row) {
                        if constexpr (SingleMTile) {
                            Mul<float, false>(product[row * 1024],
                                inputs[row * A_PITCH], wideAFloat[TM * TK],
                                64, TN, mul);
                        } else {
                            Mul<float, false>(product[row * 1024],
                                inputs[row * A_PITCH], inputs[B_INPUT_OFFSET],
                                64, TN, mul);
                        }
                    }
                    PipeBarrier<PIPE_V>();
#pragma unroll
                    for (uint32_t row = 0; row < TM; ++row) {
                        if constexpr (SingleMTile) {
                            MulAddDst<float, float, false>(product[row * 1024],
                                inputs[row * A_PITCH + 64],
                                wideAFloat[TM * TK + 64], 64, TN, mul);
                        } else {
                            MulAddDst<float, float, false>(product[row * 1024],
                                inputs[row * A_PITCH + 64],
                                inputs[B_INPUT_OFFSET + 64], 64, TN, mul);
                        }
                    }
                    PipeBarrier<PIPE_V>();

                    if (k0 == 0U) {
                        WholeReduceSum<float, false>(dots, product,
                            64, TM * TN, 1, 1, 8);
                    } else {
                        WholeReduceSum<float, false>(chunkDots, product,
                            64, TM * TN, 1, 1, 8);
                    }
                    PipeBarrier<PIPE_V>();
                    if (k0 != 0U) {
                        Add(dots, dots, chunkDots, TM * TN);
                        PipeBarrier<PIPE_V>();
                    }
                    // The next GM->UB copy reuses oldA/wideA and oldPacked.
                    // Establish an explicit Vector-to-MTE2 dependency only
                    // when another K/N/M tile follows; the one-tile fast path
                    // keeps the original instruction schedule.
                    if (k0 + TK < kSize || n0 + TN < nSize ||
                        m0 + TM < mSize) {
                        constexpr event_t inputReusable = static_cast<event_t>(1);
                        SetFlag<HardEvent::V_MTE2>(inputReusable);
                        WaitFlag<HardEvent::V_MTE2>(inputReusable);
                    }
                }

                if (n0 == 0U) {
                    WholeReduceMax<float, true>(maxima, dots, TN, TM,
                        1, 1, 2, ReduceOrder::ORDER_ONLY_VALUE);
                } else {
                    WholeReduceMax<float, true>(tempMax, dots, TN, TM,
                        1, 1, 2, ReduceOrder::ORDER_ONLY_VALUE);
                }
                PipeBarrier<PIPE_V>();
                if (n0 != 0U) {
                    Max(maxima, maxima, tempMax, TM);
                    PipeBarrier<PIPE_V>();
                }
            }

            if (m0 == 0U) {
                WholeReduceSum<float, true>(sum, maxima, TM, 1, 1, 1, 8);
            } else {
                WholeReduceSum<float, true>(tileSum, maxima, TM, 1, 1, 1, 8);
            }
            PipeBarrier<PIPE_V>();
            if (m0 != 0U) {
                Add(sum, sum, tileSum, 1);
                PipeBarrier<PIPE_V>();
            }
        }

        constexpr event_t outputReady = static_cast<event_t>(0);
        SetFlag<HardEvent::V_MTE3>(outputReady);
        WaitFlag<HardEvent::V_MTE3>(outputReady);
        DataCopyPad(output[batch], sum, DataCopyExtParams{1, 4, 0, 0, 0});
        PipeBarrier<PIPE_ALL>();
    }
}

// Additional single-M control instances; original Kernel below/above is untouched.
template <bool SingleNTile, bool SingleKTile>
__global__ __vector__ void SingleTileKernel(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    uint32_t batchSize, uint32_t runtimeMSize, uint32_t runtimeNSize, uint32_t runtimeKSize,
    uint32_t blocks)
{
    // Orthogonal tile-count classes cover the complete existing single-M domain.
    // Multi-tile N/K and all batch/core ownership remain runtime metadata.
    (void)runtimeMSize;
    constexpr bool SingleMTile = true;
    constexpr uint32_t mSize = TM;
    const uint32_t nSize = SingleNTile ? TN : runtimeNSize;
    const uint32_t kSize = SingleKTile ? TK : runtimeKSize;
    const uint32_t block = GetBlockIdx();
    InitSocState();

    LocalTensor<bfloat16_t> oldA(TPosition::VECCALC, OLD_A_ADDR, TM * TK);
    LocalTensor<bfloat16_t> oldPacked(TPosition::VECCALC,
        OLD_PACKED_ADDR, 3072);
    LocalTensor<float> inputs(TPosition::VECCALC, INPUT_ADDR, 3200);
    LocalTensor<float> oldAFloat(TPosition::VECCALC,
        OLD_A_FLOAT_ADDR, TM * TK);
    LocalTensor<float> product(TPosition::VECCALC,
        PRODUCT_ADDR, TM * TN * 64);
    LocalTensor<float> dots(TPosition::VECCALC, DOTS_ADDR, TM * TN);
    LocalTensor<float> maxima(TPosition::VECCALC, MAXIMA_ADDR, TM);
    LocalTensor<float> sum(TPosition::VECCALC, SUM_ADDR, 8);
    LocalTensor<float> chunkDots(TPosition::VECCALC,
        CHUNK_DOTS_ADDR, TM * TN);
    LocalTensor<float> tempMax(TPosition::VECCALC, TEMP_MAX_ADDR, TM);
    LocalTensor<float> tileSum(TPosition::VECCALC, TILE_SUM_ADDR, 8);
    LocalTensor<bfloat16_t> wideA(TPosition::VECCALC,
        WIDE_A_ADDR, MAX_M * TK);
    LocalTensor<float> wideAFloat(TPosition::VECCALC,
        WIDE_A_FLOAT_ADDR, MAX_M * TK);
    static_assert((TM + TN) * TK <= MAX_M * TK &&
        (TM + TN) * TK <= 3072U,
        "Combined single-M-tile A/B conversion exceeds existing buffers");

    GlobalTensor<bfloat16_t> aGm;
    GlobalTensor<bfloat16_t> bGm;
    GlobalTensor<float> output;
    aGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(x1),
        static_cast<uint64_t>(batchSize) * kSize * mSize);
    bGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(x2),
        static_cast<uint64_t>(batchSize) * nSize * kSize);
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y), batchSize);

    const BinaryRepeatParams mul{1, 1, 1, 8, 0, 16};
    const TransDataTo5HDParams oldTranspose{false, false, 8, 2, 16};
    SetVectorMask<float, MaskMode::NORMAL>(64);

    for (uint32_t batch = block; batch < batchSize; batch += blocks) {
        const uint64_t aBatch = static_cast<uint64_t>(batch) * kSize * mSize;
        const uint64_t bBatch = static_cast<uint64_t>(batch) * nSize * kSize;

        {
            constexpr uint32_t m0 = 0U;
            for (uint32_t n0 = 0; SingleNTile || n0 < nSize; n0 += TN) {
                for (uint32_t k0 = 0; SingleKTile || k0 < kSize; k0 += TK) {
                    const uint64_t aOffset = aBatch + static_cast<uint64_t>(k0) * mSize;
                    const uint64_t bOffset = bBatch + static_cast<uint64_t>(n0) * kSize + k0;

                    if constexpr (SingleMTile) {
                        // A occupies the packed staging prefix, immediately
                        // before the original B region at element 1024.
                        DataCopy(oldPacked, aGm[aOffset], TM * TK);
                    } else {
                        if (mSize == TM) {
                            DataCopy(oldA, aGm[aOffset], TM * TK);
                        } else {
                            DataCopy(wideA, aGm[aOffset], mSize * TK);
                        }
                    }
                    if constexpr (SingleKTile) {
                        DataCopy(oldPacked[1024], bGm[bOffset], TN * TK);
                    } else {
                        const DataCopyExtParams copyB{
                            static_cast<uint16_t>(TN), TK * sizeof(bfloat16_t),
                            static_cast<uint32_t>((kSize - TK) * sizeof(bfloat16_t)), 0, 0};
                        const DataCopyPadExtParams<bfloat16_t> noPad{false, 0, 0, 0};
                        DataCopyPad(oldPacked[1024], bGm[bOffset], copyB, noPad);
                    }
                    constexpr event_t copyReady = static_cast<event_t>(0);
                    SetFlag<HardEvent::MTE2_V>(copyReady);
                    WaitFlag<HardEvent::MTE2_V>(copyReady);

                    if constexpr (SingleMTile) {
                        // One count-mode Cast converts the contiguous A/B
                        // staging into the otherwise unused wide float slice.
                        Cast(wideAFloat, oldPacked, RoundMode::CAST_NONE,
                            (TM + TN) * TK);
                    } else {
                        if (mSize == TM) {
                            Cast(oldAFloat, oldA, RoundMode::CAST_NONE, TM * TK);
                        } else {
                            Cast(wideAFloat, wideA, RoundMode::CAST_NONE, mSize * TK);
                        }
                        Cast(inputs[B_INPUT_OFFSET], oldPacked[1024],
                            RoundMode::CAST_NONE, TN * TK);
                    }
                    PipeBarrier<PIPE_V>();

                    uint64_t srcA[16];
                    uint64_t dstA[16];
#pragma unroll
                    for (uint32_t i = 0; i < 16; ++i) {
                        if constexpr (SingleMTile) {
                            srcA[i] = reinterpret_cast<uint64_t>(
                                wideAFloat[i * TM].GetPhyAddr());
                        } else {
                            if (mSize == TM) {
                                srcA[i] = reinterpret_cast<uint64_t>(
                                    oldAFloat[i * TM].GetPhyAddr());
                            } else {
                                srcA[i] = reinterpret_cast<uint64_t>(
                                    wideAFloat[i * mSize + m0].GetPhyAddr());
                            }
                        }
                        dstA[i] = reinterpret_cast<uint64_t>(
                            inputs[(i / 2) * A_PITCH + (i % 2) * TM].GetPhyAddr());
                    }
                    if (mSize == TM) {
                        TransDataTo5HD<float>(dstA, srcA, oldTranspose);
                    } else {
                        const TransDataTo5HDParams transpose{
                            false, false, 8, 2, static_cast<uint8_t>(2U * mSize)};
                        TransDataTo5HD<float>(dstA, srcA, transpose);
                    }
                    PipeBarrier<PIPE_V>();

#pragma unroll
                    for (uint32_t row = 0; row < TM; ++row) {
                        if constexpr (SingleMTile) {
                            Mul<float, false>(product[row * 1024],
                                inputs[row * A_PITCH], wideAFloat[TM * TK],
                                64, TN, mul);
                        } else {
                            Mul<float, false>(product[row * 1024],
                                inputs[row * A_PITCH], inputs[B_INPUT_OFFSET],
                                64, TN, mul);
                        }
                    }
                    PipeBarrier<PIPE_V>();
#pragma unroll
                    for (uint32_t row = 0; row < TM; ++row) {
                        if constexpr (SingleMTile) {
                            MulAddDst<float, float, false>(product[row * 1024],
                                inputs[row * A_PITCH + 64],
                                wideAFloat[TM * TK + 64], 64, TN, mul);
                        } else {
                            MulAddDst<float, float, false>(product[row * 1024],
                                inputs[row * A_PITCH + 64],
                                inputs[B_INPUT_OFFSET + 64], 64, TN, mul);
                        }
                    }
                    PipeBarrier<PIPE_V>();

                    if constexpr (SingleNTile && SingleKTile) {
                        LocalTensor<float> blockSums(TPosition::VECCALC,
                            BLOCK_SUMS_ADDR, BLOCK_SUMS_ELEMENTS);
                        // CANN9: repeatTime precedes mask; FP32 dst repeat
                        // stride 1 is 32 bytes (eight contiguous outputs).
                        // First stage: each dot's 64 lanes -> eight block sums.
                        BlockReduceSum<float, false>(blockSums, product,
                            TM * TN, 64, 1, 1, 8);
                        PipeBarrier<PIPE_V>();
                        // Second stage: each repeat consumes eight dots,
                        // reducing each adjacent group of eight block sums.
                        // Sixteen repeats produce all 128 original dot slots.
                        BlockReduceSum<float, false>(dots, blockSums,
                            TM * TN / 8U, 64, 1, 1, 8);
                    } else if (SingleKTile || k0 == 0U) {
                        WholeReduceSum<float, false>(dots, product,
                            64, TM * TN, 1, 1, 8);
                    } else {
                        WholeReduceSum<float, false>(chunkDots, product,
                            64, TM * TN, 1, 1, 8);
                    }
                    PipeBarrier<PIPE_V>();
                    if (!SingleKTile && k0 != 0U) {
                        Add(dots, dots, chunkDots, TM * TN);
                        PipeBarrier<PIPE_V>();
                    }
                    // The next GM->UB copy reuses oldA/wideA and oldPacked.
                    // Establish an explicit Vector-to-MTE2 dependency only
                    // when another K/N/M tile follows; the one-tile fast path
                    // keeps the original instruction schedule.
                    if ((!SingleKTile && k0 + TK < kSize) ||
                        (!SingleNTile && n0 + TN < nSize)) {
                        constexpr event_t inputReusable = static_cast<event_t>(1);
                        SetFlag<HardEvent::V_MTE2>(inputReusable);
                        WaitFlag<HardEvent::V_MTE2>(inputReusable);
                    }
                    if constexpr (SingleKTile) break;
                }

                if (SingleNTile || n0 == 0U) {
                    WholeReduceMax<float, true>(maxima, dots, TN, TM,
                        1, 1, 2, ReduceOrder::ORDER_ONLY_VALUE);
                } else {
                    WholeReduceMax<float, true>(tempMax, dots, TN, TM,
                        1, 1, 2, ReduceOrder::ORDER_ONLY_VALUE);
                }
                PipeBarrier<PIPE_V>();
                if (!SingleNTile && n0 != 0U) {
                    Max(maxima, maxima, tempMax, TM);
                    PipeBarrier<PIPE_V>();
                }
                if constexpr (SingleNTile) break;
            }

            if (m0 == 0U) {
                WholeReduceSum<float, true>(sum, maxima, TM, 1, 1, 1, 8);
            } else {
                WholeReduceSum<float, true>(tileSum, maxima, TM, 1, 1, 1, 8);
            }
            PipeBarrier<PIPE_V>();
            if (m0 != 0U) {
                Add(sum, sum, tileSum, 1);
                PipeBarrier<PIPE_V>();
            }
        }

        constexpr event_t outputReady = static_cast<event_t>(0);
        SetFlag<HardEvent::V_MTE3>(outputReady);
        WaitFlag<HardEvent::V_MTE3>(outputReady);
        DataCopyPad(output[batch], sum, DataCopyExtParams{1, 4, 0, 0, 0});
        PipeBarrier<PIPE_ALL>();
    }
}

inline bool Supports(uint32_t batch, uint32_t m, uint32_t n, uint32_t k,
    int32_t dtype, bool ta, bool tb)
{
    return dtype == 2 && ta && tb && batch > 0U &&
        m >= TM && m <= MAX_M && m % TM == 0U &&
        n >= TN && n <= MAX_N && n % TN == 0U &&
        k >= TK && k <= MAX_K && k % TK == 0U;
}

} // namespace bf16_tt_vector_tile

inline bool TryRunBf16TtVectorTile(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    uint32_t batch, uint32_t m, uint32_t n, uint32_t k, int32_t dtype,
    int64_t availableCoreNum, aclrtStream stream, bool ta, bool tb)
{
    using namespace bf16_tt_vector_tile;
    if (!Supports(batch, m, n, k, dtype, ta, tb) || availableCoreNum <= 0)
        return false;
    auto *platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (platform == nullptr) return false;
    const int64_t aivCores = static_cast<int64_t>(platform->GetCoreNumAiv());
    const int64_t launchLimit = std::min<int64_t>(availableCoreNum, aivCores);
    if (launchLimit <= 0) return false;
    uint64_t ubBytes = 0;
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubBytes);
    const bool useBrs2 = m / TM == 1U && n / TN == 1U && k / TK == 1U;
    const uint64_t requiredUb = useBrs2 ? BRS2_UB_HIGH_WATER : UB_HIGH_WATER;
    if (ubBytes < requiredUb) return false;
    const uint32_t blocks = static_cast<uint32_t>(
        std::min<int64_t>(launchLimit, static_cast<int64_t>(batch)));
    if (blocks == 0U) return false;
    // This is the existing old-A versus wide-A layout class, not an N/K/batch
    // fingerprint. In the admitted aligned M domain, one M tile implies M=TM.
    const uint32_t mTileCount = m / TM;
    if (mTileCount == 1U) {
        // One/multiple tiles in each axis, not a complete shape or batch signature.
        const bool oneNTile = n / TN == 1U;
        const bool oneKTile = k / TK == 1U;
        if (oneNTile) {
            if (oneKTile) {
                bf16_tt_vector_tile::SingleTileKernel<true, true><<<blocks, nullptr, stream>>>(
                    x1, x2, y, batch, m, n, k, blocks);
            } else {
                bf16_tt_vector_tile::SingleTileKernel<true, false><<<blocks, nullptr, stream>>>(
                    x1, x2, y, batch, m, n, k, blocks);
            }
        } else {
            if (oneKTile) {
                bf16_tt_vector_tile::SingleTileKernel<false, true><<<blocks, nullptr, stream>>>(
                    x1, x2, y, batch, m, n, k, blocks);
            } else {
                bf16_tt_vector_tile::SingleTileKernel<false, false><<<blocks, nullptr, stream>>>(
                    x1, x2, y, batch, m, n, k, blocks);
            }
        }
    } else {
        bf16_tt_vector_tile::Kernel<false><<<blocks, nullptr, stream>>>(
            x1, x2, y, batch, m, n, k, blocks);
    }
    return true;
}


// BF16 TT full-A family for medium/large matrices whose K dimension fits in
// L1 together with two B tiles. Whole-input geometry, work ownership,
// workspace offsets and all tails are derived from runtime metadata. The
// constants below describe only the reusable on-chip tile class.
namespace raw_bf16_tt_fulla_m112n64 {

constexpr uint32_t TM = 112;
constexpr uint32_t TN = 64;
constexpr uint32_t BK = 128;
constexpr uint32_t MAX_K_CHUNK = 144;
constexpr uint32_t TILE = TM * TN;
constexpr uint32_t A_L0_SLOT = TM * MAX_K_CHUNK;
constexpr uint32_t B_L0_SLOT = MAX_K_CHUNK * TN;
constexpr uint32_t C_SLOT = TILE;
constexpr uint32_t INPUT_BYTES = TILE * sizeof(float);
constexpr uint32_t WORK_BYTES = 32768;
constexpr uint32_t ROW_BYTES = TM * sizeof(float);
constexpr uint32_t UB_BYTES = INPUT_BYTES + WORK_BYTES + 2 * ROW_BYTES;
constexpr uint64_t L0A_BYTES = 2ULL * A_L0_SLOT * sizeof(bfloat16_t);
constexpr uint64_t L0B_BYTES = 2ULL * B_L0_SLOT * sizeof(bfloat16_t);
constexpr uint64_t L0C_BYTES = 2ULL * C_SLOT * sizeof(float);
constexpr uint64_t WORKSPACE_BUDGET_BYTES = 64ULL * 1024 * 1024;
constexpr uint16_t READY = 8;
constexpr uint16_t CONSUMED = 9;
constexpr float LOWEST = -3.402823466e+38f;

struct Plan {
    uint32_t batch;
    uint32_t m;
    uint32_t n;
    uint32_t k;
    uint32_t kPad;
    uint32_t mBlocks;
    uint32_t nBlocks;
    uint32_t nParts;
    uint32_t kChunks;
    uint32_t finalChunkK;
    uint32_t workItems;
    uint32_t blockDim;
    uint64_t scratchElements;
    uint64_t partialElements;
};

struct LaunchPlan {
    uint32_t batch, m, n, k, nParts, blockDim;
};
__aicore__ inline Plan Expand(LaunchPlan p)
{
    Plan d{};
    d.batch=p.batch; d.m=p.m; d.n=p.n; d.k=p.k;
    d.nParts=p.nParts; d.blockDim=p.blockDim;
    d.kPad=(p.k+15U)/16U*16U;
    d.mBlocks=(p.m+TM-1U)/TM; d.nBlocks=(p.n+TN-1U)/TN;
    const uint32_t full=d.kPad/BK, rem=d.kPad%BK;
    d.kChunks=full+(rem!=0 && !(rem==16U && full!=0));
    d.finalChunkK=rem==0?BK:((rem==16U && full!=0)?BK+rem:rem);
    d.workItems=p.batch*d.mBlocks*p.nParts;
    d.scratchElements=2ULL*p.blockDim*TILE;
    d.partialElements=static_cast<uint64_t>(d.workItems)*TM;
    return d;
}

static_assert(sizeof(Plan) <= 128,
    "Direct launch metadata capacity for dynamic BF16 TT full-A plan");
static_assert(L0A_BYTES == 64512 && L0B_BYTES == 36864 &&
    L0C_BYTES == 57344 && UB_BYTES == 62336,
    "M112/N64 tile class must fit the target memory hierarchy");

__aicore__ inline uint32_t PartFirstBlock(uint32_t part, const Plan &d)
{
    return static_cast<uint32_t>(
        static_cast<uint64_t>(part) * d.nBlocks / d.nParts);
}

__aicore__ inline uint32_t PartLastBlock(uint32_t part, const Plan &d)
{
    return static_cast<uint32_t>(
        static_cast<uint64_t>(part + 1U) * d.nBlocks / d.nParts);
}

                                                                        
                                                                            
                                                         
__aicore__ inline uint32_t SequenceNBlock(uint32_t sequence,
    uint32_t mBlock, uint32_t firstBlock, uint32_t lastBlock,
    const Plan &d)
{
    const uint32_t tiles = lastBlock - firstBlock;
    return firstBlock + (sequence + mBlock) % tiles;
}

__aicore__ inline void LoadAPhased(const LocalTensor<bfloat16_t> &dst,
    const GlobalTensor<bfloat16_t> &src,uint64_t batchOffset,uint32_t mStart,
    uint32_t mCount,uint32_t mBlock,uint32_t part,const Plan &d)
{
    const uint32_t start=((mBlock+part)%4U)*(d.k/(4U*16U)*16U);
    if(start!=0) {
        DataCopy(dst[start*16U],src[batchOffset+static_cast<uint64_t>(start)*d.m+mStart],
            Nd2NzParams{1,static_cast<uint16_t>(d.k-start),static_cast<uint16_t>(mCount),
                0,static_cast<uint16_t>(d.m),static_cast<uint16_t>(d.kPad),1,0});
        DataCopy(dst,src[batchOffset+mStart],
            Nd2NzParams{1,static_cast<uint16_t>(start),static_cast<uint16_t>(mCount),
                0,static_cast<uint16_t>(d.m),static_cast<uint16_t>(d.kPad),1,0});
    } else {
        DataCopy(dst,src[batchOffset+mStart],
            Nd2NzParams{1,static_cast<uint16_t>(d.k),static_cast<uint16_t>(mCount),
                0,static_cast<uint16_t>(d.m),static_cast<uint16_t>(d.kPad),1,0});
    }
}

__aicore__ inline void Run(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    GM_ADDR scratchGm, GM_ADDR partialGm, const Plan &d)
{
    const uint32_t group = GetBlockIdx();
    const uint64_t scratchOffset = 2ULL * group * TILE;
    const uint32_t bSlotElements = TN * d.kPad;
    TPipe pipe;
    GlobalTensor<float> scratch;
    scratch.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(scratchGm),
        d.scratchElements);

    if ASCEND_IS_AIC {
        GlobalTensor<bfloat16_t> lhs;
        GlobalTensor<bfloat16_t> rhs;
        lhs.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(x1),
            static_cast<uint64_t>(d.batch) * d.m * d.k);
        rhs.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(x2),
            static_cast<uint64_t>(d.batch) * d.n * d.k);

        TBuf<TPosition::A1> a1Buffer;
        TBuf<TPosition::B1> b1Buffer;
        TBuf<TPosition::A2> a2Buffer;
        TBuf<TPosition::B2> b2Buffer;
        TBuf<TPosition::CO1> cBuffer;
        pipe.InitBuffer(a1Buffer,
            static_cast<uint64_t>(TM) * d.kPad * sizeof(bfloat16_t));
        pipe.InitBuffer(b1Buffer,
            2ULL * bSlotElements * sizeof(bfloat16_t));
        pipe.InitBuffer(a2Buffer, L0A_BYTES);
        pipe.InitBuffer(b2Buffer, L0B_BYTES);
        pipe.InitBuffer(cBuffer, L0C_BYTES);
        auto a1 = a1Buffer.Get<bfloat16_t>();
        auto b1 = b1Buffer.Get<bfloat16_t>();
        auto a2 = a2Buffer.Get<bfloat16_t>();
        auto b2 = b2Buffer.Get<bfloat16_t>();
        auto c = cBuffer.Get<float>();

        const TEventID l0Consumed[2] = {
            pipe.AllocEventID<HardEvent::M_MTE1>(),
            pipe.AllocEventID<HardEvent::M_MTE1>()};
        const TEventID l0Ready[2] = {
            pipe.AllocEventID<HardEvent::MTE1_M>(),
            pipe.AllocEventID<HardEvent::MTE1_M>()};
        const TEventID bReady[2] = {
            pipe.AllocEventID<HardEvent::MTE2_MTE1>(),
            pipe.AllocEventID<HardEvent::MTE2_MTE1>()};
        const TEventID cReusable[2] = {
            pipe.AllocEventID<HardEvent::FIX_M>(),
            pipe.AllocEventID<HardEvent::FIX_M>()};
        const TEventID bReusable[2] = {
            pipe.AllocEventID<HardEvent::MTE1_MTE2>(),
            pipe.AllocEventID<HardEvent::MTE1_MTE2>()};
        const auto cReady = pipe.FetchEventID(HardEvent::M_FIX);

        for (uint32_t task = group; task < d.workItems;
             task += d.blockDim) {
            const uint32_t part = task % d.nParts;
            const uint32_t batchM = task / d.nParts;
            const uint32_t mBlock = batchM % d.mBlocks;
            const uint32_t batch = batchM / d.mBlocks;
            const uint32_t firstM = mBlock * TM;
            const uint32_t validM = d.m - firstM < TM ? d.m - firstM : TM;
            const uint32_t padM = (validM + 15U) / 16U * 16U;
            const uint32_t firstBlock = PartFirstBlock(part, d);
            const uint32_t lastBlock = PartLastBlock(part, d);
            const uint32_t tiles = lastBlock - firstBlock;
            const uint64_t aBatchOffset =
                static_cast<uint64_t>(batch) * d.m * d.k;
            const uint64_t bBatchOffset =
                static_cast<uint64_t>(batch) * d.n * d.k;

            const uint32_t firstNBlock = SequenceNBlock(
                0, mBlock, firstBlock, lastBlock, d);
            const uint32_t firstN = firstNBlock * TN;
            const uint32_t firstValidN = d.n - firstN < TN ? d.n - firstN : TN;
            const uint32_t firstPadN = (firstValidN + 15U) / 16U * 16U;
            if((part&1U)!=0) {
            DataCopy(b1, rhs[bBatchOffset +
                    static_cast<uint64_t>(firstN) * d.k],
                Nd2NzParams{1, static_cast<uint16_t>(firstValidN),
                    static_cast<uint16_t>(d.k), 0,
                    static_cast<uint16_t>(d.k),
                    static_cast<uint16_t>(firstPadN), 1, 0});
            SetFlag<HardEvent::MTE2_MTE1>(bReady[0]);

            LoadAPhased(a1,lhs,aBatchOffset,firstM,validM,mBlock,part,d);
            PipeBarrier<PIPE_ALL>();
            if (d.kPad != d.k) {
                InitConstValue(
                    a1[static_cast<uint64_t>(d.k) * 16U]
                        .ReinterpretCast<uint16_t>(),
                    InitConstValueParams<uint16_t>{
                        static_cast<uint16_t>(padM / 16U),
                        static_cast<uint16_t>(d.kPad - d.k),
                        static_cast<uint16_t>(d.k), 0});
                PipeBarrier<PIPE_ALL>();
            }

            } else {
            LoadAPhased(a1,lhs,aBatchOffset,firstM,validM,mBlock,part,d);
            PipeBarrier<PIPE_ALL>();
            if (d.kPad != d.k) {
                InitConstValue(
                    a1[static_cast<uint64_t>(d.k) * 16U]
                        .ReinterpretCast<uint16_t>(),
                    InitConstValueParams<uint16_t>{
                        static_cast<uint16_t>(padM / 16U),
                        static_cast<uint16_t>(d.kPad - d.k),
                        static_cast<uint16_t>(d.k), 0});
                PipeBarrier<PIPE_ALL>();
            }

            DataCopy(b1, rhs[bBatchOffset +
                    static_cast<uint64_t>(firstN) * d.k],
                Nd2NzParams{1, static_cast<uint16_t>(firstValidN),
                    static_cast<uint16_t>(d.k), 0,
                    static_cast<uint16_t>(d.k),
                    static_cast<uint16_t>(firstPadN), 1, 0});
            SetFlag<HardEvent::MTE2_MTE1>(bReady[0]);

            }

            for (uint32_t sequence = 0; sequence < tiles; ++sequence) {
                const uint32_t nBlock = SequenceNBlock(
                    sequence, mBlock, firstBlock, lastBlock, d);
                const uint32_t nStart = nBlock * TN;
                const uint32_t validN = d.n - nStart < TN ? d.n - nStart : TN;
                const uint32_t padN = (validN + 15U) / 16U * 16U;
                const uint32_t cSlot = sequence & 1U;
                const uint32_t cOffset = cSlot * C_SLOT;
                if (sequence >= 2U) {
                    WaitFlag<HardEvent::FIX_M>(cReusable[cSlot]);
                }
                WaitFlag<HardEvent::MTE2_MTE1>(bReady[cSlot]);

                const uint32_t nextSequence = sequence + 1U;
                if (nextSequence < tiles) {
                    const uint32_t nextSlot = cSlot ^ 1U;
                    if (sequence >= 1U) {
                        WaitFlag<HardEvent::MTE1_MTE2>(bReusable[nextSlot]);
                    }
                    const uint32_t nextBlock = SequenceNBlock(
                        nextSequence, mBlock, firstBlock, lastBlock, d);
                    const uint32_t nextN = nextBlock * TN;
                    const uint32_t nextValidN = d.n - nextN < TN ? d.n - nextN : TN;
                    const uint32_t nextPadN = (nextValidN + 15U) / 16U * 16U;
                    DataCopy(b1[nextSlot * bSlotElements],
                        rhs[bBatchOffset +
                            static_cast<uint64_t>(nextN) * d.k],
                        Nd2NzParams{1,
                            static_cast<uint16_t>(nextValidN),
                            static_cast<uint16_t>(d.k), 0,
                            static_cast<uint16_t>(d.k),
                            static_cast<uint16_t>(nextPadN), 1, 0});
                    SetFlag<HardEvent::MTE2_MTE1>(bReady[nextSlot]);
                }

                for (uint32_t chunk = 0; chunk < d.kChunks; ++chunk) {
                    const uint32_t kStart = chunk * BK;
                    const uint32_t currentK =
                        chunk + 1U == d.kChunks ? d.finalChunkK : BK;
                    const uint32_t slot = chunk & 1U;
                    const uint32_t a2Offset = slot * A_L0_SLOT;
                    const uint32_t b2Offset = slot * B_L0_SLOT;
                    if (chunk >= 2U || sequence > 0U) {
                        WaitFlag<HardEvent::M_MTE1>(l0Consumed[slot]);
                    }

                    const LoadData2DParams loadA{
                        0, static_cast<uint8_t>(currentK / 16U),
                        1, 0, 0, true, 0};
                    for (uint32_t row = 0; row < padM; row += 16U) {
                        LoadData(a2[a2Offset + row * currentK],
                            a1[static_cast<uint64_t>(row / 16U) *
                                    d.kPad * 16U + kStart * 16U], loadA);
                    }
                    const LoadData2DParams loadB{
                        0, static_cast<uint8_t>((currentK / 16U) *
                            (padN / 16U)), 1, 0, 0, false, 0};
                    LoadData(b2[b2Offset],
                        b1[cSlot * bSlotElements + kStart * padN], loadB);
                    SetFlag<HardEvent::MTE1_M>(l0Ready[slot]);
                    WaitFlag<HardEvent::MTE1_M>(l0Ready[slot]);

                    Mmad(c[cOffset], a2[a2Offset], b2[b2Offset],
                        MmadParams{static_cast<uint16_t>(padM),
                            static_cast<uint16_t>(padN),
                            static_cast<uint16_t>(currentK),
                            uint8_t(0), false, chunk == 0});
                    if ((padM / 16U) * (padN / 16U) < 10U) {
                        PipeBarrier<PIPE_M>();
                    }
                    SetFlag<HardEvent::M_MTE1>(l0Consumed[slot]);
                }

                SetFlag<HardEvent::MTE1_MTE2>(bReusable[cSlot]);
                SetFlag<HardEvent::M_FIX>(cReady);
                WaitFlag<HardEvent::M_FIX>(cReady);
                FixpipeParamsV220 fix{};
                fix.nSize = padN;
                fix.mSize = padM;
                fix.srcStride = padM;
                fix.dstStride = TN;
                fix.ndNum = 1;
                if (sequence >= 2U) CrossCoreWaitFlag(CONSUMED);
                Fixpipe<float, float, CFG_ROW_MAJOR>(
                    scratch[scratchOffset + cOffset], c[cOffset], fix);
                SetFlag<HardEvent::FIX_M>(cReusable[cSlot]);
                CrossCoreSetFlag<2, PIPE_FIX>(READY);
            }

            const uint32_t pendingTiles = tiles < 2U ? tiles : 2U;
            for (uint32_t index = 0; index < pendingTiles; ++index) {
                CrossCoreWaitFlag(CONSUMED);
                WaitFlag<HardEvent::MTE1_MTE2>(bReusable[index]);
                WaitFlag<HardEvent::FIX_M>(cReusable[index]);
            }
            const uint32_t pendingK = d.kChunks < 2U ? d.kChunks : 2U;
            for (uint32_t index = 0; index < pendingK; ++index) {
                WaitFlag<HardEvent::M_MTE1>(l0Consumed[index]);
            }
        }

        for (uint32_t index = 0; index < 2U; ++index) {
            pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(bReusable[index]);
            pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(bReady[index]);
            pipe.ReleaseEventID<HardEvent::FIX_M>(cReusable[index]);
            pipe.ReleaseEventID<HardEvent::M_MTE1>(l0Consumed[index]);
            pipe.ReleaseEventID<HardEvent::MTE1_M>(l0Ready[index]);
        }
    }

    if ASCEND_IS_AIV {
        TBuf<TPosition::VECCALC> storage;
        pipe.InitBuffer(storage, UB_BYTES);
        auto input = storage.GetWithOffset<float>(TILE, 0);
        auto work = storage.GetWithOffset<uint8_t>(WORK_BYTES, INPUT_BYTES);
        auto maxLocal = storage.GetWithOffset<float>(TM, INPUT_BYTES + WORK_BYTES);
        auto rowLocal = storage.GetWithOffset<float>(
            TM, INPUT_BYTES + WORK_BYTES + ROW_BYTES);
        GlobalTensor<float> partial;
        GlobalTensor<float> output;
        partial.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(partialGm),
            d.partialElements);
        output.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y), d.batch);
        const auto inputReady = pipe.FetchEventID(HardEvent::MTE2_V);
        const auto rowsReady = pipe.FetchEventID(HardEvent::V_MTE3);
        const auto storeDone = pipe.FetchEventID(HardEvent::MTE3_MTE2);

        for (uint32_t task = group; task < d.workItems;
             task += d.blockDim) {
            const uint32_t part = task % d.nParts;
            const uint32_t batchM = task / d.nParts;
            const uint32_t mBlock = batchM % d.mBlocks;
            const uint32_t firstM = mBlock * TM;
            const uint32_t validM = d.m - firstM < TM ? d.m - firstM : TM;
            const uint32_t firstBlock = PartFirstBlock(part, d);
            const uint32_t lastBlock = PartLastBlock(part, d);
            const uint32_t tiles = lastBlock - firstBlock;
            Duplicate(rowLocal, LOWEST, TM);
            PipeBarrier<PIPE_V>();

            for (uint32_t sequence = 0; sequence < tiles; ++sequence) {
                const uint32_t nBlock = SequenceNBlock(
                    sequence, mBlock, firstBlock, lastBlock, d);
                const uint32_t nStart = nBlock * TN;
                const uint32_t validN = d.n - nStart < TN ? d.n - nStart : TN;
                CrossCoreWaitFlag(READY);
                const DataCopyExtParams copy{
                    static_cast<uint16_t>(validM),
                    static_cast<uint32_t>(validN * sizeof(float)),
                    static_cast<uint32_t>((TN - validN) * sizeof(float)), 0, 0};
                const uint32_t cSlot = sequence & 1U;
                DataCopyPad(input,
                    scratch[scratchOffset + cSlot * C_SLOT], copy,
                    DataCopyPadExtParams<float>{false, 0, 0, 0});
                SetFlag<HardEvent::MTE2_V>(inputReady);
                WaitFlag<HardEvent::MTE2_V>(inputReady);
                CrossCoreSetFlag<2, PIPE_MTE2>(CONSUMED);
                WholeReduceMax<float, true>(maxLocal, input, validN,
                    static_cast<uint8_t>(validM), 1, 1,
                    static_cast<uint8_t>((validN + 7U) / 8U),
                    ReduceOrder::ORDER_ONLY_VALUE);
                PipeBarrier<PIPE_V>();
                Max(rowLocal, rowLocal, maxLocal, validM);
                PipeBarrier<PIPE_ALL>();
            }

            SetFlag<HardEvent::V_MTE3>(rowsReady);
            WaitFlag<HardEvent::V_MTE3>(rowsReady);
            DataCopy(partial[static_cast<uint64_t>(task) * TM], rowLocal, TM);
            SetFlag<HardEvent::MTE3_MTE2>(storeDone);
            WaitFlag<HardEvent::MTE3_MTE2>(storeDone);
        }

        SyncAll<true>();
        const uint32_t partialPerBatch = d.mBlocks * d.nParts * TM;
        for (uint32_t batch = group; batch < d.batch; batch += d.blockDim) {
            DataCopyPad(input,
                partial[static_cast<uint64_t>(batch) * partialPerBatch],
                DataCopyExtParams{1,
                    static_cast<uint32_t>(partialPerBatch * sizeof(float)),
                    0, 0, 0},
                DataCopyPadExtParams<float>{false, 0, 0, 0});
            PipeBarrier<PIPE_ALL>();

            if (d.nParts == 2U) {
                SetVectorMask<float, MaskMode::NORMAL>(64);
                Max<float, false>(input, input, input[TM], 64,
                    static_cast<uint8_t>(d.mBlocks),
                    BinaryRepeatParams{1, 1, 1, 14, 28, 28});
                PipeBarrier<PIPE_V>();
                SetVectorMask<float, MaskMode::NORMAL>(48);
                Max<float, false>(input[64], input[64], input[TM + 64], 48,
                    static_cast<uint8_t>(d.mBlocks),
                    BinaryRepeatParams{1, 1, 1, 14, 28, 28});
                PipeBarrier<PIPE_V>();
            } else if (d.nParts > 2U) {
                for (uint32_t mBlock = 0; mBlock < d.mBlocks; ++mBlock) {
                    const uint32_t destination = mBlock * TM;
                    const uint32_t first = mBlock * d.nParts * TM;
                    if (destination != first) {
                        DataCopy(input[destination], input[first], TM);
                        PipeBarrier<PIPE_ALL>();
                    }
                    for (uint32_t part = 1; part < d.nParts; ++part) {
                        Max(input[destination], input[destination],
                            input[first + part * TM], TM);
                        PipeBarrier<PIPE_V>();
                    }
                }
            }

            uint32_t sumShape[2] = {1, d.m};
            ReduceSum<float, Pattern::Reduce::AR>(
                rowLocal, input, work, sumShape, true);
            PipeBarrier<PIPE_ALL>();
            DataCopyPad(output[batch], rowLocal,
                DataCopyExtParams{1, sizeof(float), 0, 0, 0});
            PipeBarrier<PIPE_ALL>();
        }
    }
}

}                                       

extern "C" __global__ __aicore__ void batch_matmul_raw_bf16_tt_fulla_m112n64(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR scratch, GM_ADDR partial,
    raw_bf16_tt_fulla_m112n64::LaunchPlan launch)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
    const auto plan=raw_bf16_tt_fulla_m112n64::Expand(launch);
    raw_bf16_tt_fulla_m112n64::Run(x1, x2, y, scratch, partial, plan);
}

inline bool GenerateRawBf16TtFullAM112N64Plan(
    platform_ascendc::PlatformAscendC *platform, uint32_t batch,
    uint32_t m, uint32_t n, uint32_t k, int64_t availableCoreNum,
    raw_bf16_tt_fulla_m112n64::Plan &plan)
{
    using namespace raw_bf16_tt_fulla_m112n64;
    if (platform == nullptr || availableCoreNum <= 0 || batch == 0 ||
        m == 0 || n == 0 || k == 0 || k % 8U != 0) {
        return false;
    }

    const uint64_t hardware = std::min<uint64_t>(
        platform->GetCoreNumAic(), platform->GetCoreNumAiv());
    const uint64_t coreLimit64 = std::min<uint64_t>(
        static_cast<uint64_t>(availableCoreNum), hardware);
    if (coreLimit64 == 0 || coreLimit64 > UINT32_MAX) return false;

    const uint64_t kPad64 = (static_cast<uint64_t>(k) + 15U) / 16U * 16U;
    if (kPad64 > UINT16_MAX) return false;
    const uint32_t kPad = static_cast<uint32_t>(kPad64);
    const uint32_t fullChunks = kPad / BK;
    const uint32_t remainder = kPad % BK;
    uint32_t kChunks = 0;
    uint32_t finalChunkK = 0;
    if (remainder == 0) {
        kChunks = fullChunks;
        finalChunkK = BK;
    } else if (remainder == 16U && fullChunks != 0) {
        kChunks = fullChunks;
        finalChunkK = BK + remainder;
    } else {
        kChunks = fullChunks + 1U;
        finalChunkK = remainder;
    }
    if (kChunks == 0 || finalChunkK == 0 ||
        finalChunkK > MAX_K_CHUNK || finalChunkK % 16U != 0) {
        return false;
    }

    uint64_t l1 = 0;
    uint64_t l0a = 0;
    uint64_t l0b = 0;
    uint64_t l0c = 0;
    uint64_t ub = 0;
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1, l1);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A, l0a);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B, l0b);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C, l0c);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ub);
    const uint64_t l1Bytes =
        static_cast<uint64_t>(TM) * kPad * sizeof(bfloat16_t) +
        2ULL * TN * kPad * sizeof(bfloat16_t);
    if (l1Bytes > l1 || L0A_BYTES > l0a || L0B_BYTES > l0b ||
        L0C_BYTES > l0c || UB_BYTES > ub) {
        return false;
    }

    uint32_t maximum = 0;
    uint32_t minimum = 0;
    GetReduceMaxMaxMinTmpSize(ge::Shape({TM, TN}), ge::DT_FLOAT,
        ReducePattern::AR, true, false, maximum, minimum);
    if (maximum > WORK_BYTES || minimum > WORK_BYTES) return false;
    GetReduceSumMaxMinTmpSize(ge::Shape({1, m}), ge::DT_FLOAT,
        ReducePattern::AR, true, false, maximum, minimum);
    if (maximum > WORK_BYTES || minimum > WORK_BYTES) return false;

    const uint64_t mBlocks = (static_cast<uint64_t>(m) + TM - 1U) / TM;
    const uint64_t nBlocks = (static_cast<uint64_t>(n) + TN - 1U) / TN;
    const uint64_t natural = static_cast<uint64_t>(batch) * mBlocks;
    const uint64_t desiredParts = natural < coreLimit64 ?
        (coreLimit64 + natural - 1U) / natural : 1U;
    const uint64_t nParts = std::min(nBlocks, desiredParts);
    const uint64_t workItems = natural * nParts;
    const uint64_t blockDim = std::min(coreLimit64, workItems);
    const uint64_t partialPerBatch = mBlocks * nParts * TM;
    const uint64_t scratchElements = 2ULL * blockDim * TILE;
    const uint64_t partialElements = workItems * TM;
    const uint64_t workspaceBytes =
        (scratchElements + partialElements) * sizeof(float);
    if (mBlocks == 0 || nBlocks == 0 || nParts == 0 ||
        workItems == 0 || workItems > coreLimit64 ||
        workItems > UINT32_MAX || blockDim == 0 ||
        blockDim > UINT32_MAX || partialPerBatch > TILE ||
        scratchElements > SIZE_MAX / sizeof(float) ||
        partialElements > SIZE_MAX / sizeof(float) ||
        workspaceBytes > WORKSPACE_BUDGET_BYTES) {
        return false;
    }

    plan.batch = batch;
    plan.m = m;
    plan.n = n;
    plan.k = k;
    plan.kPad = kPad;
    plan.mBlocks = static_cast<uint32_t>(mBlocks);
    plan.nBlocks = static_cast<uint32_t>(nBlocks);
    plan.nParts = static_cast<uint32_t>(nParts);
    plan.kChunks = kChunks;
    plan.finalChunkK = finalChunkK;
    plan.workItems = static_cast<uint32_t>(workItems);
    plan.blockDim = static_cast<uint32_t>(blockDim);
    plan.scratchElements = scratchElements;
    plan.partialElements = partialElements;
    return true;
}

inline bool TryRunRawBf16TtFullAM112N64(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y, uint32_t batch,
    uint32_t m, uint32_t n, uint32_t k, int32_t dtype,
    int64_t availableCoreNum, aclrtStream stream,
    bool transposeX1, bool transposeX2)
{
    if (dtype != 2 || !transposeX1 || !transposeX2) return false;
    raw_bf16_tt_fulla_m112n64::Plan plan{};
    if (!GenerateRawBf16TtFullAM112N64Plan(
            platform_ascendc::PlatformAscendCManager::GetInstance(),
            batch, m, n, k, availableCoreNum, plan)) {
        return false;
    }

    uint8_t *scratch = nullptr;
    uint8_t *partial = nullptr;
    if (aclrtMalloc(reinterpret_cast<void **>(&scratch),
            static_cast<size_t>(plan.scratchElements) * sizeof(float),
            ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS ||
        aclrtMalloc(reinterpret_cast<void **>(&partial),
            static_cast<size_t>(plan.partialElements) * sizeof(float),
            ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        if (scratch != nullptr) aclrtFree(scratch);
        if (partial != nullptr) aclrtFree(partial);
        return false;
    }
    batch_matmul_raw_bf16_tt_fulla_m112n64<<<
        plan.blockDim, nullptr, stream>>>(
            x1, x2, y, scratch, partial,
            raw_bf16_tt_fulla_m112n64::LaunchPlan{plan.batch,plan.m,plan.n,plan.k,plan.nParts,plan.blockDim});
    const aclError result = aclrtSynchronizeStream(stream);
    aclrtFree(scratch);
    aclrtFree(partial);
    if (result != ACL_SUCCESS) {
        throw std::runtime_error(
            "BF16 TT full-A M112/N64 Raw device execution failed");
    }
    return true;
}


// Tiny TA/!TB strided-Gather Vector family.
//
// The host builds only byte offsets from runtime metadata.  It never reads or
// computes from input values.  B/M/N/K, all GM addresses, blockDim, the Gather
// plan, and reduction masks are runtime-derived.  One public call launches one
// Vector compute kernel.
#include <vector>
namespace tiny_strided_gather {

constexpr uint32_t MAX_M = 8;
constexpr uint32_t MAX_N = 8;
constexpr uint32_t MIN_K = 32;
constexpr uint32_t MAX_K = 64;
constexpr uint32_t K_GUARD = 8;
constexpr uint32_t MAX_PITCH = MAX_K + K_GUARD;

constexpr uint32_t COMPACT_PHYSICAL = 336;
constexpr uint32_t COMPACT_PACKED = 384;
constexpr uint32_t COMPACT_PRODUCT = 720;
constexpr uint32_t COMPACT_DOTS = 120;

constexpr uint32_t WIDE_PHYSICAL = 1024;
constexpr uint32_t WIDE_PACKED = (MAX_M + MAX_N) * MAX_PITCH;
constexpr uint32_t WIDE_PRODUCT = MAX_M * MAX_N * MAX_PITCH;
constexpr uint32_t WIDE_DOTS = MAX_M * MAX_N * 8;

constexpr uint32_t COMPACT_PHYSICAL_ADDR = 0;
constexpr uint32_t COMPACT_PACKED_ADDR = 672;
constexpr uint32_t COMPACT_INPUT_ADDR = 1440;
constexpr uint32_t COMPACT_INDEX_ADDR = 2976;
constexpr uint32_t COMPACT_PRODUCT_ADDR = 4512;
constexpr uint32_t COMPACT_DOTS_ADDR = 7392;
constexpr uint32_t COMPACT_MAX_ADDR = 7872;
constexpr uint32_t COMPACT_SUM_ADDR = 7904;
constexpr uint32_t COMPACT_HIGH_WATER = 7936;

constexpr uint32_t WIDE_PHYSICAL_ADDR = 8192;
constexpr uint32_t WIDE_PACKED_ADDR = 10240;
constexpr uint32_t WIDE_INPUT_ADDR = 12544;
constexpr uint32_t WIDE_INDEX_ADDR = 17152;
constexpr uint32_t WIDE_PRODUCT_ADDR = 21760;
constexpr uint32_t WIDE_DOTS_ADDR = 40192;
constexpr uint32_t WIDE_MAX_ADDR = 42240;
constexpr uint32_t WIDE_SUM_ADDR = 42272;
constexpr uint32_t WIDE_HIGH_WATER = 42304;

static_assert(WIDE_PACKED == 1152 && WIDE_PRODUCT == 4608 &&
    WIDE_DOTS == 512 && WIDE_HIGH_WATER == 42304,
    "tiny Gather wide layout changed");
static_assert((COMPACT_PHYSICAL_ADDR | COMPACT_PACKED_ADDR |
    COMPACT_INPUT_ADDR | COMPACT_INDEX_ADDR | COMPACT_PRODUCT_ADDR |
    COMPACT_DOTS_ADDR | COMPACT_MAX_ADDR | COMPACT_SUM_ADDR |
    WIDE_PHYSICAL_ADDR | WIDE_PACKED_ADDR | WIDE_INPUT_ADDR |
    WIDE_INDEX_ADDR | WIDE_PRODUCT_ADDR | WIDE_DOTS_ADDR |
    WIDE_MAX_ADDR | WIDE_SUM_ADDR) % 32U == 0U,
    "tiny Gather buffers must be 32-byte aligned");

__aicore__ inline uint32_t Align16(uint32_t value)
{
    return (value + 15U) / 16U * 16U;
}

inline uint32_t Pitch(uint32_t k)
{
    return k + K_GUARD;
}

inline uint32_t PhysicalCount(uint32_t m, uint32_t n, uint32_t k)
{
    return (k * n + 15U) / 16U * 16U +
        (k * m + 15U) / 16U * 16U;
}

inline bool UsesCompactLayout(uint32_t m, uint32_t n, uint32_t k)
{
    const uint32_t pitch = Pitch(k);
    return PhysicalCount(m, n, k) <= COMPACT_PHYSICAL &&
        (m + n) * pitch <= COMPACT_PACKED &&
        m * n * pitch <= COMPACT_PRODUCT &&
        m * n * 8U <= COMPACT_DOTS;
}

template <typename T, bool COMPACT, bool SINGLE_BATCH, bool ONE_CORE, bool BROADCAST>
__aicore__ inline void Run(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    uint64_t nMask, uint32_t batchSize, uint32_t mSize,
    uint32_t nSize, uint32_t kSize, uint32_t blocks, uint64_t kMask)
{
    static_assert(sizeof(T) == 2, "tiny Gather supports 16-bit inputs only");
    constexpr uint32_t physicalAddr = COMPACT ?
        COMPACT_PHYSICAL_ADDR : WIDE_PHYSICAL_ADDR;
    constexpr uint32_t packedAddr = COMPACT ?
        COMPACT_PACKED_ADDR : WIDE_PACKED_ADDR;
    constexpr uint32_t inputAddr = COMPACT ?
        COMPACT_INPUT_ADDR : WIDE_INPUT_ADDR;
    constexpr uint32_t indexAddr = COMPACT ?
        COMPACT_INDEX_ADDR : WIDE_INDEX_ADDR;
    constexpr uint32_t productAddr = COMPACT ?
        COMPACT_PRODUCT_ADDR : WIDE_PRODUCT_ADDR;
    constexpr uint32_t dotsAddr = COMPACT ?
        COMPACT_DOTS_ADDR : WIDE_DOTS_ADDR;
    constexpr uint32_t maxAddr = COMPACT ?
        COMPACT_MAX_ADDR : WIDE_MAX_ADDR;
    constexpr uint32_t sumAddr = COMPACT ?
        COMPACT_SUM_ADDR : WIDE_SUM_ADDR;
    constexpr uint32_t physicalCapacity = COMPACT ?
        COMPACT_PHYSICAL : WIDE_PHYSICAL;
    constexpr uint32_t packedCapacity = COMPACT ?
        COMPACT_PACKED : WIDE_PACKED;
    constexpr uint32_t productCapacity = COMPACT ?
        COMPACT_PRODUCT : WIDE_PRODUCT;
    constexpr uint32_t dotsCapacity = COMPACT ?
        COMPACT_DOTS : WIDE_DOTS;

    LocalTensor<T> physical(TPosition::VECCALC,
        physicalAddr, physicalCapacity);
    LocalTensor<T> packed(TPosition::VECCALC,
        packedAddr, packedCapacity);
    LocalTensor<float> inputs(TPosition::VECCALC,
        inputAddr, packedCapacity);
    LocalTensor<uint32_t> indices(TPosition::VECCALC,
        indexAddr, packedCapacity);
    LocalTensor<float> product(TPosition::VECCALC,
        productAddr, productCapacity);
                                                                            
                                                                         
    static_assert(3U * MAX_PITCH <= productCapacity,
        "Device index axes exceed the existing product region");
    LocalTensor<int32_t> kAxis(TPosition::VECCALC, productAddr, MAX_PITCH);
    LocalTensor<int32_t> bAxis(TPosition::VECCALC,
        productAddr + MAX_PITCH * sizeof(int32_t), MAX_PITCH);
    LocalTensor<int32_t> aAxis(TPosition::VECCALC,
        productAddr + 2U * MAX_PITCH * sizeof(int32_t), MAX_PITCH);
    static_assert(3U * MAX_PITCH + 8U + 2U * 64U <= productCapacity,
        "Broadcast index temporaries exceed the reserved product region");
    LocalTensor<int32_t> rowSeed(TPosition::VECCALC,
        productAddr + 3U * MAX_PITCH * sizeof(int32_t), 8);
    LocalTensor<int32_t> bRowBase(TPosition::VECCALC,
        productAddr + (3U * MAX_PITCH + 8U) * sizeof(int32_t), 64);
    LocalTensor<int32_t> aRowBase(TPosition::VECCALC,
        productAddr + (3U * MAX_PITCH + 8U + 64U) * sizeof(int32_t), 64);
    LocalTensor<float> dots(TPosition::VECCALC,
        dotsAddr, dotsCapacity);
    LocalTensor<float> maxima(TPosition::VECCALC, maxAddr, MAX_M);
    LocalTensor<float> sum(TPosition::VECCALC, sumAddr, 8);

    GlobalTensor<T> aGm;
    GlobalTensor<T> bGm;
    GlobalTensor<float> output;
    aGm.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x1),
        static_cast<uint64_t>(batchSize) * kSize * mSize);
    bGm.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x2),
        static_cast<uint64_t>(batchSize) * kSize * nSize);
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y), batchSize);

    const uint32_t pitch = kSize + K_GUARD;
    const uint32_t bCount = kSize * nSize;
    const uint32_t aPhysicalOffset = Align16(bCount);
    const uint32_t bBytes = bCount * static_cast<uint32_t>(sizeof(T));
    const uint32_t aBytes = kSize * mSize *
        static_cast<uint32_t>(sizeof(T));
    const uint32_t packedCount = (mSize + nSize) * pitch;
    const uint32_t productCount = mSize * nSize * pitch;
    const uint8_t repeatStride = static_cast<uint8_t>(pitch / 8U);
    const BinaryRepeatParams multiply{
        1, 1, 1, repeatStride, 0, repeatStride};
    const uint64_t nMasks[2] = {nMask, UINT64_C(0)};
    constexpr bool broadcastIndices = BROADCAST;
    const UnaryRepeatParams indexUnary{1, 1, 8, 8};
    const BinaryRepeatParams indexAdd{1, 1, 0, repeatStride, 0, 1};

                                                                      
                                                                               
    const uint32_t firstBatch = ONE_CORE ? 0U : GetBlockIdx();
    const uint32_t batchStride = ONE_CORE ? 1U : blocks;
    for (uint32_t batch = firstBatch; SINGLE_BATCH || batch < batchSize; batch += batchStride) {
        const uint64_t aOffset = static_cast<uint64_t>(batch) * kSize * mSize;
        const uint64_t bOffset = static_cast<uint64_t>(batch) * kSize * nSize;
        DataCopyPad(physical, bGm[bOffset],
            DataCopyExtParams{1, bBytes, 0, 0, 0},
            DataCopyPadExtParams<T>{false, 0, 0, static_cast<T>(0.0f)});
        DataCopyPad(physical[aPhysicalOffset], aGm[aOffset],
            DataCopyExtParams{1, aBytes, 0, 0, 0},
            DataCopyPadExtParams<T>{false, 0, 0, static_cast<T>(0.0f)});
        if (SINGLE_BATCH || batch == firstBatch) {
                                                                             
                                                                           
                                                                               
            auto seedPairs = kAxis.template ReinterpretCast<uint64_t>();
#pragma unroll
            for (uint32_t seed = 0; seed < 4U; ++seed) {
                seedPairs.SetValue(seed,
                    (static_cast<uint64_t>(seed * 2U + 1U) << 32U) |
                    static_cast<uint64_t>(seed * 2U));
            }
            constexpr event_t seedReady = static_cast<event_t>(2);
            SetFlag<HardEvent::S_V>(seedReady);
            WaitFlag<HardEvent::S_V>(seedReady);
            Adds<int32_t>(kAxis[8], kAxis, int32_t(8), int32_t(8));
            PipeBarrier<PIPE_V>();
            Adds<int32_t>(kAxis[16], kAxis, int32_t(16), int32_t(16));
            PipeBarrier<PIPE_V>();
            if (kSize > 32U) {
                Adds<int32_t>(kAxis[32], kAxis, int32_t(32),
                    static_cast<int32_t>(kSize - 32U));
            }
                                                                          
            Duplicate<int32_t>(kAxis[kSize], int32_t(0), K_GUARD);
            PipeBarrier<PIPE_V>();
            Muls<int32_t>(bAxis, kAxis,
                static_cast<int32_t>(nSize * sizeof(T)),
                static_cast<int32_t>(pitch));
            Muls<int32_t>(aAxis, kAxis,
                static_cast<int32_t>(mSize * sizeof(T)),
                static_cast<int32_t>(pitch));
            if constexpr (broadcastIndices) {
                Muls<int32_t, true>(rowSeed, kAxis,
                    static_cast<int32_t>(sizeof(T)), uint64_t(8),
                    uint8_t(1), indexUnary);
            }
            PipeBarrier<PIPE_V>();
            auto indexWords = indices.ReinterpretCast<int32_t>();
            if constexpr (broadcastIndices) {
                                                                          
                Brcb<int32_t>(bRowBase, rowSeed, uint8_t(1),
                    BrcbRepeatParams{1, 8});
                PipeBarrier<PIPE_V>();
                Adds<int32_t, true>(aRowBase, bRowBase,
                    static_cast<int32_t>(aPhysicalOffset * sizeof(T)),
                    uint64_t(64), uint8_t(1), indexUnary);
                                                                      
                                                                                
                const uint64_t pitchMask = (kMask << K_GUARD) |
                    ((UINT64_C(1) << K_GUARD) - UINT64_C(1));
                SetVectorMask<int32_t, MaskMode::NORMAL>(uint64_t(0), pitchMask);
                Add<int32_t, false>(indexWords, bAxis, bRowBase,
                    static_cast<uint64_t>(pitch),
                    static_cast<uint8_t>(nSize), indexAdd);
                PipeBarrier<PIPE_V>();
                Add<int32_t, false>(indexWords[nSize * pitch], aAxis, aRowBase,
                    static_cast<uint64_t>(pitch),
                    static_cast<uint8_t>(mSize), indexAdd);
            } else {
                for (uint32_t col = 0; col < nSize; ++col) {
                    Adds<int32_t>(indexWords[col * pitch], bAxis,
                        static_cast<int32_t>(col * sizeof(T)),
                        static_cast<int32_t>(pitch));
                }
                for (uint32_t row = 0; row < mSize; ++row) {
                    Adds<int32_t>(indexWords[(nSize + row) * pitch], aAxis,
                        static_cast<int32_t>((aPhysicalOffset + row) * sizeof(T)),
                        static_cast<int32_t>(pitch));
                }
            }
            PipeBarrier<PIPE_V>();
        }
        constexpr event_t copyReady = static_cast<event_t>(0);
        SetFlag<HardEvent::MTE2_V>(copyReady);
        WaitFlag<HardEvent::MTE2_V>(copyReady);

        Gather(packed, physical, indices, uint32_t(0), packedCount);
        PipeBarrier<PIPE_V>();
        Cast(inputs, packed, RoundMode::CAST_NONE, packedCount);
        PipeBarrier<PIPE_V>();

        SetVectorMask<float, MaskMode::NORMAL>(uint64_t(0), kMask);
        uint32_t row = 0;
        const uint32_t rowProductStride = nSize * pitch;
#pragma unroll
        for (; row + 1U < mSize; row += 2U) {
            Mul<float, false>(product[row * rowProductStride],
                inputs[nSize * pitch + row * pitch], inputs,
                kSize, nSize, multiply);
            Mul<float, false>(product[(row + 1U) * rowProductStride],
                inputs[nSize * pitch + (row + 1U) * pitch], inputs,
                kSize, nSize, multiply);
        }
        if (row < mSize) {
            Mul<float, false>(product[row * rowProductStride],
                inputs[nSize * pitch + row * pitch], inputs,
                kSize, nSize, multiply);
        }
        PipeBarrier<PIPE_V>();
        WholeReduceSum<float, false>(dots, product, kSize,
            mSize * nSize, 8, 1, repeatStride);
        PipeBarrier<PIPE_V>();
        WholeReduceMax<float, true>(maxima, dots, nMasks, mSize,
            1, 1, nSize, ReduceOrder::ORDER_ONLY_VALUE);
        PipeBarrier<PIPE_V>();
        WholeReduceSum<float, true>(sum, maxima, mSize, 1, 1, 1, 8);
        constexpr event_t outputReady = static_cast<event_t>(0);
        SetFlag<HardEvent::V_MTE3>(outputReady);
        WaitFlag<HardEvent::V_MTE3>(outputReady);
        DataCopyPad(output[batch], sum, DataCopyExtParams{1, 4, 0, 0, 0});
        PipeBarrier<PIPE_ALL>();
        (void)productCount;
        if constexpr (SINGLE_BATCH) break;
    }
}

template <typename T, bool COMPACT, bool SINGLE_BATCH, bool ONE_CORE, bool BROADCAST>
__global__ __vector__ void Kernel(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    uint64_t nMask, uint32_t batch, uint32_t m,
    uint32_t n, uint32_t k, uint32_t blocks, uint64_t kMask)
{
    InitSocState();
    ICachePreLoad(2);
    Run<T, COMPACT, SINGLE_BATCH, ONE_CORE, BROADCAST>(x1, x2, y, nMask, batch, m, n, k, blocks, kMask);
}

template <typename T, bool COMPACT, bool BROADCAST>
__global__ __vector__ void SingleKernel(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    uint32_t shape)
{
    InitSocState();
    ICachePreLoad(2);
    const uint32_t m=shape&15U;
    const uint32_t n=(shape>>4U)&15U;
    const uint32_t k=shape>>8U;
    const uint64_t nMask=UINT64_C(0x0101010101010101) >> ((8U-n)*8U);
    const uint64_t kMask=k==64U ? UINT64_MAX : (UINT64_C(1)<<k)-UINT64_C(1);
    Run<T, COMPACT, true, true, BROADCAST>(x1,x2,y,nMask,1U,m,n,k,1U,kMask);
}

inline bool Supports(uint32_t batch, uint32_t m, uint32_t n, uint32_t k,
    int32_t dtype, bool ta, bool tb)
{
    return (dtype == 1 || dtype == 2) && ta && !tb && batch > 0U &&
        m > 0U && m <= MAX_M && n > 0U && n <= MAX_N &&
        k >= MIN_K && k <= MAX_K && k % 8U == 0U;
}

                                                                  
template <typename T, bool COMPACT, bool SINGLE_BATCH, bool BROADCAST>
inline void LaunchByCoreCount(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    uint64_t nMask, uint32_t batch, uint32_t m, uint32_t n, uint32_t k,
    uint32_t blocks, aclrtStream stream, uint64_t kMask)
{
    if (blocks == 1U) {
        if constexpr (SINGLE_BATCH) {
            const uint32_t shape=m|(n<<4U)|(k<<8U);
            SingleKernel<T,COMPACT,BROADCAST><<<blocks,nullptr,stream>>>(x1,x2,y,shape);
        } else {
            Kernel<T, COMPACT, SINGLE_BATCH, true, BROADCAST><<<blocks, nullptr, stream>>>(
                x1, x2, y, nMask, batch, m, n, k, blocks, kMask);
        }
    } else {
        Kernel<T, COMPACT, SINGLE_BATCH, false, BROADCAST><<<blocks, nullptr, stream>>>(
            x1, x2, y, nMask, batch, m, n, k, blocks, kMask);
    }
}

                                                                        
                                                                                 
template <typename T, bool COMPACT, bool BROADCAST>
inline void LaunchByLifetime(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, uint64_t nMask,
    uint32_t batch, uint32_t m, uint32_t n, uint32_t k, uint32_t blocks,
    aclrtStream stream, uint64_t kMask)
{
    if (batch == blocks) {
        LaunchByCoreCount<T, COMPACT, true, BROADCAST>(
            x1, x2, y, nMask, batch, m, n, k, blocks, stream, kMask);
    } else {
        LaunchByCoreCount<T, COMPACT, false, BROADCAST>(
            x1, x2, y, nMask, batch, m, n, k, blocks, stream, kMask);
    }
}

template <typename T, bool COMPACT>
inline void Launch(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, uint64_t nMask,
    uint32_t batch, uint32_t m, uint32_t n, uint32_t k, uint32_t blocks,
    aclrtStream stream)
{
    const uint64_t kMask = k == 64U ? UINT64_MAX :
        (UINT64_C(1) << k) - UINT64_C(1);
    const bool broadcast = k + K_GUARD <= 64U && m + n > 5U;
    if (broadcast) {
        LaunchByLifetime<T, COMPACT, true>(
            x1, x2, y, nMask, batch, m, n, k, blocks, stream, kMask);
    } else {
        LaunchByLifetime<T, COMPACT, false>(
            x1, x2, y, nMask, batch, m, n, k, blocks, stream, kMask);
    }
}

}                                 

inline bool TryRunTinyStridedGather(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    uint32_t batch, uint32_t m, uint32_t n, uint32_t k, int32_t dtype,
    int64_t availableCoreNum, aclrtStream stream, bool ta, bool tb)
{
    using namespace tiny_strided_gather;
    if (!Supports(batch, m, n, k, dtype, ta, tb) || availableCoreNum <= 0)
        return false;
    auto *platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (platform == nullptr) return false;
    const int64_t aivCores = static_cast<int64_t>(platform->GetCoreNumAiv());
    const int64_t launchLimit = std::min<int64_t>(availableCoreNum, aivCores);
    if (launchLimit <= 0) return false;
    const bool compact = UsesCompactLayout(m, n, k);
    uint64_t ubBytes = 0;
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubBytes);
    const uint32_t requiredUb = compact ? COMPACT_HIGH_WATER : WIDE_HIGH_WATER;
    if (ubBytes < requiredUb) return false;
    const uint32_t blocks = static_cast<uint32_t>(
        std::min<int64_t>(launchLimit, static_cast<int64_t>(batch)));
    if (blocks == 0U) return false;

    uint64_t nMask = 0;
    for (uint32_t col = 0; col < n; ++col)
        nMask |= UINT64_C(1) << (col * 8U);

if (dtype == 1) {
        if (compact) {
            tiny_strided_gather::Launch<half, true>(
                x1, x2, y, nMask, batch, m, n, k, blocks, stream);
        } else {
            tiny_strided_gather::Launch<half, false>(
                x1, x2, y, nMask, batch, m, n, k, blocks, stream);
        }
    } else {
        if (compact) {
            tiny_strided_gather::Launch<bfloat16_t, true>(
                x1, x2, y, nMask, batch, m, n, k, blocks, stream);
        } else {
            tiny_strided_gather::Launch<bfloat16_t, false>(
                x1, x2, y, nMask, batch, m, n, k, blocks, stream);
        }
    }
    const aclError result = aclrtSynchronizeStream(stream);
    if (result != ACL_SUCCESS)
        throw std::runtime_error("tiny strided-Gather device execution failed");
    return true;
}


// Small contiguous-row Vector family. Logical A rows and logical B columns are
// contiguous for the supported storage orientation. Runtime geometry
// selects compact UB slices; shapes outside the capacity domain fall back.
namespace tiny_contiguous_vector {

constexpr uint32_t MAX_M = 8;
constexpr uint32_t MAX_N = 16;
constexpr uint32_t MAX_K = 64;
constexpr uint32_t DOT_STRIDE = 4;
static_assert(MAX_N * DOT_STRIDE <= 64U, "FP32 sparse N mask must fit one repeat");

struct Plan {
    uint32_t batch;
    uint32_t m;
    uint32_t n;
    uint32_t k;
    uint32_t nPad;
    uint32_t blocks;
    uint32_t inputs;
    uint32_t floatOffset;
    uint32_t productOffset;
    uint32_t dotsOffset;
    uint32_t maxOffset;
    uint32_t sumOffset;
    uint32_t ubBytes;
    uint64_t nMask;
};

static_assert(sizeof(Plan) <= 128, "tiny contiguous launch metadata is too large");

template <typename T, bool REUSE_BATCH>
__aicore__ inline void Run(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, const Plan &d)
{
    InitSocState();
    LocalTensor<T> input(TPosition::VECCALC, 0, d.inputs);
    LocalTensor<float> values(TPosition::VECCALC, d.floatOffset, d.inputs);
    LocalTensor<float> product(TPosition::VECCALC, d.productOffset,
        d.m * d.nPad * d.k);
    LocalTensor<float> dots(TPosition::VECCALC, d.dotsOffset,
        d.m * d.nPad * DOT_STRIDE);
    LocalTensor<float> maxima(TPosition::VECCALC, d.maxOffset, 8);
    LocalTensor<float> sum(TPosition::VECCALC, d.sumOffset, 8);

    GlobalTensor<T> lhs;
    GlobalTensor<T> rhs;
    GlobalTensor<float> output;
    lhs.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x1),
        static_cast<uint64_t>(d.batch) * d.m * d.k);
    rhs.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x2),
        static_cast<uint64_t>(d.batch) * d.n * d.k);
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y), d.batch);

    const BinaryRepeatParams multiply{1, 1, 1,
        static_cast<uint8_t>(d.k / 8), 0, static_cast<uint8_t>(d.k / 8)};
    const uint64_t nMasks[2] = {d.nMask, UINT64_C(0)};
    constexpr event_t event = static_cast<event_t>(0);
    uint32_t batch = GetBlockIdx();
    do {
        const uint64_t aOffset = static_cast<uint64_t>(batch) * d.m * d.k;
        const uint64_t bOffset = static_cast<uint64_t>(batch) * d.n * d.k;
        DataCopy(input, rhs[bOffset], d.n * d.k);
        DataCopy(input[d.n * d.k], lhs[aOffset], d.m * d.k);
        SetFlag<HardEvent::MTE2_V>(event);
        WaitFlag<HardEvent::MTE2_V>(event);
        Cast(values, input, RoundMode::CAST_NONE, d.inputs);
        PipeBarrier<PIPE_V>();
        SetVectorMask<float, MaskMode::NORMAL>(d.k);
#pragma unroll
        for (uint32_t row = 0; row < MAX_M; ++row) {
            if (row < d.m) {
                Mul<float, false>(product[row * d.nPad * d.k],
                    values[(d.n + row) * d.k], values, d.k, d.nPad, multiply);
            }
        }
        PipeBarrier<PIPE_V>();
        WholeReduceSum<float, false>(dots, product, d.k, d.m * d.nPad,
            DOT_STRIDE, 1, static_cast<uint8_t>(d.k / 8));
        PipeBarrier<PIPE_V>();
        WholeReduceMax<float, true>(maxima, dots, nMasks, d.m, 1, 1,
            static_cast<uint8_t>(d.nPad * DOT_STRIDE / 8U), ReduceOrder::ORDER_ONLY_VALUE);
        PipeBarrier<PIPE_V>();
        WholeReduceSum<float, true>(sum, maxima, d.m, 1, 1, 1, 8);
        SetFlag<HardEvent::V_MTE3>(event);
        WaitFlag<HardEvent::V_MTE3>(event);
        DataCopyPad(output[batch], sum,
            DataCopyExtParams{1, sizeof(float), 0, 0, 0});
        if constexpr (REUSE_BATCH) {
            if (batch + d.blocks < d.batch) {
                // The next batch overwrites input from MTE2 while the current
                // batch still consumes input/values on Vector.  MTE3_V only
                // protects sum from the outstanding output DMA, so keep a
                // separate Vector-to-MTE2 dependency for the input lifetime.
                SetFlag<HardEvent::V_MTE2>(event);
                WaitFlag<HardEvent::V_MTE2>(event);
                SetFlag<HardEvent::MTE3_V>(event);
                WaitFlag<HardEvent::MTE3_V>(event);
            } else {
                PipeBarrier<PIPE_ALL>();
            }
        } else {
            PipeBarrier<PIPE_ALL>();
            break;
        }
        batch += d.blocks;
    } while (batch < d.batch);
}

} // namespace tiny_contiguous_vector

#define DEFINE_TINY_CONTIGUOUS_KERNEL(NAME, TYPE, REUSE)                       \
extern "C" __global__ __vector__ void NAME(                                  \
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y, tiny_contiguous_vector::Plan plan)      \
{                                                                               \
    tiny_contiguous_vector::Run<TYPE, REUSE>(x1, x2, y, plan);                 \
}

DEFINE_TINY_CONTIGUOUS_KERNEL(batch_matmul_tiny_contiguous_fp16, half, false)
DEFINE_TINY_CONTIGUOUS_KERNEL(batch_matmul_tiny_contiguous_bf16, bfloat16_t, false)
DEFINE_TINY_CONTIGUOUS_KERNEL(batch_matmul_tiny_contiguous_fp16_reuse, half, true)
DEFINE_TINY_CONTIGUOUS_KERNEL(batch_matmul_tiny_contiguous_bf16_reuse, bfloat16_t, true)
#undef DEFINE_TINY_CONTIGUOUS_KERNEL

inline bool GenerateTinyContiguousVectorPlan(
    platform_ascendc::PlatformAscendC *platform, uint32_t batch, uint32_t m,
    uint32_t n, uint32_t k, int64_t availableCoreNum,
    tiny_contiguous_vector::Plan &plan)
{
    using namespace tiny_contiguous_vector;
    if (platform == nullptr || batch == 0 || availableCoreNum <= 0 ||
        m == 0 || m > MAX_M || n == 0 || n > MAX_N ||
        k < 32 || k > MAX_K || k % 16 != 0) {
        return false;
    }
    const uint32_t originalNPad = (n + 7U) / 8U * 8U;
    // Retain the original alias gate and family routing before tighter packing.
    if (originalNPad - n > m) return false;
    const uint32_t nPad = (n + 1U) / 2U * 2U;

    const uint64_t inputs = static_cast<uint64_t>(m + n) * k;
    const uint64_t floatOffset = inputs * sizeof(half);
    const uint64_t productOffset = floatOffset + inputs * sizeof(float);
    const uint64_t dotsOffset = productOffset +
        static_cast<uint64_t>(m) * nPad * k * sizeof(float);
    const uint64_t maxOffset = dotsOffset +
        static_cast<uint64_t>(m) * nPad * DOT_STRIDE * sizeof(float);
    const uint64_t sumOffset = maxOffset + 32U;
    const uint64_t ubBytes = sumOffset + 32U;
    if (inputs > UINT32_MAX || ubBytes > UINT32_MAX ||
        floatOffset % 32 != 0 || productOffset % 32 != 0 ||
        dotsOffset % 32 != 0 || maxOffset % 32 != 0 || sumOffset % 32 != 0) {
        return false;
    }
    uint64_t availableUb = 0;
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, availableUb);
    const uint64_t hardware = platform->GetCoreNumAiv();
    const uint64_t blocks = std::min<uint64_t>(batch,
        std::min<uint64_t>(static_cast<uint64_t>(availableCoreNum), hardware));
    const uint64_t originalUbBytes = productOffset +
        static_cast<uint64_t>(m) * originalNPad * (k + 1U) * sizeof(float) + 64U;
    if (ubBytes > availableUb || originalUbBytes > availableUb ||
        blocks == 0 || blocks > UINT32_MAX) return false;

    plan.batch = batch;
    plan.m = m;
    plan.n = n;
    plan.k = k;
    plan.nPad = nPad;
    plan.blocks = static_cast<uint32_t>(blocks);
    plan.inputs = static_cast<uint32_t>(inputs);
    plan.floatOffset = static_cast<uint32_t>(floatOffset);
    plan.productOffset = static_cast<uint32_t>(productOffset);
    plan.dotsOffset = static_cast<uint32_t>(dotsOffset);
    plan.maxOffset = static_cast<uint32_t>(maxOffset);
    plan.sumOffset = static_cast<uint32_t>(sumOffset);
    plan.ubBytes = static_cast<uint32_t>(ubBytes);
    uint64_t nMask = 0;
    for (uint32_t col = 0; col < n; ++col)
        nMask |= UINT64_C(1) << (col * DOT_STRIDE);
    plan.nMask = nMask;
    return true;
}

inline bool TryRunTinyContiguousVector(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    uint32_t batch, uint32_t m, uint32_t n, uint32_t k, int32_t dtype,
    int64_t availableCoreNum, aclrtStream stream, bool transposeX1,
    bool transposeX2)
{
    if ((dtype != 1 && dtype != 2) || transposeX1 || !transposeX2) return false;
    tiny_contiguous_vector::Plan plan{};
    if (!GenerateTinyContiguousVectorPlan(
            platform_ascendc::PlatformAscendCManager::GetInstance(), batch,
            m, n, k, availableCoreNum, plan)) {
        return false;
    }
const bool reuse = batch > plan.blocks;
    if (dtype == 1) {
        if (reuse) {
            batch_matmul_tiny_contiguous_fp16_reuse<<<plan.blocks, nullptr, stream>>>(
                x1, x2, y, plan);
        } else {
            batch_matmul_tiny_contiguous_fp16<<<plan.blocks, nullptr, stream>>>(
                x1, x2, y, plan);
        }
    } else if (reuse) {
        batch_matmul_tiny_contiguous_bf16_reuse<<<plan.blocks, nullptr, stream>>>(
            x1, x2, y, plan);
    } else {
        batch_matmul_tiny_contiguous_bf16<<<plan.blocks, nullptr, stream>>>(
            x1, x2, y, plan);
    }
    return true;
}


// FP16 NN whole-matrix resident Cube family for aligned small tiles.
// The tile geometry, batch count, core count and scratch layout are runtime
// metadata. Unsupported shapes fall back before launch.
namespace raw_nn_fulltile_fp16 {

constexpr uint32_t MAX_M = 16;
constexpr uint32_t MAX_N = 32;
constexpr uint32_t MAX_K = 128;
constexpr uint16_t READY = 8;
constexpr uint16_t CONSUMED = 9;

struct Plan {
    uint32_t batch;
    uint32_t m;
    uint32_t n;
    uint32_t k;
    uint32_t blocks;
    uint32_t cCount;
    uint32_t ubBytes;
    uint64_t scratchElements;
};

static_assert(sizeof(Plan) <= 128, "full-tile launch metadata is too large");
static_assert(MAX_M * MAX_K * sizeof(half) <= 65536 &&
    MAX_N * MAX_K * sizeof(half) <= 65536 &&
    MAX_M * MAX_N * sizeof(float) <= 131072,
    "full-tile compile-time caps exceed local-memory classes");

// This experiment removes software-only TPipe ownership for this raw family.
// Keep exactly the same installed-SDK SoC state and hardware entry/exit events.
#if defined(__NPU_ARCH__) && (__NPU_ARCH__ == 2201) && \
    (!defined(ASCENDC_CPU_DEBUG) || (ASCENDC_CPU_DEBUG == 0)) && \
    !defined(ASCENDC_TIME_STAMP_ON) && \
    !defined(__ASCENDC_ENABLE_SUPER_KERNEL__)
class FullTileHardwareGuard {
public:
    __aicore__ inline FullTileHardwareGuard()
    {
        // Same effective function called by TPipe::InitSocState(), with no
        // free InitSocState wrapper or changed initialization responsibilities.
        AscendCUtils::InitSocStateImpl();
        if ASCEND_IS_AIC {
            SetFlag<HardEvent::M_MTE1>(0);
            SetFlag<HardEvent::M_MTE1>(1);
            SetFlag<HardEvent::M_MTE1>(2);
        }
    }

    __aicore__ inline ~FullTileHardwareGuard()
    {
        if ASCEND_IS_AIC {
            WaitFlag<HardEvent::M_MTE1>(0);
            WaitFlag<HardEvent::M_MTE1>(1);
            WaitFlag<HardEvent::M_MTE1>(2);
        }
        // Exact intrinsic used by the installed TPipe::Destroy() on this build.
        pipe_barrier(PIPE_ALL);
    }
};
// Overflow/debug instrumentation can add hidden SDK state dependencies.
// Keep the original TPipe if overflow checking is enabled at compile time.
using FullTileScopedPipe = typename std::conditional<g_gm_overflow_check,
    TPipe, FullTileHardwareGuard>::type;
#else
using FullTileScopedPipe = TPipe;
#endif

template <bool REUSE_SCRATCH>
__aicore__ inline void Run(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    GM_ADDR scratchGm, const Plan &d)
{
    const uint32_t group = GetBlockIdx();
    const uint64_t scratchOffset = static_cast<uint64_t>(group) * d.cCount;
    FullTileScopedPipe pipe;
    GlobalTensor<float> scratch;
    scratch.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(scratchGm),
        d.scratchElements);

    if ASCEND_IS_AIC {
        GlobalTensor<half> lhs;
        GlobalTensor<half> rhs;
        lhs.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(x1),
            static_cast<uint64_t>(d.batch) * d.m * d.k);
        rhs.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(x2),
            static_cast<uint64_t>(d.batch) * d.k * d.n);

        const uint32_t aElements = d.m * d.k;
        const uint32_t bElements = d.k * d.n;
        // A1 and B1 share L1; the B view follows the runtime-sized A view.
        LocalTensor<half> a1(TPosition::A1, 0, aElements);
        LocalTensor<half> b1(TPosition::B1,
            aElements * sizeof(half), bElements);
        LocalTensor<half> a2(TPosition::A2, 0, aElements);
        LocalTensor<half> b2(TPosition::B2, 0, bElements);
        LocalTensor<float> c(TPosition::CO1, 0, d.cCount);

        const Nd2NzParams copyA{1, static_cast<uint16_t>(d.m),
            static_cast<uint16_t>(d.k), 0,
            static_cast<uint16_t>(d.k), static_cast<uint16_t>(d.m), 1, 0};
        const Nd2NzParams copyB{1, static_cast<uint16_t>(d.k),
            static_cast<uint16_t>(d.n), 0,
            static_cast<uint16_t>(d.n), static_cast<uint16_t>(d.k), 1, 0};
        const uint32_t kBlocks = d.k / 16;
        const uint32_t nBlocks = d.n / 16;
        const LoadData2DParams loadA{0, static_cast<uint8_t>(kBlocks), 1,
            0, 0, false, 0};
        const LoadData2DParams loadB{0, static_cast<uint8_t>(kBlocks), 1,
            0, static_cast<uint16_t>(nBlocks - 1), true, 0};
        const MmadParams multiply{static_cast<uint16_t>(d.m),
            static_cast<uint16_t>(d.n), static_cast<uint16_t>(d.k),
            uint8_t(0), false, true};
        FixpipeParamsV220 fix{};
        fix.nSize = d.n;
        fix.mSize = d.m;
        fix.srcStride = d.m;
        fix.dstStride = d.n;
        fix.ndNum = 1;

        uint32_t batch = group;
        do {
            const uint64_t aOffset = static_cast<uint64_t>(batch) * d.m * d.k;
            const uint64_t bOffset = static_cast<uint64_t>(batch) * d.k * d.n;
            DataCopy(a1, lhs[aOffset], copyA);
            DataCopy(b1, rhs[bOffset], copyB);
            SetFlag<HardEvent::MTE2_MTE1>(0);
            WaitFlag<HardEvent::MTE2_MTE1>(0);
            LoadData(a2, a1, loadA);
#pragma unroll
            for (uint32_t nBlock = 0; nBlock < MAX_N / 16; ++nBlock) {
                if (nBlock < nBlocks) {
                    LoadData(b2[nBlock * 256],
                        b1[nBlock * 16 * d.k], loadB);
                }
            }
            SetFlag<HardEvent::MTE1_M>(0);
            WaitFlag<HardEvent::MTE1_M>(0);
            Mmad(c, a2, b2, multiply);
            SetFlag<HardEvent::M_FIX>(0);
            WaitFlag<HardEvent::M_FIX>(0);
            Fixpipe<float, float, CFG_ROW_MAJOR>(scratch[scratchOffset], c, fix);
            CrossCoreSetFlag<2, PIPE_FIX>(READY);
            if constexpr (REUSE_SCRATCH) {
                if (batch + d.blocks < d.batch) {
                    CrossCoreWaitFlag(CONSUMED);
                }
            }
            if constexpr (!REUSE_SCRATCH) break;
            batch += d.blocks;
        } while (batch < d.batch);
    }

    if ASCEND_IS_AIV {
        GlobalTensor<float> output;
        output.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y), d.batch);
        const uint32_t cBytes = d.cCount * sizeof(float);
        const uint32_t maximaBytes = (d.m * sizeof(float) + 31U) / 32U * 32U;
        LocalTensor<float> input(TPosition::VECCALC, 0, d.cCount);
        LocalTensor<float> maxima(TPosition::VECCALC, cBytes, d.m);
        LocalTensor<float> sum(TPosition::VECCALC,
            cBytes + maximaBytes, 8);

        uint32_t batch = group;
        do {
            const bool hasNext = batch + d.blocks < d.batch;
            CrossCoreWaitFlag(READY);
            DataCopy(input, scratch[scratchOffset], d.cCount);
            SetFlag<HardEvent::MTE2_V>(0);
            WaitFlag<HardEvent::MTE2_V>(0);
            if constexpr (REUSE_SCRATCH) {
                if (hasNext) {
                    CrossCoreSetFlag<2, PIPE_MTE2>(CONSUMED);
                }
            }
            WholeReduceMax<float, true>(maxima, input, d.n, d.m, 1, 1,
                static_cast<uint8_t>(d.n / 8), ReduceOrder::ORDER_ONLY_VALUE);
            PipeBarrier<PIPE_V>();
            WholeReduceSum<float, true>(sum, maxima, d.m, 1, 1, 1, 8);
            SetFlag<HardEvent::V_MTE3>(0);
            WaitFlag<HardEvent::V_MTE3>(0);
            DataCopyPad(output[batch], sum,
                DataCopyExtParams{1, sizeof(float), 0, 0, 0});
            if constexpr (REUSE_SCRATCH) {
                if (hasNext) {
                    SetFlag<HardEvent::MTE3_V>(0);
                    WaitFlag<HardEvent::MTE3_V>(0);
                    SetFlag<HardEvent::V_MTE2>(0);
                    WaitFlag<HardEvent::V_MTE2>(0);
                }
            }
            if constexpr (!REUSE_SCRATCH) break;
            batch += d.blocks;
        } while (batch < d.batch);
    }
}

} // namespace raw_nn_fulltile_fp16

extern "C" __global__ __aicore__ void batch_matmul_raw_nn_fulltile_fp16(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR scratch,
    raw_nn_fulltile_fp16::Plan plan)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
    raw_nn_fulltile_fp16::Run<false>(x1, x2, y, scratch, plan);
}

extern "C" __global__ __aicore__ void batch_matmul_raw_nn_fulltile_fp16_reuse(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR scratch,
    raw_nn_fulltile_fp16::Plan plan)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
    raw_nn_fulltile_fp16::Run<true>(x1, x2, y, scratch, plan);
}

inline bool GenerateRawNnFullTileFp16Plan(
    platform_ascendc::PlatformAscendC *platform, uint32_t batch, uint32_t m,
    uint32_t n, uint32_t k, int64_t availableCoreNum,
    raw_nn_fulltile_fp16::Plan &plan)
{
    using namespace raw_nn_fulltile_fp16;
    if (platform == nullptr || batch == 0 || availableCoreNum <= 0 ||
        m == 0 || m > MAX_M || m % 16 != 0 ||
        n == 0 || n > MAX_N || n % 16 != 0 ||
        k < 32 || k > MAX_K || k % 16 != 0) {
        return false;
    }

    uint64_t l1 = 0;
    uint64_t l0a = 0;
    uint64_t l0b = 0;
    uint64_t l0c = 0;
    uint64_t ub = 0;
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1, l1);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A, l0a);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B, l0b);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C, l0c);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ub);
    const uint64_t aBytes = static_cast<uint64_t>(m) * k * sizeof(half);
    const uint64_t bBytes = static_cast<uint64_t>(k) * n * sizeof(half);
    const uint64_t cBytes = static_cast<uint64_t>(m) * n * sizeof(float);
    const uint64_t maximaBytes = (static_cast<uint64_t>(m) * sizeof(float) + 31U) /
        32U * 32U;
    const uint64_t ubBytes = cBytes + maximaBytes + 32U;
    if (aBytes + bBytes > l1 || aBytes > l0a || bBytes > l0b ||
        cBytes > l0c || ubBytes > ub || ubBytes > UINT32_MAX) {
        return false;
    }

    const uint64_t hardware = std::min<uint64_t>(platform->GetCoreNumAic(),
        platform->GetCoreNumAiv());
    const uint64_t blocks = std::min<uint64_t>(batch,
        std::min<uint64_t>(static_cast<uint64_t>(availableCoreNum), hardware));
    if (blocks == 0 || blocks > UINT32_MAX) return false;
    plan.batch = batch;
    plan.m = m;
    plan.n = n;
    plan.k = k;
    plan.blocks = static_cast<uint32_t>(blocks);
    plan.cCount = m * n;
    plan.ubBytes = static_cast<uint32_t>(ubBytes);
    plan.scratchElements = blocks * plan.cCount;
    return true;
}

inline bool TryRunRawNnFullTileFp16(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    uint32_t batch, uint32_t m, uint32_t n, uint32_t k, int32_t dtype,
    int64_t availableCoreNum, aclrtStream stream, bool transposeX1,
    bool transposeX2)
{
    if (dtype != 1 || transposeX1 || transposeX2) return false;
    raw_nn_fulltile_fp16::Plan plan{};
    if (!GenerateRawNnFullTileFp16Plan(
            platform_ascendc::PlatformAscendCManager::GetInstance(),
            batch, m, n, k, availableCoreNum, plan)) {
        return false;
    }
    uint8_t *scratch = nullptr;
    const size_t scratchBytes =
        static_cast<size_t>(plan.scratchElements) * sizeof(float);
    if (aclrtMalloc(reinterpret_cast<void **>(&scratch), scratchBytes,
            ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        return false;
    }
if (batch > plan.blocks) {
        batch_matmul_raw_nn_fulltile_fp16_reuse<<<plan.blocks, nullptr, stream>>>(
            x1, x2, y, scratch, plan);
    } else {
        batch_matmul_raw_nn_fulltile_fp16<<<plan.blocks, nullptr, stream>>>(
            x1, x2, y, scratch, plan);
    }
    const aclError result = aclrtSynchronizeStream(stream);
    aclrtFree(scratch);
    if (result != ACL_SUCCESS) {
        throw std::runtime_error("NN full-tile Raw device execution failed");
    }
    return true;
}


// General small-matrix Vector family recovered from the runtime-shaped 47f9 path.
// Logical geometry and all addresses come from runtime metadata.  The constants
// below are capacity limits and vector grouping choices, not benchmark shapes.
namespace small_vector_family_detail {

__aicore__ inline uint32_t Align16(uint32_t value)
{
    return (value + 15U) / 16U * 16U;
}

__aicore__ inline void StridedIndices(LocalTensor<int32_t> indices,
    uint32_t count, int32_t byteStride, TPipe &pipe)
{
    for (uint32_t i = 0; i < 8U; ++i) {
        indices.SetValue(i, static_cast<int32_t>(i) * byteStride);
    }
    const auto event = pipe.FetchEventID(HardEvent::S_V);
    SetFlag<HardEvent::S_V>(event);
    WaitFlag<HardEvent::S_V>(event);
    for (uint32_t filled = 8U; filled < count; filled *= 2U) {
        Adds(indices[filled], indices,
            static_cast<int32_t>(filled) * byteStride, filled);
        PipeBarrier<PIPE_V>();
    }
}

template <typename T>
__aicore__ inline void CopyPaddedRows(LocalTensor<T> dst,
    GlobalTensor<T> src, uint32_t rows, uint32_t columns,
    uint32_t dstColumns)
{
    const uint32_t alignedColumns = Align16(columns);
    DataCopyExtParams copy{
        static_cast<uint16_t>(rows), static_cast<uint32_t>(columns * sizeof(T)), 0,
        (dstColumns - alignedColumns) / 16U, 0};
    DataCopyPadExtParams<T> padding{
        true, 0, static_cast<uint8_t>(alignedColumns - columns),
        static_cast<T>(0.0f)};
    DataCopyPad(dst, src, copy, padding);
}

} // namespace small_vector_family_detail

namespace small_vector_family {

constexpr uint32_t kRows = 4;

inline bool Supports(int32_t dtype, int32_t m, int32_t n, int32_t k)
{
    return (dtype == 1 || dtype == 2) && m > 0 && m <= 16 &&
        n > 0 && n <= 32 && k > 0 && k <= 128;
}

template <typename T, bool TRANS_A, bool TRANS_B>
__global__ __vector__ void GroupedBatchKernel(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    uint32_t batch, uint32_t m, uint32_t n, uint32_t k, uint32_t blocks)
{
    const uint32_t kPad = k <= 64U ? 64U : 128U;
    const uint32_t mPad = small_vector_family_detail::Align16(m);
    const uint32_t nPad = small_vector_family_detail::Align16(n);
    const uint32_t rows = m < kRows ? m : kRows;
    const uint32_t aCount = TRANS_A ? kPad * mPad : m * kPad;
    const uint32_t bCount = TRANS_B ? n * kPad : kPad * nPad;
    const uint32_t dotCount = n * kPad;
    const uint32_t aIndexCount = TRANS_A ? m * kPad : 0U;
    const uint32_t bIndexCount = TRANS_B ? 0U : dotCount;

    const uint32_t productCount = rows * dotCount > m * kPad ?
        rows * dotCount : m * kPad;

    TPipe pipe;
    TBuf<TPosition::VECCALC> aBuffer, bBuffer, lhsBuffer, rhsBuffer;
    TBuf<TPosition::VECCALC> productBuffer, indexBuffer;
    TBuf<TPosition::VECCALC> dotBuffer, maximaBuffer, sumBuffer;
    pipe.InitBuffer(aBuffer, aCount * sizeof(T));
    pipe.InitBuffer(bBuffer, bCount * sizeof(T));
    pipe.InitBuffer(lhsBuffer, m * kPad * sizeof(float));
    pipe.InitBuffer(rhsBuffer, dotCount * sizeof(float));
    pipe.InitBuffer(productBuffer, productCount * sizeof(float));
    pipe.InitBuffer(indexBuffer, (aIndexCount + bIndexCount + 8U) * sizeof(uint32_t));
    pipe.InitBuffer(dotBuffer, rows * nPad * sizeof(float));
    pipe.InitBuffer(maximaBuffer, mPad * sizeof(float));
    pipe.InitBuffer(sumBuffer, 32);
    auto a = aBuffer.Get<T>();
    auto b = bBuffer.Get<T>();
    auto lhs = lhsBuffer.Get<float>();
    auto rhs = rhsBuffer.Get<float>();
    auto product = productBuffer.Get<float>();
    auto packed = productBuffer.Get<T>();
    auto indices = indexBuffer.Get<int32_t>();
    auto dots = dotBuffer.Get<float>();
    auto maxima = maximaBuffer.Get<float>();
    auto sum = sumBuffer.Get<float>();

    if constexpr (!TRANS_B) {
        small_vector_family_detail::StridedIndices(indices, kPad,
            static_cast<int32_t>(nPad * sizeof(T)), pipe);
        for (uint32_t filled = 1U; filled < n; filled *= 2U) {
            const uint32_t count = n - filled < filled ? n - filled : filled;
            Adds(indices[filled * kPad], indices,
                static_cast<int32_t>(filled * sizeof(T)), count * kPad);
            PipeBarrier<PIPE_V>();
        }
    }
    if constexpr (TRANS_A) {
        small_vector_family_detail::StridedIndices(indices[bIndexCount], kPad,
            static_cast<int32_t>(mPad * sizeof(T)), pipe);
        for (uint32_t filled = 1U; filled < m; filled *= 2U) {
            const uint32_t count = m - filled < filled ? m - filled : filled;
            Adds(indices[bIndexCount + filled * kPad], indices[bIndexCount],
                static_cast<int32_t>(filled * sizeof(T)), count * kPad);
            PipeBarrier<PIPE_V>();
        }
    }

    GlobalTensor<T> lhsGm, rhsGm;
    GlobalTensor<float> output;
    lhsGm.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x1),
        static_cast<uint64_t>(batch) * m * k);
    rhsGm.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x2),
        static_cast<uint64_t>(batch) * n * k);
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y), batch);
    const uint8_t repeatStride = static_cast<uint8_t>(kPad / 8U);
    const BinaryRepeatParams multiply{1, 1, 1, repeatStride, 0, repeatStride};
    const BinaryRepeatParams fold{1, 1, 1, repeatStride, repeatStride, repeatStride};

    for (uint32_t batchId = GetBlockIdx(); batchId < batch; batchId += blocks) {
        Duplicate(a.template ReinterpretCast<uint16_t>(), uint16_t(0), aCount);
        Duplicate(b.template ReinterpretCast<uint16_t>(), uint16_t(0), bCount);
        PipeBarrier<PIPE_ALL>();
        small_vector_family_detail::CopyPaddedRows(a, lhsGm[static_cast<uint64_t>(batchId) * m * k],
            TRANS_A ? k : m, TRANS_A ? m : k, TRANS_A ? mPad : kPad);
        small_vector_family_detail::CopyPaddedRows(b, rhsGm[static_cast<uint64_t>(batchId) * n * k],
            TRANS_B ? n : k, TRANS_B ? k : n, TRANS_B ? kPad : nPad);
        PipeBarrier<PIPE_ALL>();
        if constexpr (TRANS_B) {
            Cast(rhs, b, RoundMode::CAST_NONE, dotCount);
        } else {
            Gather(packed, b, indices.template ReinterpretCast<uint32_t>(),
                uint32_t(0), dotCount);
            PipeBarrier<PIPE_V>();
            Cast(rhs, packed, RoundMode::CAST_NONE, dotCount);
        }

        PipeBarrier<PIPE_V>();
        if constexpr (TRANS_A) {
            Gather(packed, a,
                indices[bIndexCount].template ReinterpretCast<uint32_t>(),
                uint32_t(0), m * kPad);
            PipeBarrier<PIPE_V>();
            Cast(lhs, packed, RoundMode::CAST_NONE, m * kPad);
        } else {
            Cast(lhs, a, RoundMode::CAST_NONE, m * kPad);
        }
        PipeBarrier<PIPE_V>();

        for (uint32_t first = 0; first < m; first += rows) {
            const uint32_t active = m - first < rows ? m - first : rows;
            for (uint32_t r = 0; r < active; ++r) {
                Mul(product[r * dotCount], lhs[(first + r) * kPad], rhs,
                    64, n, multiply);
                if (kPad == 128U) {
                    Mul(product[r * dotCount + 64], lhs[(first + r) * kPad + 64],
                        rhs[64], 64, n, multiply);
                }
            }
            PipeBarrier<PIPE_V>();
            if (kPad == 128U) {

                Add(product, product, product[64], 64, active * n, fold);
                PipeBarrier<PIPE_V>();
            }
            for (uint32_t r = 0; r < active; ++r) {
                WholeReduceSum<float, true>(dots[r * nPad], product[r * dotCount],
                    64, n, 1, 1, repeatStride);
            }
            PipeBarrier<PIPE_V>();
            for (uint32_t r = 0; r < active; ++r) {

                WholeReduceMax<float, true>(maxima[first + r], dots[r * nPad],
                    n, 1, 1, 1, 8, ReduceOrder::ORDER_ONLY_VALUE);
            }
            PipeBarrier<PIPE_V>();
        }
        WholeReduceSum<float, true>(sum, maxima, m, 1, 1, 1, 8);
        PipeBarrier<PIPE_ALL>();
        DataCopyPad(output[batchId], sum, {1, sizeof(float), 0, 0, 0});
        PipeBarrier<PIPE_ALL>();
    }
}

template <typename T>
inline void Launch(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, uint32_t batch,
    uint32_t m, uint32_t n, uint32_t k, uint32_t blocks,
    bool ta, bool tb, aclrtStream stream)
{
    if (ta && tb) {
        GroupedBatchKernel<T, true, true><<<blocks, nullptr, stream>>>(x1, x2, y, batch, m, n, k, blocks);
    } else if (ta) {
        GroupedBatchKernel<T, true, false><<<blocks, nullptr, stream>>>(x1, x2, y, batch, m, n, k, blocks);
    } else if (tb) {
        GroupedBatchKernel<T, false, true><<<blocks, nullptr, stream>>>(x1, x2, y, batch, m, n, k, blocks);
    } else {
        GroupedBatchKernel<T, false, false><<<blocks, nullptr, stream>>>(x1, x2, y, batch, m, n, k, blocks);
    }
}
}


inline uint64_t SmallVectorFamilyRequiredUbBytes(uint32_t m, uint32_t n,
    uint32_t k, bool ta, bool tb)
{
    const uint32_t kPad = k <= 64U ? 64U : 128U;
    const uint32_t mPad = (m + 15U) / 16U * 16U;
    const uint32_t nPad = (n + 15U) / 16U * 16U;
    const uint32_t rows = m < small_vector_family::kRows ? m : small_vector_family::kRows;
    const uint64_t aCount = ta ? uint64_t(kPad) * mPad : uint64_t(m) * kPad;
    const uint64_t bCount = tb ? uint64_t(n) * kPad : uint64_t(kPad) * nPad;
    const uint64_t dotCount = uint64_t(n) * kPad;
    const uint64_t aIndexCount = ta ? uint64_t(m) * kPad : 0U;
    const uint64_t bIndexCount = tb ? 0U : dotCount;
    const uint64_t productCount = uint64_t(rows) * dotCount > uint64_t(m) * kPad ?
        uint64_t(rows) * dotCount : uint64_t(m) * kPad;

    // Every TBuf below is already a multiple of 32 bytes for this domain.
    return 2ULL * (aCount + bCount) +
        4ULL * (uint64_t(m) * kPad + dotCount + productCount +
            aIndexCount + bIndexCount + 8U + uint64_t(rows) * nPad + mPad) +
        32U;
}

inline bool TryRunSmallVectorFamily(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    uint32_t batch, uint32_t m, uint32_t n, uint32_t k, int32_t dtype,
    int64_t availableCoreNum, aclrtStream stream, bool ta, bool tb)
{
    if (!small_vector_family::Supports(dtype, static_cast<int32_t>(m),
            static_cast<int32_t>(n), static_cast<int32_t>(k)) ||
        batch == 0U || availableCoreNum <= 0) {
        return false;
    }
    auto *platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (platform == nullptr) return false;
    const int64_t aivCores = static_cast<int64_t>(platform->GetCoreNumAiv());
    const int64_t launchLimit = std::min<int64_t>(availableCoreNum, aivCores);
    if (launchLimit <= 0) return false;
    uint64_t ubBytes = 0;
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubBytes);
    const uint64_t requiredUb = SmallVectorFamilyRequiredUbBytes(m, n, k, ta, tb);
    if (requiredUb == 0U || requiredUb > ubBytes) return false;
    const uint32_t blocks = static_cast<uint32_t>(
        std::min<int64_t>(launchLimit, static_cast<int64_t>(batch)));
    if (blocks == 0U) return false;
if (dtype == 1) {
        small_vector_family::Launch<half>(x1, x2, y, batch, m, n, k,
            blocks, ta, tb, stream);
    } else {
        small_vector_family::Launch<bfloat16_t>(x1, x2, y, batch, m, n, k,
            blocks, ta, tb, stream);
    }
    return true;
}


// FP16 NN family for tall M with short, aligned N and K.  Logical tensor
// geometry and work ownership are runtime metadata; constants below describe
// only the reusable on-chip tile class and ISA alignment.
namespace raw_nn_tallm_shortnk {

constexpr uint32_t CUBE_ALIGN = 16;
constexpr uint32_t VECTOR_ALIGN = 8;
constexpr uint32_t MICRO_M = 128;
constexpr uint32_t MIN_STRIPE_ROWS = 2 * MICRO_M;
constexpr uint32_t STRIPE_ROW_CAP = 4 * MICRO_M;
constexpr uint32_t SHORT_N_CAP = 4 * CUBE_ALIGN;
constexpr uint32_t SHORT_K_CAP = 8 * CUBE_ALIGN;
constexpr uint32_t MIN_K_BLOCKS = 2;
constexpr uint32_t SUM_GROUP_ROWS = 64;
constexpr uint32_t SUM_GROUP_CAP = STRIPE_ROW_CAP / SUM_GROUP_ROWS;
constexpr uint32_t TILE_WIDTH = 64;
constexpr uint32_t TILE_K = 128;
constexpr uint16_t READY = 8;
constexpr uint16_t CONSUMED = 9;

struct Plan {
    uint32_t batch;
    uint32_t m;
    uint32_t n;
    uint32_t k;
    uint32_t stripeRows;
    uint32_t stripesPerBatch;
    uint32_t workItems;
    uint32_t blockDim;
    uint32_t ubBytes;
    uint64_t scratchElements;
    uint64_t partialElements;
};

static_assert(MICRO_M * TILE_K <= 16384U,
    "Multi-matrix ND2NZ destination stride fits the API range");
static_assert(sizeof(Plan) <= 64, "Direct launch metadata capacity");
static_assert(STRIPE_ROW_CAP % MICRO_M == 0 &&
    SHORT_N_CAP % CUBE_ALIGN == 0 && SHORT_K_CAP % CUBE_ALIGN == 0 &&
    SUM_GROUP_CAP <= 8,
    "Tall-M tile capacities must satisfy Cube and vector limits");

__aicore__ inline uint32_t MinU32(uint32_t lhs, uint32_t rhs)
{
    return lhs < rhs ? lhs : rhs;
}

__aicore__ inline uint32_t TaskBatch(uint32_t task, const Plan &d)
{
    return task / d.stripesPerBatch;
}

__aicore__ inline uint32_t TaskFirstRow(uint32_t task, const Plan &d)
{
    return (task % d.stripesPerBatch) * d.stripeRows;
}

__aicore__ inline uint32_t TaskRows(uint32_t task, const Plan &d)
{
    const uint32_t first = TaskFirstRow(task, d);
    return MinU32(d.stripeRows, d.m - first);
}

__aicore__ inline void RowMaxDynamic(LocalTensor<float> input, uint32_t rows, uint32_t width)
{
    while (rows > 1U) {
        const uint32_t pairs = rows / 2U;
        Max(input, input, input[pairs * width], pairs * width);
        PipeBarrier<PIPE_V>();
        if (rows & 1U) {
            Max(input, input, input[(rows - 1U) * width], width);
            PipeBarrier<PIPE_V>();
        }
        rows = pairs;
    }
}
template <uint32_t Rows> struct RowMaxTree {
    __aicore__ static inline void Run(LocalTensor<float> input, uint32_t width)
    {
        Max(input, input, input[(Rows / 2U) * width], (Rows / 2U) * width);
        PipeBarrier<PIPE_V>();
        RowMaxTree<Rows / 2U>::Run(input, width);
    }
};
template <> struct RowMaxTree<1> {
    __aicore__ static inline void Run(LocalTensor<float>, uint32_t) {}
};

template <bool Full>
__aicore__ inline void Run(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    GM_ADDR scratchGm, GM_ADDR partialGm, const Plan &d)
{
    const uint32_t inputK = Full ? TILE_K : d.k;
    const uint32_t validWidth = Full ? TILE_WIDTH : d.n;
    const uint32_t batches = Full ? 1U : d.batch;
    const uint32_t group = GetBlockIdx();
    const uint64_t scratchOffset =
        static_cast<uint64_t>(group) * STRIPE_ROW_CAP * TILE_WIDTH;

    GlobalTensor<float> scratch;
    scratch.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(scratchGm),
        d.scratchElements);

    if ASCEND_IS_AIC {
        GlobalTensor<half> lhs;
        GlobalTensor<half> rhs;
        lhs.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(x2),
            static_cast<uint64_t>(batches) * inputK * validWidth);
        rhs.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(x1),
            static_cast<uint64_t>(batches) * d.m * inputK);

        LocalTensor<half> a1(TPosition::A1, 0, TILE_K * TILE_WIDTH);
        LocalTensor<half> b1(TPosition::B1, (TILE_K * TILE_WIDTH) * sizeof(half), STRIPE_ROW_CAP * TILE_K);
        LocalTensor<half> a2(TPosition::A2, 0, TILE_K * TILE_WIDTH);
        LocalTensor<half> b2(TPosition::B2, 0, 2U * MICRO_M * TILE_K);
        LocalTensor<float> c(TPosition::CO1, 0, TILE_WIDTH * STRIPE_ROW_CAP);

        constexpr uint16_t a2Reusable = 0;
        constexpr uint16_t operandsReady = 0;


        const uint8_t pads[4] = {0, 0, 0, 0};
        SetLoadDataRepeat(LoadDataRepeatParam{0, 1, 0});
        SetLoadDataBoundary(0);
        SetLoadDataPaddingValue<half>(half(0.0f));
        SetMMRowMajor();
        for (uint32_t task = group; task < d.workItems;
             task += d.blockDim) {
            const uint32_t batch = Full ? 0U : TaskBatch(task, d);
            const uint32_t firstRow = Full ? task * STRIPE_ROW_CAP : TaskFirstRow(task, d);
            const uint32_t validRows = Full ? STRIPE_ROW_CAP : TaskRows(task, d);
            const uint32_t phases =
                (validRows + MICRO_M - 1U) / MICRO_M;
            const bool hasNext = task + d.blockDim < d.workItems;
            const uint64_t lhsOffset = static_cast<uint64_t>(batch) * inputK * validWidth;
            const uint64_t rhsOffset = (static_cast<uint64_t>(batch) * d.m + firstRow) * inputK;
            const bool padA = validWidth < TILE_WIDTH || inputK < TILE_K;
            const bool padB = validRows < STRIPE_ROW_CAP || inputK < TILE_K;
            if (padA) InitConstValue(a1, InitConstValueParams<half>{1,
                static_cast<uint16_t>(TILE_K * TILE_WIDTH * sizeof(half) / 32U), 0, half(0.0f)});
            if (padB) InitConstValue(b1, InitConstValueParams<half>{1,
                static_cast<uint16_t>(STRIPE_ROW_CAP * TILE_K * sizeof(half) / 32U), 0, half(0.0f)});
            if (padA || padB) PipeBarrier<PIPE_MTE2>();
            DataCopy(a1, lhs[lhsOffset], Nd2NzParams{1,
                static_cast<uint16_t>(inputK), static_cast<uint16_t>(validWidth),
                0, static_cast<uint16_t>(validWidth), TILE_K, 1, 0});
#pragma unroll
            for (uint32_t part = 0; part < STRIPE_ROW_CAP / MICRO_M; ++part) {
                if (part < phases) {
                    const uint32_t first = part * MICRO_M;
                    const uint32_t rows = MinU32(MICRO_M, validRows - first);
                    DataCopy(b1[part * MICRO_M * TILE_K],
                        rhs[rhsOffset + uint64_t(first) * inputK],
                        Nd2NzParams{1, static_cast<uint16_t>(rows),
                            static_cast<uint16_t>(inputK), 0,
                            static_cast<uint16_t>(inputK), MICRO_M, 1, 0});
                    SetFlag<HardEvent::MTE2_MTE1>(part);
                }
            }
            WaitFlag<HardEvent::MTE2_MTE1>(0);
            LoadData(a2, a1, LoadData2DParams{0,
                TILE_WIDTH * TILE_K / 256U, 1, 0, 0, true, 0});

#pragma unroll
            for (uint32_t phase = 0;
                 phase < STRIPE_ROW_CAP / MICRO_M; ++phase) {
                if (phase < phases) {
                    const uint32_t row = phase * MICRO_M;
                    const uint32_t rows =
                        MinU32(MICRO_M, validRows - row);
                    if (phase != 0) WaitFlag<HardEvent::MTE2_MTE1>(phase);
                    if (phase >= 2U) {
                        SetFlag<HardEvent::M_MTE1>(a2Reusable);
                        WaitFlag<HardEvent::M_MTE1>(a2Reusable);
                    }
                    const uint32_t bSlot = (phase & 1U) * MICRO_M * TILE_K;
                    LoadData(b2[bSlot], b1[phase * MICRO_M * TILE_K],
                        LoadData2DParams{0, MICRO_M * TILE_K / 256U,
                            1, 0, 0, false, 0});
                    SetFlag<HardEvent::MTE1_M>(operandsReady);
                    WaitFlag<HardEvent::MTE1_M>(operandsReady);
                    Mmad(c[phase * MICRO_M * TILE_WIDTH], a2, b2[bSlot],
                        MmadParams{static_cast<uint16_t>(TILE_WIDTH),
                            static_cast<uint16_t>(MICRO_M),
                            static_cast<uint16_t>(TILE_K), uint8_t(3),
                            false, true});
                    FixpipeParamsV220 fix{};
                    fix.nSize = MICRO_M;
                    fix.mSize = TILE_WIDTH;
                    fix.srcStride = TILE_WIDTH;
                    fix.dstStride = MICRO_M;
                    fix.ndNum = 1;
                    fix.unitFlag = 3;
                    Fixpipe<float, float, CFG_ROW_MAJOR>(
                        scratch[scratchOffset +
                            static_cast<uint64_t>(phase) * TILE_WIDTH * MICRO_M],
                        c[phase * MICRO_M * TILE_WIDTH], fix);
                    CrossCoreSetFlag<2, PIPE_FIX>(READY);
                }
            }
            if (hasNext) {
                CrossCoreWaitFlag(CONSUMED);
            }
        }

    }

    if ASCEND_IS_AIV {
        GlobalTensor<float> output;
        GlobalTensor<float> partial;
        output.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y), batches);
        partial.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(partialGm),
            d.partialElements);
        const uint32_t inputElements = STRIPE_ROW_CAP * TILE_WIDTH;
        const uint32_t inputBytes = inputElements * sizeof(float);
        const uint32_t maximaBytes = STRIPE_ROW_CAP * sizeof(float);
        LocalTensor<float> input(TPosition::VECCALC, 0, inputElements);
        LocalTensor<float> maxima(TPosition::VECCALC, inputBytes, STRIPE_ROW_CAP);
        LocalTensor<float> chunks(TPosition::VECCALC, inputBytes + maximaBytes, SUM_GROUP_CAP);

        for (uint32_t task = group; task < d.workItems;
             task += d.blockDim) {
            if (task != group) {
                                                                             
                SetFlag<HardEvent::V_MTE2>(0);
                WaitFlag<HardEvent::V_MTE2>(0);
            }
            const uint32_t batch = Full ? 0U : TaskBatch(task, d);
            const uint32_t validRows = Full ? STRIPE_ROW_CAP : TaskRows(task, d);
            const uint32_t phases =
                (validRows + MICRO_M - 1U) / MICRO_M;
            const bool hasNext = task + d.blockDim < d.workItems;

#pragma unroll
            for (uint32_t phase = 0;
                 phase < STRIPE_ROW_CAP / MICRO_M; ++phase) {
                if (phase < phases) {
                    const uint32_t row = phase * MICRO_M;
                    const uint32_t rows =
                        MinU32(MICRO_M, validRows - row);
                    CrossCoreWaitFlag(READY);
                    const uint32_t phaseOffset = phase * TILE_WIDTH * MICRO_M;
                    DataCopy(input[phaseOffset], scratch[scratchOffset + phaseOffset],
                        TILE_WIDTH * MICRO_M);
                    SetFlag<HardEvent::MTE2_V>(0);
                    WaitFlag<HardEvent::MTE2_V>(0);
                    if (hasNext && phase + 1U == phases) {
                        CrossCoreSetFlag<2, PIPE_MTE2>(CONSUMED);
                    }
                    if constexpr (Full) {
                        RowMaxTree<TILE_WIDTH>::Run(input[phaseOffset], MICRO_M);
                    } else {
                        RowMaxDynamic(input[phaseOffset], validWidth, MICRO_M);
                    }
                    DataCopy(maxima[row], input[phaseOffset], rows);

                }
            }

            PipeBarrier<PIPE_V>();
            const uint32_t fullGroups = validRows / SUM_GROUP_ROWS;
            const uint32_t remainder = validRows % SUM_GROUP_ROWS;
            if (fullGroups != 0) {
                WholeReduceSum<float, true>(chunks, maxima,
                    SUM_GROUP_ROWS, fullGroups, 1, 1, 8);
            }
            if (remainder != 0) {
                WholeReduceSum<float, true>(chunks[fullGroups],
                    maxima[fullGroups * SUM_GROUP_ROWS], remainder,
                    1, 1, 1, 8);
            }
            PipeBarrier<PIPE_V>();
            const uint32_t sumGroups = fullGroups +
                (remainder == 0 ? 0U : 1U);
            WholeReduceSum<float, true>(input, chunks, sumGroups,
                1, 1, 1, 8);
            SetFlag<HardEvent::V_MTE3>(0);
            WaitFlag<HardEvent::V_MTE3>(0);
            DataCopyPad(partial[task], input,
                DataCopyExtParams{1, sizeof(float), 0, 0, 0});
            SetFlag<HardEvent::MTE3_V>(0);
            WaitFlag<HardEvent::MTE3_V>(0);
        }




        CrossCoreSetFlag<0, PIPE_MTE3>(1);
        CrossCoreWaitFlag(1);
        for (uint32_t batch = group; batch < batches;
             batch += d.blockDim) {
            if (batch != group) {
                SetFlag<HardEvent::V_MTE2>(0);
                WaitFlag<HardEvent::V_MTE2>(0);
            }
            const uint64_t first =
                static_cast<uint64_t>(batch) * d.stripesPerBatch;
            DataCopyPad(input, partial[first],
                DataCopyExtParams{1,
                    static_cast<uint32_t>(
                        d.stripesPerBatch * sizeof(float)),
                    0, 0, 0},
                DataCopyPadExtParams<float>{false, 0, 0, 0});
            SetFlag<HardEvent::MTE2_V>(0);
            WaitFlag<HardEvent::MTE2_V>(0);
            WholeReduceSum<float, true>(chunks, input,
                d.stripesPerBatch, 1, 1, 1, 8);
            SetFlag<HardEvent::V_MTE3>(0);
            WaitFlag<HardEvent::V_MTE3>(0);
            DataCopyPad(output[batch], chunks,
                DataCopyExtParams{1, sizeof(float), 0, 0, 0});
            SetFlag<HardEvent::MTE3_V>(0);
            WaitFlag<HardEvent::MTE3_V>(0);
        }
    }
}

__aicore__ inline void RunPrefetch(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    GM_ADDR scratchGm, GM_ADDR partialGm, const Plan &d)
{
    constexpr bool Full = true;
    const uint32_t inputK = Full ? TILE_K : d.k;
    const uint32_t validWidth = Full ? TILE_WIDTH : d.n;
    const uint32_t batches = Full ? 1U : d.batch;
    const uint32_t group = GetBlockIdx();
    const uint64_t scratchOffset =
        static_cast<uint64_t>(group) * STRIPE_ROW_CAP * TILE_WIDTH;

    GlobalTensor<float> scratch;
    scratch.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(scratchGm),
        d.scratchElements);

    if ASCEND_IS_AIC {
        GlobalTensor<half> lhs;
        GlobalTensor<half> rhs;
        lhs.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(x2),
            static_cast<uint64_t>(batches) * inputK * validWidth);
        rhs.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(x1),
            static_cast<uint64_t>(batches) * d.m * inputK);

        LocalTensor<half> a1(TPosition::A1, 0, TILE_K * TILE_WIDTH);
        LocalTensor<half> b1(TPosition::B1, (TILE_K * TILE_WIDTH) * sizeof(half), STRIPE_ROW_CAP * TILE_K);
        LocalTensor<half> a2(TPosition::A2, 0, TILE_K * TILE_WIDTH);
        LocalTensor<half> b2(TPosition::B2, 0, 2U * MICRO_M * TILE_K);
        LocalTensor<float> c(TPosition::CO1, 0, TILE_WIDTH * STRIPE_ROW_CAP);

        constexpr uint16_t a2Reusable = 0;
        constexpr uint16_t operandsReady = 0;


        const uint8_t pads[4] = {0, 0, 0, 0};
        SetLoadDataRepeat(LoadDataRepeatParam{0, 1, 0});
        SetLoadDataBoundary(0);
        SetLoadDataPaddingValue<half>(half(0.0f));
        SetMMRowMajor();
        for (uint32_t task = group; task < d.workItems;
             task += d.blockDim) {
            const uint32_t batch = Full ? 0U : TaskBatch(task, d);
            const uint32_t firstRow = Full ? task * STRIPE_ROW_CAP : TaskFirstRow(task, d);
            const uint32_t validRows = Full ? STRIPE_ROW_CAP : TaskRows(task, d);
            const uint32_t phases =
                (validRows + MICRO_M - 1U) / MICRO_M;
            const bool hasNext = task + d.blockDim < d.workItems;
            const uint64_t lhsOffset = static_cast<uint64_t>(batch) * inputK * validWidth;
            const uint64_t rhsOffset = (static_cast<uint64_t>(batch) * d.m + firstRow) * inputK;
            const bool padA = validWidth < TILE_WIDTH || inputK < TILE_K;
            const bool padB = validRows < STRIPE_ROW_CAP || inputK < TILE_K;
            if (padA) InitConstValue(a1, InitConstValueParams<half>{1,
                static_cast<uint16_t>(TILE_K * TILE_WIDTH * sizeof(half) / 32U), 0, half(0.0f)});
            if (padB) InitConstValue(b1, InitConstValueParams<half>{1,
                static_cast<uint16_t>(STRIPE_ROW_CAP * TILE_K * sizeof(half) / 32U), 0, half(0.0f)});
            if (padA || padB) PipeBarrier<PIPE_MTE2>();
            DataCopy(a1, lhs[lhsOffset], Nd2NzParams{1,
                static_cast<uint16_t>(inputK), static_cast<uint16_t>(validWidth),
                0, static_cast<uint16_t>(validWidth), TILE_K, 1, 0});
#pragma unroll
            for (uint32_t part = 0; part < STRIPE_ROW_CAP / MICRO_M; ++part) {
                if (part < phases) {
                    const uint32_t first = part * MICRO_M;
                    const uint32_t rows = MinU32(MICRO_M, validRows - first);
                    DataCopy(b1[part * MICRO_M * TILE_K],
                        rhs[rhsOffset + uint64_t(first) * inputK],
                        Nd2NzParams{1, static_cast<uint16_t>(rows),
                            static_cast<uint16_t>(inputK), 0,
                            static_cast<uint16_t>(inputK), MICRO_M, 1, 0});
                    SetFlag<HardEvent::MTE2_MTE1>(part);
                }
            }
            WaitFlag<HardEvent::MTE2_MTE1>(0);
            LoadData(a2, a1, LoadData2DParams{0,
                TILE_WIDTH * TILE_K / 256U, 1, 0, 0, true, 0});

            LoadData(b2,b1,LoadData2DParams{0,MICRO_M*TILE_K/256U,1,0,0,false,0});
            SetFlag<HardEvent::MTE1_M>(operandsReady);
#pragma unroll
            for (uint32_t phase = 0;
                 phase < STRIPE_ROW_CAP / MICRO_M; ++phase) {
                if (phase < phases) {
                    const uint32_t row = phase * MICRO_M;
                    const uint32_t rows =
                        MinU32(MICRO_M, validRows - row);
                    WaitFlag<HardEvent::MTE1_M>(operandsReady);
                    const uint32_t bSlot = (phase & 1U) * MICRO_M * TILE_K;
                    if(phase+1U<phases) {
                                                                              
                                                                              
                                                                               
                        if(phase>0U) {
                            SetFlag<HardEvent::M_MTE1>(a2Reusable);
                            WaitFlag<HardEvent::M_MTE1>(a2Reusable);
                        }
                        WaitFlag<HardEvent::MTE2_MTE1>(phase+1U);
                        const uint32_t nextSlot=((phase+1U)&1U)*MICRO_M*TILE_K;
                        LoadData(b2[nextSlot],b1[(phase+1U)*MICRO_M*TILE_K],
                            LoadData2DParams{0,MICRO_M*TILE_K/256U,1,0,0,false,0});
                        SetFlag<HardEvent::MTE1_M>(operandsReady);
                    }
                    Mmad(c[phase * MICRO_M * TILE_WIDTH], a2, b2[bSlot],
                        MmadParams{static_cast<uint16_t>(TILE_WIDTH),
                            static_cast<uint16_t>(MICRO_M),
                            static_cast<uint16_t>(TILE_K), uint8_t(3),
                            false, true});
                    FixpipeParamsV220 fix{};
                    fix.nSize = MICRO_M;
                    fix.mSize = TILE_WIDTH;
                    fix.srcStride = TILE_WIDTH;
                    fix.dstStride = MICRO_M;
                    fix.ndNum = 1;
                    fix.unitFlag = 3;
                    Fixpipe<float, float, CFG_ROW_MAJOR>(
                        scratch[scratchOffset +
                            static_cast<uint64_t>(phase) * TILE_WIDTH * MICRO_M],
                        c[phase * MICRO_M * TILE_WIDTH], fix);
                    CrossCoreSetFlag<2, PIPE_FIX>(READY);
                }
            }
            if (hasNext) {
                CrossCoreWaitFlag(CONSUMED);
            }
        }

    }

    if ASCEND_IS_AIV {
        GlobalTensor<float> output;
        GlobalTensor<float> partial;
        output.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y), batches);
        partial.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(partialGm),
            d.partialElements);
        const uint32_t inputElements = STRIPE_ROW_CAP * TILE_WIDTH;
        const uint32_t inputBytes = inputElements * sizeof(float);
        const uint32_t maximaBytes = STRIPE_ROW_CAP * sizeof(float);
        LocalTensor<float> input(TPosition::VECCALC, 0, inputElements);
        LocalTensor<float> maxima(TPosition::VECCALC, inputBytes, STRIPE_ROW_CAP);
        LocalTensor<float> chunks(TPosition::VECCALC, inputBytes + maximaBytes, SUM_GROUP_CAP);

        for (uint32_t task = group; task < d.workItems;
             task += d.blockDim) {
            if (task != group) {
                                                                             
                SetFlag<HardEvent::V_MTE2>(0);
                WaitFlag<HardEvent::V_MTE2>(0);
            }
            const uint32_t batch = Full ? 0U : TaskBatch(task, d);
            const uint32_t validRows = Full ? STRIPE_ROW_CAP : TaskRows(task, d);
            const uint32_t phases =
                (validRows + MICRO_M - 1U) / MICRO_M;
            const bool hasNext = task + d.blockDim < d.workItems;

#pragma unroll
            for (uint32_t phase = 0;
                 phase < STRIPE_ROW_CAP / MICRO_M; ++phase) {
                if (phase < phases) {
                    const uint32_t row = phase * MICRO_M;
                    const uint32_t rows =
                        MinU32(MICRO_M, validRows - row);
                    CrossCoreWaitFlag(READY);
                    const uint32_t phaseOffset = phase * TILE_WIDTH * MICRO_M;
                    DataCopy(input[phaseOffset], scratch[scratchOffset + phaseOffset],
                        TILE_WIDTH * MICRO_M);
                    SetFlag<HardEvent::MTE2_V>(0);
                    WaitFlag<HardEvent::MTE2_V>(0);
                    if (hasNext && phase + 1U == phases) {
                        CrossCoreSetFlag<2, PIPE_MTE2>(CONSUMED);
                    }
                    if constexpr (Full) {
                        RowMaxTree<TILE_WIDTH>::Run(input[phaseOffset], MICRO_M);
                    } else {
                        RowMaxDynamic(input[phaseOffset], validWidth, MICRO_M);
                    }
                    DataCopy(maxima[row], input[phaseOffset], rows);

                }
            }

            PipeBarrier<PIPE_V>();
            const uint32_t fullGroups = validRows / SUM_GROUP_ROWS;
            const uint32_t remainder = validRows % SUM_GROUP_ROWS;
            if (fullGroups != 0) {
                WholeReduceSum<float, true>(chunks, maxima,
                    SUM_GROUP_ROWS, fullGroups, 1, 1, 8);
            }
            if (remainder != 0) {
                WholeReduceSum<float, true>(chunks[fullGroups],
                    maxima[fullGroups * SUM_GROUP_ROWS], remainder,
                    1, 1, 1, 8);
            }
            PipeBarrier<PIPE_V>();
            const uint32_t sumGroups = fullGroups +
                (remainder == 0 ? 0U : 1U);
            WholeReduceSum<float, true>(input, chunks, sumGroups,
                1, 1, 1, 8);
            PipeBarrier<PIPE_V>();
            Duplicate(chunks,0.0f,8);
            PipeBarrier<PIPE_V>();
            Adds(chunks,input,0.0f,uint64_t(1),1,UnaryRepeatParams{1,1,8,8});
            SetFlag<HardEvent::V_MTE3>(0);
            WaitFlag<HardEvent::V_MTE3>(0);
            DataCopy(partial[uint64_t(task)*64U],chunks,8);
            SetFlag<HardEvent::MTE3_V>(0);
            WaitFlag<HardEvent::MTE3_V>(0);
        }




        CrossCoreSetFlag<0, PIPE_MTE3>(1);
        CrossCoreWaitFlag(1);
        for (uint32_t batch = group; batch < batches;
             batch += d.blockDim) {
            if (batch != group) {
                SetFlag<HardEvent::V_MTE2>(0);
                WaitFlag<HardEvent::V_MTE2>(0);
            }
            const uint64_t first =
                static_cast<uint64_t>(batch) * d.stripesPerBatch;
            DataCopy(input,partial[first*64U],
                DataCopyParams{static_cast<uint16_t>(d.stripesPerBatch),1,7U,0});
            SetFlag<HardEvent::MTE2_V>(0);
            WaitFlag<HardEvent::MTE2_V>(0);
            const uint32_t padded=d.stripesPerBatch*8U;
            const uint32_t groups=padded/64U;
            const uint32_t tail=padded%64U;
            if(groups!=0U) WholeReduceSum<float,true>(chunks,input,64,groups,1,1,8);
            if(tail!=0U) WholeReduceSum<float,true>(chunks[groups],input[groups*64U],tail,1,1,1,8);
            PipeBarrier<PIPE_V>();
            WholeReduceSum<float,true>(chunks,chunks,groups+(tail!=0U?1U:0U),1,1,1,8);
            SetFlag<HardEvent::V_MTE3>(0);
            WaitFlag<HardEvent::V_MTE3>(0);
            DataCopyPad(output[batch], chunks,
                DataCopyExtParams{1, sizeof(float), 0, 0, 0});
            SetFlag<HardEvent::MTE3_V>(0);
            WaitFlag<HardEvent::MTE3_V>(0);
        }
    }
}

}

extern "C" __global__ __aicore__ void batch_matmul_raw_nn_tallm_shortnk_fp16(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR scratch, GM_ADDR partial,
    raw_nn_tallm_shortnk::Plan plan)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
    raw_nn_tallm_shortnk::Run<false>(x1, x2, y, scratch, partial, plan);
}
extern "C" __global__ __aicore__ void batch_matmul_raw_nn_tallm_shortnk_fp16_full_capacity(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR scratch, GM_ADDR partial,
    uint32_t extent)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
    raw_nn_tallm_shortnk::Plan plan{};
    plan.batch=1U;
    plan.m=extent;
    plan.n=raw_nn_tallm_shortnk::TILE_WIDTH;
    plan.k=raw_nn_tallm_shortnk::TILE_K;
    plan.stripeRows=raw_nn_tallm_shortnk::STRIPE_ROW_CAP;
    plan.stripesPerBatch=extent/raw_nn_tallm_shortnk::STRIPE_ROW_CAP;
    plan.workItems=plan.stripesPerBatch;
    plan.blockDim=GetBlockNum();
    plan.scratchElements=uint64_t(plan.blockDim)*raw_nn_tallm_shortnk::STRIPE_ROW_CAP*raw_nn_tallm_shortnk::TILE_WIDTH;
    plan.partialElements=uint64_t(plan.workItems)*64U;
    plan.ubBytes=raw_nn_tallm_shortnk::STRIPE_ROW_CAP*raw_nn_tallm_shortnk::TILE_WIDTH*sizeof(float)+raw_nn_tallm_shortnk::STRIPE_ROW_CAP*sizeof(float)+32U;

    raw_nn_tallm_shortnk::RunPrefetch(x1, x2, y, scratch, partial, plan);
}

inline bool GenerateRawNnTallMShortNkPlan(
    platform_ascendc::PlatformAscendC *platform, uint32_t batch,
    uint32_t m, uint32_t n, uint32_t k, int64_t availableCoreNum,
    raw_nn_tallm_shortnk::Plan &plan)
{
    using namespace raw_nn_tallm_shortnk;
    if (platform == nullptr || availableCoreNum <= 0 || batch == 0 ||
        m < MIN_STRIPE_ROWS || m % CUBE_ALIGN != 0 ||
        n == 0 || n > SHORT_N_CAP || n % CUBE_ALIGN != 0 ||
        k < MIN_K_BLOCKS * CUBE_ALIGN || k > SHORT_K_CAP ||
        k % CUBE_ALIGN != 0) {
        return false;
    }

    const uint64_t useful = std::min<uint64_t>(m, STRIPE_ROW_CAP) * n * k;
    if (useful * 4U < uint64_t(STRIPE_ROW_CAP) * TILE_WIDTH * TILE_K) return false;

    const uint64_t hardware = std::min<uint64_t>(
        platform->GetCoreNumAic(), platform->GetCoreNumAiv());
    const uint64_t coreLimit64 = std::min<uint64_t>(
        static_cast<uint64_t>(availableCoreNum), hardware);
    if (coreLimit64 == 0 || coreLimit64 > UINT32_MAX) return false;
    const uint32_t coreLimit = static_cast<uint32_t>(coreLimit64);

    uint64_t l1 = 0;
    uint64_t l0a = 0;
    uint64_t l0b = 0;
    uint64_t l0c = 0;
    uint64_t ub = 0;
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1, l1);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A, l0a);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B, l0b);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C, l0c);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ub);

    const uint64_t bBytes = static_cast<uint64_t>(TILE_K) * TILE_WIDTH * sizeof(half);
    const uint64_t l0aBytes =
        static_cast<uint64_t>(TILE_WIDTH) * TILE_K * sizeof(half);
    const uint64_t l0bBytes = 2ULL * MICRO_M * TILE_K * sizeof(half);
    const uint64_t l0cBytes =
        static_cast<uint64_t>(STRIPE_ROW_CAP) * TILE_WIDTH * sizeof(float);
    if (uint64_t(STRIPE_ROW_CAP) * TILE_K * sizeof(half) + bBytes > l1 || l0aBytes > l0a || l0bBytes > l0b ||
        l0cBytes > l0c || ub <= 32) {
        return false;
    }

    const uint64_t stripeRows = STRIPE_ROW_CAP;
    const uint64_t stripesPerBatch =
        (static_cast<uint64_t>(m) + stripeRows - 1U) / stripeRows;
    const uint64_t workItems =
        static_cast<uint64_t>(batch) * stripesPerBatch;
    const uint64_t blockDim = std::min(coreLimit64, workItems);
    const uint64_t scratchElements =
        blockDim * stripeRows * TILE_WIDTH;
    const uint64_t ubBytes =
        stripeRows * TILE_WIDTH * sizeof(float) +
        stripeRows * sizeof(float) + 32U;
    if (stripeRows > UINT32_MAX || stripesPerBatch > UINT32_MAX ||
        workItems == 0 || workItems > UINT32_MAX || blockDim == 0 ||
        blockDim > UINT32_MAX || ubBytes > ub || ubBytes > UINT32_MAX ||
        stripesPerBatch > SUM_GROUP_ROWS ||
        scratchElements > SIZE_MAX / sizeof(float)) {
        return false;
    }

    plan.batch = batch;
    plan.m = m;
    plan.n = n;
    plan.k = k;
    plan.stripeRows = static_cast<uint32_t>(stripeRows);
    plan.stripesPerBatch = static_cast<uint32_t>(stripesPerBatch);
    plan.workItems = static_cast<uint32_t>(workItems);
    plan.blockDim = static_cast<uint32_t>(blockDim);
    plan.ubBytes = static_cast<uint32_t>(ubBytes);
    plan.scratchElements = scratchElements;
    plan.partialElements = workItems;
    return true;
}

inline bool TryRunRawNnTallMShortNk(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    uint32_t batch, uint32_t m, uint32_t n, uint32_t k, int32_t dtype,
    int64_t availableCoreNum, aclrtStream stream, bool transposeX1,
    bool transposeX2)
{
    if (dtype != 1 || transposeX1 || transposeX2) return false;
    raw_nn_tallm_shortnk::Plan plan{};
    if (!GenerateRawNnTallMShortNkPlan(
            platform_ascendc::PlatformAscendCManager::GetInstance(),
            batch, m, n, k, availableCoreNum, plan)) {
        return false;
    }

    const bool full = batch == 1U && k == raw_nn_tallm_shortnk::TILE_K &&
        n == raw_nn_tallm_shortnk::TILE_WIDTH &&
        m % raw_nn_tallm_shortnk::STRIPE_ROW_CAP == 0U;
    if(full) plan.partialElements*=64U;
    uint8_t *scratch = nullptr;
    uint8_t *partial = nullptr;
    const size_t scratchBytes =
        static_cast<size_t>(plan.scratchElements) * sizeof(float);
    if (aclrtMalloc(reinterpret_cast<void **>(&scratch), scratchBytes,
            ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS ||
        aclrtMalloc(reinterpret_cast<void **>(&partial),
            static_cast<size_t>(plan.partialElements) * sizeof(float),
            ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        if (scratch != nullptr) aclrtFree(scratch);
        if (partial != nullptr) aclrtFree(partial);
        return false;
    }
    if (full) {
batch_matmul_raw_nn_tallm_shortnk_fp16_full_capacity<<<
        plan.blockDim, nullptr, stream>>>(x1, x2, y, scratch, partial, m);
    } else {
batch_matmul_raw_nn_tallm_shortnk_fp16<<<
        plan.blockDim, nullptr, stream>>>(x1, x2, y, scratch, partial, plan);
    }
    const aclError result = aclrtSynchronizeStream(stream);
    aclrtFree(scratch);
    aclrtFree(partial);
    if (result != ACL_SUCCESS) {
        throw std::runtime_error(
            "NN tall-M short-NK Raw device execution failed");
    }
    return true;
}


// FP16 TN full-matrix tile family. The fixed capacities describe one reusable
// on-chip tile class; all logical tensor geometry comes from runtime metadata.
namespace raw_tn_fulltile {
constexpr uint32_t CAP_M = 32;
constexpr uint32_t CAP_N = 128;
constexpr uint32_t CAP_K = 256;
constexpr uint32_t FRACTAL_ELEMENTS = 16 * 16;
constexpr uint32_t A_ELEMENTS = CAP_M * CAP_K;
constexpr uint32_t B_ELEMENTS = CAP_N * CAP_K;
constexpr uint32_t C_ELEMENTS = CAP_M * CAP_N;
constexpr uint32_t ROW_ELEMENTS = CAP_M;
constexpr uint64_t L1_BYTES = uint64_t(A_ELEMENTS + B_ELEMENTS) * sizeof(half);
constexpr uint64_t L0A_BYTES = uint64_t(A_ELEMENTS) * sizeof(half);
constexpr uint64_t L0B_BYTES = uint64_t(B_ELEMENTS) * sizeof(half);
constexpr uint64_t L0C_BYTES = uint64_t(C_ELEMENTS) * sizeof(float);
constexpr uint64_t UB_BYTES = uint64_t(C_ELEMENTS + 2 * ROW_ELEMENTS) * sizeof(float) + 32;
constexpr uint16_t READY = 8;
constexpr uint16_t CONSUMED = 9;
static_assert(CAP_M % 16 == 0 && CAP_N % 16 == 0 && CAP_K % 16 == 0 &&
    (CAP_M / 16) * (CAP_K / 16) <= 255,
    "Full-tile capacities must satisfy Cube fractal and repeat limits");

struct Plan {
    uint32_t batch;
    uint32_t m;
    uint32_t n;
    uint32_t k;
    uint32_t blockDim;
    uint32_t mFractals;
    uint32_t nFractals;
    uint32_t kFractals;
    uint32_t cElements;
    uint64_t scratchElements;
};
static_assert(sizeof(Plan) <= 64, "Direct launch metadata capacity");

__aicore__ inline void RunOriginal(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    GM_ADDR scratchGm, const Plan &d)
{
    const uint32_t group = GetBlockIdx();
    const uint64_t scratchOffset = uint64_t(group) * d.cElements;
    TPipe pipe;
    GlobalTensor<float> scratch;
    scratch.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(scratchGm),
        d.scratchElements);

    if ASCEND_IS_AIC {
        GlobalTensor<half> lhs;
        GlobalTensor<half> rhs;
        lhs.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(x1),
            uint64_t(d.batch) * d.m * d.k);
        rhs.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(x2),
            uint64_t(d.batch) * d.k * d.n);

        TBuf<TPosition::A1> a1Buffer;
        TBuf<TPosition::B1> b1Buffer;
        TBuf<TPosition::A2> a2Buffer;
        TBuf<TPosition::B2> b2Buffer;
        TBuf<TPosition::CO1> cBuffer;
        pipe.InitBuffer(a1Buffer, A_ELEMENTS * sizeof(half));
        pipe.InitBuffer(b1Buffer, B_ELEMENTS * sizeof(half));
        pipe.InitBuffer(a2Buffer, A_ELEMENTS * sizeof(half));
        pipe.InitBuffer(b2Buffer, B_ELEMENTS * sizeof(half));
        pipe.InitBuffer(cBuffer, C_ELEMENTS * sizeof(float));
        auto a1 = a1Buffer.Get<half>();
        auto b1 = b1Buffer.Get<half>();
        auto a2 = a2Buffer.Get<half>();
        auto b2 = b2Buffer.Get<half>();
        auto c = cBuffer.Get<float>();

        const Nd2NzParams copyA{1, static_cast<uint16_t>(d.k),
            static_cast<uint16_t>(d.m), 0, static_cast<uint16_t>(d.m),
            static_cast<uint16_t>(d.k), 1, 0};
        const Nd2NzParams copyB{1, static_cast<uint16_t>(d.k),
            static_cast<uint16_t>(d.n), 0, static_cast<uint16_t>(d.n),
            static_cast<uint16_t>(d.k), 1, 0};
        const LoadData2DParams loadA{0,
            static_cast<uint8_t>(d.mFractals * d.kFractals),
            1, 0, 0, true, 0};
        const LoadData2DParams loadB{0,
            static_cast<uint8_t>(d.kFractals), 1, 0,
            static_cast<uint8_t>(d.nFractals - 1), true, 0};
        const MmadParams multiply{static_cast<uint16_t>(d.m),
            static_cast<uint16_t>(d.n), static_cast<uint16_t>(d.k),
            uint8_t(0), false, true};
        FixpipeParamsV220 fix{};
        fix.nSize = d.n;
        fix.mSize = d.m;
        fix.srcStride = d.m;
        fix.dstStride = d.n;
        fix.ndNum = 1;

        for (uint32_t batch = group; batch < d.batch; batch += d.blockDim) {
            DataCopy(a1, lhs[uint64_t(batch) * d.m * d.k], copyA);
            DataCopy(b1, rhs[uint64_t(batch) * d.k * d.n], copyB);
            SetFlag<HardEvent::MTE2_MTE1>(0);
            WaitFlag<HardEvent::MTE2_MTE1>(0);
            LoadData(a2, a1, loadA);
#pragma unroll
            for (uint32_t nBlock = 0; nBlock < CAP_N / 16; ++nBlock) {
                if (nBlock < d.nFractals) {
                    LoadData(b2[nBlock * FRACTAL_ELEMENTS],
                        b1[uint64_t(nBlock) * 16 * d.k], loadB);
                }
            }
            SetFlag<HardEvent::MTE1_M>(0);
            WaitFlag<HardEvent::MTE1_M>(0);
            Mmad(c, a2, b2, multiply);
            SetFlag<HardEvent::M_FIX>(0);
            WaitFlag<HardEvent::M_FIX>(0);
            Fixpipe<float, float, CFG_ROW_MAJOR>(scratch[scratchOffset], c, fix);
            CrossCoreSetFlag<2, PIPE_FIX>(READY);

            // The final iteration never waits for an acknowledgement, matching
            // the fast single-batch-per-group path. Reused scratch slots wait
            // only until the paired Vector core has copied the prior result.
            if (batch + d.blockDim < d.batch) {
                CrossCoreWaitFlag(CONSUMED);
            }
        }
    }

    if ASCEND_IS_AIV {
        GlobalTensor<float> output;
        output.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y), d.batch);
        TBuf<TPosition::VECCALC> storage;
        pipe.InitBuffer(storage, UB_BYTES);
        auto input = storage.GetWithOffset<float>(C_ELEMENTS, 0);
        auto maxima = storage.GetWithOffset<float>(ROW_ELEMENTS,
            C_ELEMENTS * sizeof(float));
        auto high = storage.GetWithOffset<float>(ROW_ELEMENTS,
            (C_ELEMENTS + ROW_ELEMENTS) * sizeof(float));
        auto sum = storage.GetWithOffset<float>(8,
            (C_ELEMENTS + 2 * ROW_ELEMENTS) * sizeof(float));

        for (uint32_t batch = group; batch < d.batch; batch += d.blockDim) {
            CrossCoreWaitFlag(READY);
            DataCopy(input, scratch[scratchOffset], d.cElements);
            SetFlag<HardEvent::MTE2_V>(0);
            WaitFlag<HardEvent::MTE2_V>(0);

            const uint32_t rowStride = d.n / 8;
            if (d.n <= 64) {
                WholeReduceMax<float, true>(maxima, input,
                    static_cast<int32_t>(d.n), static_cast<int32_t>(d.m),
                    1, 1, static_cast<int32_t>(rowStride),
                    ReduceOrder::ORDER_ONLY_VALUE);
            } else {
                WholeReduceMax<float, true>(maxima, input, 64,
                    static_cast<int32_t>(d.m), 1, 1,
                    static_cast<int32_t>(rowStride),
                    ReduceOrder::ORDER_ONLY_VALUE);
                WholeReduceMax<float, true>(high, input[64],
                    static_cast<int32_t>(d.n - 64),
                    static_cast<int32_t>(d.m), 1, 1,
                    static_cast<int32_t>(rowStride),
                    ReduceOrder::ORDER_ONLY_VALUE);
                PipeBarrier<PIPE_V>();
                Max(maxima, maxima, high, d.m);
            }
            PipeBarrier<PIPE_V>();
            WholeReduceSum<float, true>(sum, maxima,
                static_cast<int32_t>(d.m), 1, 1, 1, 8);
            SetFlag<HardEvent::V_MTE3>(0);
            WaitFlag<HardEvent::V_MTE3>(0);
            DataCopyPad(output[batch], sum, {1, sizeof(float), 0, 0, 0});

            // Reused slots acknowledge only after output DMA has consumed sum;
            // the extra local events also protect the next input/Vector cycle.
            if (batch + d.blockDim < d.batch) {
                CrossCoreSetFlag<2, PIPE_MTE3>(CONSUMED);
                SetFlag<HardEvent::MTE3_V>(0);
                WaitFlag<HardEvent::MTE3_V>(0);
                SetFlag<HardEvent::V_MTE2>(0);
                WaitFlag<HardEvent::V_MTE2>(0);
            }
        }
    }
}
// Stateless resource alternative; the original function above is the full fallback.
#if defined(__NPU_ARCH__) && (__NPU_ARCH__ == 2201) && \
    (!defined(ASCENDC_CPU_DEBUG) || (ASCENDC_CPU_DEBUG == 0)) && \
    !defined(ASCENDC_TIME_STAMP_ON) && \
    !defined(__ASCENDC_ENABLE_SUPER_KERNEL__)
class TnResourceHardwareGuard {
public:
    __aicore__ inline TnResourceHardwareGuard()
    {
        // Effective implementation of the installed TPipe member InitSocState.
        AscendCUtils::InitSocStateImpl();
        if ASCEND_IS_AIC {
            SetFlag<HardEvent::M_MTE1>(0);
            SetFlag<HardEvent::M_MTE1>(1);
            SetFlag<HardEvent::M_MTE1>(2);
        }
    }

    __aicore__ inline ~TnResourceHardwareGuard()
    {
        if ASCEND_IS_AIC {
            WaitFlag<HardEvent::M_MTE1>(0);
            WaitFlag<HardEvent::M_MTE1>(1);
            WaitFlag<HardEvent::M_MTE1>(2);
        }
        pipe_barrier(PIPE_ALL);
    }
};

template <uint32_t MT>
__aicore__ inline void RunStatelessMtile(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    GM_ADDR scratchGm, const Plan &d)
{
    static_assert(MT == 16U || MT == 32U, "Supported local M tile classes");
    const uint32_t group = GetBlockIdx();
    const uint64_t scratchOffset = uint64_t(group) * (MT * d.n);
    TnResourceHardwareGuard pipe;
    GlobalTensor<float> scratch;
    scratch.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(scratchGm),
        d.scratchElements);

    if ASCEND_IS_AIC {
        GlobalTensor<half> lhs;
        GlobalTensor<half> rhs;
        lhs.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(x1),
            uint64_t(d.batch) * MT * d.k);
        rhs.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(x2),
            uint64_t(d.batch) * d.k * d.n);

        LocalTensor<half> a1(TPosition::A1, 0, A_ELEMENTS);
        LocalTensor<half> b1(TPosition::B1, A_ELEMENTS * sizeof(half), B_ELEMENTS);
        LocalTensor<half> a2(TPosition::A2, 0, A_ELEMENTS);
        LocalTensor<half> b2(TPosition::B2, 0, B_ELEMENTS);
        LocalTensor<float> c(TPosition::CO1, 0, C_ELEMENTS);

        const Nd2NzParams copyA{1, static_cast<uint16_t>(d.k),
            static_cast<uint16_t>(MT), 0, static_cast<uint16_t>(MT),
            static_cast<uint16_t>(d.k), 1, 0};
        const Nd2NzParams copyB{1, static_cast<uint16_t>(d.k),
            static_cast<uint16_t>(d.n), 0, static_cast<uint16_t>(d.n),
            static_cast<uint16_t>(d.k), 1, 0};
        const LoadData2DParams loadA{0,
            static_cast<uint8_t>((MT / 16U) * d.kFractals),
            1, 0, 0, true, 0};
        const LoadData2DParams loadB{0,
            static_cast<uint8_t>(d.kFractals), 1, 0,
            static_cast<uint8_t>(d.nFractals - 1), true, 0};
        const MmadParams multiply{static_cast<uint16_t>(MT),
            static_cast<uint16_t>(d.n), static_cast<uint16_t>(d.k),
            uint8_t(0), false, true};
        FixpipeParamsV220 fix{};
        fix.nSize = d.n;
        fix.mSize = MT;
        fix.srcStride = MT;
        fix.dstStride = d.n;
        fix.ndNum = 1;

        for (uint32_t batch = group; batch < d.batch; batch += d.blockDim) {
            DataCopy(a1, lhs[uint64_t(batch) * MT * d.k], copyA);
            DataCopy(b1, rhs[uint64_t(batch) * d.k * d.n], copyB);
            SetFlag<HardEvent::MTE2_MTE1>(0);
            WaitFlag<HardEvent::MTE2_MTE1>(0);
            LoadData(a2, a1, loadA);
#pragma unroll
            for (uint32_t nBlock = 0; nBlock < CAP_N / 16; ++nBlock) {
                if (nBlock < d.nFractals) {
                    LoadData(b2[nBlock * FRACTAL_ELEMENTS],
                        b1[uint64_t(nBlock) * 16 * d.k], loadB);
                }
            }
            SetFlag<HardEvent::MTE1_M>(0);
            WaitFlag<HardEvent::MTE1_M>(0);
            Mmad(c, a2, b2, multiply);
            SetFlag<HardEvent::M_FIX>(0);
            WaitFlag<HardEvent::M_FIX>(0);
            Fixpipe<float, float, CFG_ROW_MAJOR>(scratch[scratchOffset], c, fix);
            CrossCoreSetFlag<2, PIPE_FIX>(READY);

            // The final iteration never waits for an acknowledgement, matching
            // the fast single-batch-per-group path. Reused scratch slots wait
            // only until the paired Vector core has copied the prior result.
            if (batch + d.blockDim < d.batch) {
                CrossCoreWaitFlag(CONSUMED);
            }
        }
    }

    if ASCEND_IS_AIV {
        GlobalTensor<float> output;
        output.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y), d.batch);
        LocalTensor<float> input(TPosition::VECCALC, 0, C_ELEMENTS);
        LocalTensor<float> maxima(TPosition::VECCALC,
            C_ELEMENTS * sizeof(float), ROW_ELEMENTS);
        LocalTensor<float> high(TPosition::VECCALC,
            (C_ELEMENTS + ROW_ELEMENTS) * sizeof(float), ROW_ELEMENTS);
        LocalTensor<float> sum(TPosition::VECCALC,
            (C_ELEMENTS + 2 * ROW_ELEMENTS) * sizeof(float), 8);

        for (uint32_t batch = group; batch < d.batch; batch += d.blockDim) {
            CrossCoreWaitFlag(READY);
            DataCopy(input, scratch[scratchOffset], (MT * d.n));
            SetFlag<HardEvent::MTE2_V>(0);
            WaitFlag<HardEvent::MTE2_V>(0);

            const uint32_t rowStride = d.n / 8;
            if (d.n <= 64) {
                WholeReduceMax<float, true>(maxima, input,
                    static_cast<int32_t>(d.n), static_cast<int32_t>(MT),
                    1, 1, static_cast<int32_t>(rowStride),
                    ReduceOrder::ORDER_ONLY_VALUE);
            } else {
                WholeReduceMax<float, true>(maxima, input, 64,
                    static_cast<int32_t>(MT), 1, 1,
                    static_cast<int32_t>(rowStride),
                    ReduceOrder::ORDER_ONLY_VALUE);
                WholeReduceMax<float, true>(high, input[64],
                    static_cast<int32_t>(d.n - 64),
                    static_cast<int32_t>(MT), 1, 1,
                    static_cast<int32_t>(rowStride),
                    ReduceOrder::ORDER_ONLY_VALUE);
                PipeBarrier<PIPE_V>();
                Max(maxima, maxima, high, MT);
            }
            PipeBarrier<PIPE_V>();
            WholeReduceSum<float, true>(sum, maxima,
                static_cast<int32_t>(MT), 1, 1, 1, 8);
            SetFlag<HardEvent::V_MTE3>(0);
            WaitFlag<HardEvent::V_MTE3>(0);
            DataCopyPad(output[batch], sum, {1, sizeof(float), 0, 0, 0});

            // Reused slots acknowledge only after output DMA has consumed sum;
            // the extra local events also protect the next input/Vector cycle.
            if (batch + d.blockDim < d.batch) {
                CrossCoreSetFlag<2, PIPE_MTE3>(CONSUMED);
                SetFlag<HardEvent::MTE3_V>(0);
                WaitFlag<HardEvent::MTE3_V>(0);
                SetFlag<HardEvent::V_MTE2>(0);
                WaitFlag<HardEvent::V_MTE2>(0);
            }
        }
    }
}

__aicore__ inline void RunStateless(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    GM_ADDR scratchGm, const Plan &d)
{
    // GenerateRawTnFullTilePlan admits one or two complete M fractals.
    // Only the local M tile class is static; B/N/K remain runtime metadata.
    if (d.mFractals == 1U) {
        RunStatelessMtile<16U>(x1, x2, y, scratchGm, d);
    } else {
        RunStatelessMtile<32U>(x1, x2, y, scratchGm, d);
    }
}

#endif

__aicore__ inline void Run(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    GM_ADDR scratchGm, const Plan &d)
{
#if defined(__NPU_ARCH__) && (__NPU_ARCH__ == 2201) && \
    (!defined(ASCENDC_CPU_DEBUG) || (ASCENDC_CPU_DEBUG == 0)) && \
    !defined(ASCENDC_TIME_STAMP_ON) && \
    !defined(__ASCENDC_ENABLE_SUPER_KERNEL__)
    // SDK instrumentation/configuration only; never shape or call state.
    if constexpr (g_gm_overflow_check) {
        RunOriginal(x1, x2, y, scratchGm, d);
    } else {
        RunStateless(x1, x2, y, scratchGm, d);
    }
#else
    RunOriginal(x1, x2, y, scratchGm, d);
#endif
}
} // namespace raw_tn_fulltile

extern "C" __global__ __aicore__ void batch_matmul_raw_tn_fulltile_fp16(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR scratch,
    raw_tn_fulltile::Plan plan)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
    raw_tn_fulltile::Run(x1, x2, y, scratch, plan);
}

inline bool GenerateRawTnFullTilePlan(
    platform_ascendc::PlatformAscendC *platform, uint32_t batch,
    uint32_t m, uint32_t n, uint32_t k, int64_t cores,
    raw_tn_fulltile::Plan &plan)
{
    using namespace raw_tn_fulltile;
    if (platform == nullptr || cores <= 0 || batch == 0 || m == 0 ||
        n == 0 || k == 0 || m > CAP_M || n > CAP_N || k > CAP_K ||
        m % 16 != 0 || n % 16 != 0 || k % 16 != 0) {
        return false;
    }

    const uint32_t coreLimit = static_cast<uint32_t>(std::min<int64_t>(cores,
        std::min<int64_t>(platform->GetCoreNumAic(),
            platform->GetCoreNumAiv())));
    if (coreLimit == 0) return false;

    uint64_t l1 = 0;
    uint64_t l0a = 0;
    uint64_t l0b = 0;
    uint64_t l0c = 0;
    uint64_t ub = 0;
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1, l1);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A, l0a);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B, l0b);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C, l0c);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ub);
    if (L1_BYTES > l1 || L0A_BYTES > l0a || L0B_BYTES > l0b ||
        L0C_BYTES > l0c || UB_BYTES > ub) {
        return false;
    }

    plan.batch = batch;
    plan.m = m;
    plan.n = n;
    plan.k = k;
    plan.blockDim = batch < coreLimit ? batch : coreLimit;
    plan.mFractals = m / 16;
    plan.nFractals = n / 16;
    plan.kFractals = k / 16;
    plan.cElements = m * n;
    plan.scratchElements = uint64_t(plan.blockDim) * plan.cElements;
    return plan.blockDim != 0 && plan.mFractals * plan.kFractals <= 255 &&
        plan.kFractals <= 255;
}

inline bool TryRunRawTnFullTile(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    uint32_t batch, uint32_t m, uint32_t n, uint32_t k, int32_t dtype,
    int64_t cores, aclrtStream stream, bool transposeX1, bool transposeX2)
{
    if (dtype != 1 || !transposeX1 || transposeX2) return false;
    raw_tn_fulltile::Plan plan{};
    if (!GenerateRawTnFullTilePlan(
            platform_ascendc::PlatformAscendCManager::GetInstance(),
            batch, m, n, k, cores, plan)) {
        return false;
    }
uint8_t *scratch = nullptr;
    if (aclrtMalloc(reinterpret_cast<void **>(&scratch),
            plan.scratchElements * sizeof(float),
            ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        return false;
    }
    batch_matmul_raw_tn_fulltile_fp16<<<plan.blockDim, nullptr, stream>>>(
        x1, x2, y, scratch, plan);
    const aclError result = aclrtSynchronizeStream(stream);
    aclrtFree(scratch);
    if (result != ACL_SUCCESS) {
        throw std::runtime_error("FP16 TN full-tile Raw device execution failed");
    }
    return true;
}


// BF16 NT full-matrix tile family with runtime M/N tails. The fixed capacities
// describe one reusable on-chip tile class; logical geometry is runtime data.
namespace raw_nt_fulltile_bf16 {
constexpr uint32_t CAP_M = 32;
constexpr uint32_t CAP_N = 80;
constexpr uint32_t CAP_K = 192;
constexpr uint32_t FRACTAL_ELEMENTS = 16 * 16;
constexpr uint32_t A_ELEMENTS = CAP_M * CAP_K;
constexpr uint32_t B_ELEMENTS = CAP_N * CAP_K;
constexpr uint32_t C_ELEMENTS = CAP_M * CAP_N;
constexpr uint32_t ROW_ELEMENTS = CAP_M;
constexpr uint64_t L1_BYTES = uint64_t(A_ELEMENTS + B_ELEMENTS) * sizeof(bfloat16_t);
constexpr uint64_t L0A_BYTES = uint64_t(A_ELEMENTS) * sizeof(bfloat16_t);
constexpr uint64_t L0B_BYTES = uint64_t(B_ELEMENTS) * sizeof(bfloat16_t);
constexpr uint64_t L0C_BYTES = uint64_t(C_ELEMENTS) * sizeof(float);
constexpr uint64_t UB_BYTES = uint64_t(C_ELEMENTS + 2 * ROW_ELEMENTS) * sizeof(float) + 32;
constexpr uint16_t READY = 8;
constexpr uint16_t CONSUMED = 9;
static_assert(CAP_M % 16 == 0 && CAP_N % 16 == 0 && CAP_K % 16 == 0 &&
    (CAP_N / 16) * (CAP_K / 16) <= 255,
    "Full-tile capacities must satisfy Cube fractal and repeat limits");

struct Plan {
    uint32_t batch;
    uint32_t m;
    uint32_t n;
    uint32_t k;
    uint32_t blockDim;
    uint32_t padM;
    uint32_t padN;
    uint32_t scratchStride;
    uint32_t mFractals;
    uint32_t nFractals;
    uint32_t kFractals;
    uint32_t inputElements;
    uint64_t scratchElements;
};
static_assert(sizeof(Plan) <= 64, "Direct launch metadata capacity");

template <bool SINGLE_BATCH>
__aicore__ inline void Run(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    GM_ADDR scratchGm, const Plan &d)
{
    const uint32_t group = GetBlockIdx();
    const uint64_t scratchOffset = uint64_t(group) * d.scratchStride;
    InitSocState();
    GlobalTensor<float> scratch;
    scratch.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(scratchGm),
        d.scratchElements);

    if ASCEND_IS_AIC {
        GlobalTensor<bfloat16_t> lhs;
        GlobalTensor<bfloat16_t> rhs;
        lhs.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(x1),
            uint64_t(d.batch) * d.m * d.k);
        rhs.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(x2),
            uint64_t(d.batch) * d.n * d.k);
        LocalTensor<bfloat16_t> a1(TPosition::A1, 0, A_ELEMENTS);
        LocalTensor<bfloat16_t> b1(TPosition::B1,
            A_ELEMENTS * sizeof(bfloat16_t), B_ELEMENTS);
        LocalTensor<bfloat16_t> a2(TPosition::A2, 0, A_ELEMENTS);
        LocalTensor<bfloat16_t> b2(TPosition::B2, 0, B_ELEMENTS);
        LocalTensor<float> c(TPosition::CO1, 0, C_ELEMENTS);
        LocalTensor<uint64_t> unitControl(TPosition::C2PIPE2GM, 0, 16);
        SetFixPipeConfig<uint64_t, false>(unitControl, true);
        SetMMColumnMajor();
        PipeBarrier<PIPE_ALL>();

        if (d.m < 16U && d.padM != d.m) {
            InitConstValue(a1[d.m * 16].ReinterpretCast<uint16_t>(),
                InitConstValueParams<uint16_t>{
                    static_cast<uint16_t>(d.kFractals),
                    static_cast<uint16_t>(d.padM - d.m),
                    static_cast<uint16_t>(d.m), 0});
        }

        const Nd2NzParams copyA{1, static_cast<uint16_t>(d.m),
            static_cast<uint16_t>(d.k), 0, static_cast<uint16_t>(d.k),
            static_cast<uint16_t>(d.padM), 1, 0};
        const Nd2NzParams copyB{1, static_cast<uint16_t>(d.n),
            static_cast<uint16_t>(d.k), 0, static_cast<uint16_t>(d.k),
            static_cast<uint16_t>(d.padN), 1, 0};
        const LoadData2DParams loadA{0,
            static_cast<uint8_t>(d.kFractals),
            static_cast<uint16_t>(d.mFractals), 0, 0, false, 0};
        const LoadData2DParams loadB{0,
            static_cast<uint8_t>(d.kFractals * d.nFractals),
            1, 0, 0, false, 0};
        const MmadParams multiply{static_cast<uint16_t>(d.m < 16U ? 16U : d.m),
            static_cast<uint16_t>(d.n), static_cast<uint16_t>(d.k),
            uint8_t(3), false, true};
        FixpipeParamsV220 fix{};
        fix.nSize = d.padN;
        fix.mSize = d.m;
        fix.srcStride = d.padM;
        fix.dstStride = 2U * d.m;
        fix.ndNum = 1;
        fix.unitFlag = 3;

        for (uint32_t batch = group; SINGLE_BATCH || batch < d.batch;
            batch += d.blockDim) {
            DataCopy(a1, lhs[uint64_t(batch) * d.m * d.k], copyA);
            DataCopy(b1, rhs[uint64_t(batch) * d.n * d.k], copyB);
            SetFlag<HardEvent::MTE2_MTE1>(0);
            WaitFlag<HardEvent::MTE2_MTE1>(0);
#pragma unroll
            for (uint32_t mBlock = 0; mBlock < CAP_M / 16; ++mBlock) {
                if (mBlock < d.mFractals) {
                    LoadData(a2[mBlock * d.kFractals * FRACTAL_ELEMENTS],
                        a1[mBlock * FRACTAL_ELEMENTS], loadA);
                }
            }
            LoadData(b2, b1, loadB);
            SetFlag<HardEvent::MTE1_M>(0);
            WaitFlag<HardEvent::MTE1_M>(0);
            Mmad(c, a2, b2, multiply);
            Fixpipe<float, float, CFG_NZ>(scratch[scratchOffset], c, fix);
            CrossCoreSetFlag<2, PIPE_FIX>(READY);
            if (!SINGLE_BATCH && batch + d.blockDim < d.batch) {
                CrossCoreWaitFlag(CONSUMED);
            }
            if constexpr (SINGLE_BATCH) break;
        }
    }

    if ASCEND_IS_AIV {
        GlobalTensor<float> output;
        output.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y), d.batch);
        LocalTensor<float> input(TPosition::VECCALC, 0, C_ELEMENTS);
        LocalTensor<float> low(TPosition::VECCALC,
            C_ELEMENTS * sizeof(float), ROW_ELEMENTS);
        LocalTensor<float> high(TPosition::VECCALC,
            (C_ELEMENTS + ROW_ELEMENTS) * sizeof(float), ROW_ELEMENTS);
        LocalTensor<float> sum(TPosition::VECCALC,
            (C_ELEMENTS + 2 * ROW_ELEMENTS) * sizeof(float), 8);

        for (uint32_t batch = group; SINGLE_BATCH || batch < d.batch;
            batch += d.blockDim) {
            CrossCoreWaitFlag(READY);
            // Compact GM NZ layout: [ceil(N/16), M, 16].
            DataCopyPad(input, scratch[scratchOffset],
                {1, static_cast<uint32_t>(d.inputElements * sizeof(float)), 0, 0, 0},
                {false, 0, 0, 0});
            SetFlag<HardEvent::MTE2_V>(0);
            WaitFlag<HardEvent::MTE2_V>(0);

            if (d.n >= 49U) {
                // Compact NZ is [N16 plane, M, 16]. Each source block
                // advances one N16 plane; each repeat advances one M row.
                const uint32_t fullPlanes = d.n / 16U;
                const uint32_t tail = d.n % 16U;
                const uint32_t lowCount = fullPlanes * 8U +
                    (tail < 8U ? tail : 8U);
                const uint32_t highCount = fullPlanes * 8U +
                    (tail > 8U ? tail - 8U : 0U);
                WholeReduceMax<float, true>(low, input,
                    static_cast<int32_t>(lowCount),
                    static_cast<int32_t>(d.m), 1,
                    static_cast<int32_t>(2U * d.m), 2,
                    ReduceOrder::ORDER_ONLY_VALUE);
                if (highCount != 0U) {
                    WholeReduceMax<float, true>(high, input[8],
                        static_cast<int32_t>(highCount),
                        static_cast<int32_t>(d.m), 1,
                        static_cast<int32_t>(2U * d.m), 2,
                        ReduceOrder::ORDER_ONLY_VALUE);
                    PipeBarrier<PIPE_V>();
                    Max(low, low, high, d.m);
                }
                PipeBarrier<PIPE_V>();
            } else {
                const uint32_t planeElements = d.m * 16U;
                const uint32_t fullPlanes = d.n / 16U;
                for (uint32_t plane = 1; plane < fullPlanes; ++plane) {
                    // Exact dst==src0 overlap; src1 is a disjoint complete plane.
                    Max(input, input, input[plane * planeElements], planeElements);
                    PipeBarrier<PIPE_V>();
                }
                const uint32_t tail = d.n % 16U;
                if (fullPlanes != 0U && tail != 0U) {
                    // The final plane's invalid N lanes never enter any arithmetic.
                    Max<float, true>(input, input, input[fullPlanes * planeElements],
                        static_cast<uint64_t>(tail), static_cast<uint8_t>(d.m),
                        {1, 1, 1, 2, 2, 2});
                    PipeBarrier<PIPE_V>();
                }
                WholeReduceMax<float, true>(low, input,
                    static_cast<int32_t>(d.n < 16U ? d.n : 16U),
                    static_cast<int32_t>(d.m), 1, 1, 2,
                    ReduceOrder::ORDER_ONLY_VALUE);
                PipeBarrier<PIPE_V>();
            }
            WholeReduceSum<float, true>(sum, low,
                static_cast<int32_t>(d.m), 1, 1, 1, 8);
            SetFlag<HardEvent::V_MTE3>(0);
            WaitFlag<HardEvent::V_MTE3>(0);
            DataCopyPad(output[batch], sum, {1, sizeof(float), 0, 0, 0});

            if (!SINGLE_BATCH && batch + d.blockDim < d.batch) {
                CrossCoreSetFlag<2, PIPE_MTE3>(CONSUMED);
                SetFlag<HardEvent::MTE3_V>(0);
                WaitFlag<HardEvent::MTE3_V>(0);
                SetFlag<HardEvent::V_MTE2>(0);
                WaitFlag<HardEvent::V_MTE2>(0);
            }
            if constexpr (SINGLE_BATCH) break;
        }
    }
    PipeBarrier<PIPE_ALL>();
    if ASCEND_IS_AIC {
        LocalTensor<uint64_t> unitControl(TPosition::C2PIPE2GM, 0, 16);
        SetFixPipeConfig<uint64_t, false>(unitControl, false);
        PipeBarrier<PIPE_ALL>();
    }
}
} // namespace raw_nt_fulltile_bf16

extern "C" __global__ __aicore__ void batch_matmul_raw_nt_fulltile_bf16(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR scratch,
    raw_nt_fulltile_bf16::Plan plan)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
    raw_nt_fulltile_bf16::Run<false>(x1, x2, y, scratch, plan);
}

extern "C" __global__ __aicore__ void batch_matmul_raw_nt_fulltile_bf16_single(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR scratch,
    raw_nt_fulltile_bf16::Plan plan)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
    raw_nt_fulltile_bf16::Run<true>(x1, x2, y, scratch, plan);
}

inline bool GenerateRawNtFullTileBf16Plan(
    platform_ascendc::PlatformAscendC *platform, uint32_t batch,
    uint32_t m, uint32_t n, uint32_t k, int64_t cores,
    raw_nt_fulltile_bf16::Plan &plan)
{
    using namespace raw_nt_fulltile_bf16;
    if (platform == nullptr || cores <= 0 || batch == 0 || m == 0 ||
        n == 0 || k == 0 || m > CAP_M || n > CAP_N || k > CAP_K ||
        k % 16 != 0) {
        return false;
    }

    const uint32_t coreLimit = static_cast<uint32_t>(std::min<int64_t>(cores,
        std::min<int64_t>(platform->GetCoreNumAic(),
            platform->GetCoreNumAiv())));
    if (coreLimit == 0) return false;

    uint64_t l1 = 0;
    uint64_t l0a = 0;
    uint64_t l0b = 0;
    uint64_t l0c = 0;
    uint64_t ub = 0;
    uint64_t fb = 0;
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1, l1);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A, l0a);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B, l0b);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C, l0c);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ub);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::FB, fb);
    if (L1_BYTES > l1 || L0A_BYTES > l0a || L0B_BYTES > l0b ||
        L0C_BYTES > l0c || UB_BYTES > ub || fb < 128U) {
        return false;
    }

    plan.batch = batch;
    plan.m = m;
    plan.n = n;
    plan.k = k;
    plan.blockDim = batch < coreLimit ? batch : coreLimit;
    plan.padM = (m + 15U) / 16U * 16U;
    plan.padN = (n + 15U) / 16U * 16U;
    plan.mFractals = plan.padM / 16U;
    plan.nFractals = plan.padN / 16U;
    plan.kFractals = k / 16U;
    plan.inputElements = m * plan.padN;
    // Padding separates compact NZ slots and never enters arithmetic.
    plan.scratchStride = (plan.inputElements + 127U) / 128U * 128U;
    plan.scratchElements = uint64_t(plan.blockDim) * plan.scratchStride;
    return plan.blockDim != 0 && plan.padM <= CAP_M && plan.padN <= CAP_N &&
        plan.inputElements <= C_ELEMENTS &&
        plan.kFractals * plan.nFractals <= 255;
}

inline bool TryRunRawNtFullTileBf16(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    uint32_t batch, uint32_t m, uint32_t n, uint32_t k, int32_t dtype,
    int64_t cores, aclrtStream stream, bool transposeX1, bool transposeX2)
{
    if (dtype != 2 || transposeX1 || !transposeX2) return false;
    raw_nt_fulltile_bf16::Plan plan{};
    if (!GenerateRawNtFullTileBf16Plan(
            platform_ascendc::PlatformAscendCManager::GetInstance(),
            batch, m, n, k, cores, plan)) {
        return false;
    }
uint8_t *scratch = nullptr;
    if (aclrtMalloc(reinterpret_cast<void **>(&scratch),
            plan.scratchElements * sizeof(float) + 511U,
            ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        return false;
    }
    // aclrtMalloc guarantees 64B; preserve its original pointer for aclrtFree.
    uint8_t *alignedScratch = reinterpret_cast<uint8_t *>(
        (reinterpret_cast<uintptr_t>(scratch) + 511U) & ~uintptr_t(511U));
    if (plan.batch == plan.blockDim) {
        batch_matmul_raw_nt_fulltile_bf16_single<<<plan.blockDim, nullptr, stream>>>(
            x1, x2, y, alignedScratch, plan);
    } else {
        batch_matmul_raw_nt_fulltile_bf16<<<plan.blockDim, nullptr, stream>>>(
            x1, x2, y, alignedScratch, plan);
    }
    const aclError result = aclrtSynchronizeStream(stream);
    aclrtFree(scratch);
    if (result != ACL_SUCCESS) {
        throw std::runtime_error("BF16 NT full-tile Raw device execution failed");
    }
    return true;
}


// BF16 NT family for a wide reduction axis with short, aligned M and K.
// Whole-tensor geometry and work ownership are runtime metadata.  Constants
// describe only the reusable local-memory tile class and ISA alignment.
namespace raw_bf16_nt_widen_shortmk {

constexpr uint32_t CUBE_ALIGN = 16;
constexpr uint32_t MICRO_N = 128;
constexpr uint32_t MIN_WIDE_N = 2 * MICRO_N;
constexpr uint32_t STRIPE_ROW_CAP = 4 * MICRO_N;
constexpr uint32_t SHORT_M_CAP = 4 * CUBE_ALIGN;
constexpr uint32_t SHORT_K_CAP = 8 * CUBE_ALIGN;
constexpr uint32_t MIN_K_BLOCKS = 2;
constexpr uint32_t MAX_FINAL_STRIPES = 64;
constexpr uint32_t TILE_WIDTH = 64;
constexpr uint32_t TILE_K = 128;
constexpr uint16_t READY = 8;
constexpr uint16_t CONSUMED = 9;

struct Plan {
    uint32_t batch;
    uint32_t m;
    uint32_t n;
    uint32_t k;
    uint32_t stripeRows;
    uint32_t stripesPerBatch;
    uint32_t workItems;
    uint32_t blockDim;
    uint32_t ubBytes;
    uint64_t scratchElements;
    uint64_t partialElements;
};

static_assert(sizeof(Plan) <= 64, "Direct launch metadata capacity");
static_assert(STRIPE_ROW_CAP % MICRO_N == 0 &&
    SHORT_M_CAP % CUBE_ALIGN == 0 && SHORT_K_CAP % CUBE_ALIGN == 0,
    "Wide-N tile capacities must satisfy Cube alignment");

__aicore__ inline uint32_t MinU32(uint32_t lhs, uint32_t rhs)
{
    return lhs < rhs ? lhs : rhs;
}

__aicore__ inline uint32_t TaskBatch(uint32_t task, const Plan &d)
{
    return task / d.stripesPerBatch;
}

__aicore__ inline uint32_t TaskFirstN(uint32_t task, const Plan &d)
{
    return (task % d.stripesPerBatch) * d.stripeRows;
}

__aicore__ inline uint32_t TaskRows(uint32_t task, const Plan &d)
{
    const uint32_t first = TaskFirstN(task, d);
    return MinU32(d.stripeRows, d.n - first);
}

__aicore__ inline void MaxAcrossRows(
    LocalTensor<float> input, uint32_t rows, uint32_t width)
{
    while (rows > 1) {
        const uint32_t pairs = rows / 2;
        Max(input, input, input[pairs * width], pairs * width);
        PipeBarrier<PIPE_V>();
        if ((rows & 1U) != 0) {
            Max(input, input, input[(rows - 1U) * width], width);
            PipeBarrier<PIPE_V>();
        }
        rows = pairs;
    }
}

template <uint32_t Rows>
struct FixedMaxRows {
    __aicore__ static inline void Run(
        LocalTensor<float> input, uint32_t width)
    {
        constexpr uint32_t pairs = Rows / 2;
        Max(input, input, input[pairs * width], pairs * width);
        PipeBarrier<PIPE_V>();
        if constexpr ((Rows & 1U) != 0) {
            Max(input, input, input[(Rows - 1U) * width], width);
            PipeBarrier<PIPE_V>();
        }
        FixedMaxRows<pairs>::Run(input, width);
    }
};

template <>
struct FixedMaxRows<1> {
    __aicore__ static inline void Run(LocalTensor<float>, uint32_t) {}
};

template <bool Full>
__aicore__ inline void Run(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    GM_ADDR scratchGm, GM_ADDR partialGm, const Plan &d)
{
    const uint32_t inputK = Full ? TILE_K : d.k;
    const uint32_t validWidth = Full ? TILE_WIDTH : d.m;
    const uint32_t batches = Full ? 1U : d.batch;
    const uint32_t group = GetBlockIdx();
    const uint64_t scratchOffset =
        static_cast<uint64_t>(group) * STRIPE_ROW_CAP * TILE_WIDTH;

    GlobalTensor<float> scratch;
    scratch.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(scratchGm),
        d.scratchElements);

    if ASCEND_IS_AIC {
        GlobalTensor<bfloat16_t> lhs;
        GlobalTensor<bfloat16_t> rhs;
        lhs.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(x1),
            static_cast<uint64_t>(batches) * inputK * validWidth);
        rhs.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(x2),
            static_cast<uint64_t>(batches) * d.n * inputK);

        LocalTensor<bfloat16_t> a1(TPosition::A1, 0, TILE_K * TILE_WIDTH);
        LocalTensor<bfloat16_t> b1(TPosition::B1, (TILE_K * TILE_WIDTH) * sizeof(bfloat16_t), STRIPE_ROW_CAP * TILE_K);
        LocalTensor<bfloat16_t> a2(TPosition::A2, 0, TILE_K * TILE_WIDTH);
        LocalTensor<bfloat16_t> b2(TPosition::B2, 0, MICRO_N * TILE_K);
        LocalTensor<float> c(TPosition::CO1, 0, TILE_WIDTH * STRIPE_ROW_CAP);

        constexpr uint16_t a2Reusable = 0;
        constexpr uint16_t operandsReady = 0;


        const uint8_t pads[4] = {0, 0, 0, 0};
        SetLoadDataRepeat(LoadDataRepeatParam{0, 1, 0});
        SetLoadDataBoundary(0);
        SetLoadDataPaddingValue<half>(half(0.0f));
        SetMMRowMajor();
        for (uint32_t task = group; task < d.workItems;
             task += d.blockDim) {
            const uint32_t batch = Full ? 0U : TaskBatch(task, d);
            const uint32_t firstRow = Full ? task * STRIPE_ROW_CAP : TaskFirstN(task, d);
            const uint32_t validRows = Full ? STRIPE_ROW_CAP : TaskRows(task, d);
            const uint32_t phases =
                (validRows + MICRO_N - 1U) / MICRO_N;
            const bool hasNext = task + d.blockDim < d.workItems;
            const uint64_t lhsOffset = static_cast<uint64_t>(batch) * inputK * validWidth;
            const uint64_t rhsOffset = (static_cast<uint64_t>(batch) * d.n + firstRow) * inputK;
            const bool padA = validWidth < TILE_WIDTH || inputK < TILE_K;
            const bool padB = validRows < STRIPE_ROW_CAP || inputK < TILE_K;
            if (padA) InitConstValue(a1, InitConstValueParams<bfloat16_t>{1,
                static_cast<uint16_t>(TILE_K * TILE_WIDTH * sizeof(bfloat16_t) / 32U), 0, bfloat16_t(0.0f)});
            if (padB) InitConstValue(b1, InitConstValueParams<bfloat16_t>{1,
                static_cast<uint16_t>(STRIPE_ROW_CAP * TILE_K * sizeof(bfloat16_t) / 32U), 0, bfloat16_t(0.0f)});
            if (padA || padB) PipeBarrier<PIPE_MTE2>();
            DataCopy(a1, lhs[lhsOffset], Nd2NzParams{1,
                static_cast<uint16_t>(validWidth), static_cast<uint16_t>(inputK),
                0, static_cast<uint16_t>(inputK), TILE_WIDTH, 1, 0});
#pragma unroll
            for (uint32_t part = 0; part < STRIPE_ROW_CAP / MICRO_N; ++part) {
                if (part < phases) {
                    const uint32_t first = part * MICRO_N;
                    const uint32_t rows = MinU32(MICRO_N, validRows - first);
                    DataCopy(b1[part * MICRO_N * TILE_K],
                        rhs[rhsOffset + uint64_t(first) * inputK],
                        Nd2NzParams{1, static_cast<uint16_t>(rows),
                            static_cast<uint16_t>(inputK), 0,
                            static_cast<uint16_t>(inputK), MICRO_N, 1, 0});
                    SetFlag<HardEvent::MTE2_MTE1>(part);
                }
            }
            WaitFlag<HardEvent::MTE2_MTE1>(0);
            SetFmatrix(1, static_cast<uint16_t>(TILE_WIDTH), pads,
                FmatrixMode::FMATRIX_LEFT);
            LoadData3DParamsV2Pro loadA;
            loadA.channelSize = TILE_K;
            loadA.enTranspose = false;
            loadA.fMatrixCtrl = false;
            loadA.extConfig = (static_cast<uint64_t>(TILE_WIDTH) << 16) | TILE_K;
            LoadData(a2, a1, loadA);

#pragma unroll
            for (uint32_t phase = 0;
                 phase < STRIPE_ROW_CAP / MICRO_N; ++phase) {
                if (phase < phases) {
                    const uint32_t row = phase * MICRO_N;
                    const uint32_t rows =
                        MinU32(MICRO_N, validRows - row);
                    if (phase != 0) {
                        WaitFlag<HardEvent::MTE2_MTE1>(phase);
                        SetFlag<HardEvent::M_MTE1>(a2Reusable);
                        WaitFlag<HardEvent::M_MTE1>(a2Reusable);
                    }
                    LoadData(b2, b1[phase * MICRO_N * TILE_K],
                        LoadData2DParams{0, MICRO_N * TILE_K / 256U,
                            1, 0, 0, false, 0});
                    SetFlag<HardEvent::MTE1_M>(operandsReady);
                    WaitFlag<HardEvent::MTE1_M>(operandsReady);
                    Mmad(c[phase * MICRO_N * TILE_WIDTH], a2, b2,
                        MmadParams{static_cast<uint16_t>(TILE_WIDTH),
                            static_cast<uint16_t>(MICRO_N),
                            static_cast<uint16_t>(TILE_K), uint8_t(3),
                            false, true});
                    FixpipeParamsV220 fix{};
                    fix.nSize = MICRO_N;
                    fix.mSize = TILE_WIDTH;
                    fix.srcStride = TILE_WIDTH;
                    fix.dstStride = MICRO_N;
                    fix.ndNum = 1;
                    fix.unitFlag = 3;
                    Fixpipe<float, float, CFG_ROW_MAJOR>(
                        scratch[scratchOffset +
                            static_cast<uint64_t>(phase) * TILE_WIDTH * MICRO_N],
                        c[phase * MICRO_N * TILE_WIDTH], fix);
                    CrossCoreSetFlag<2, PIPE_FIX>(READY);
                }
            }
            if (hasNext) {
                CrossCoreWaitFlag(CONSUMED);
            }
        }

    }

    if ASCEND_IS_AIV {
        GlobalTensor<float> partial;
        GlobalTensor<float> output;
        partial.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(partialGm), d.partialElements);
        output.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y), batches);
        const uint32_t inputElements = STRIPE_ROW_CAP * TILE_WIDTH;
        const uint32_t inputBytes = inputElements * sizeof(float);
        LocalTensor<float> input(TPosition::VECCALC, 0, inputElements);
        LocalTensor<float> maxima(TPosition::VECCALC, inputBytes, TILE_WIDTH);
        LocalTensor<float> phaseMax(TPosition::VECCALC, inputBytes + TILE_WIDTH * sizeof(float), TILE_WIDTH);
        LocalTensor<float> tailMax(TPosition::VECCALC, inputBytes + 2 * TILE_WIDTH * sizeof(float), TILE_WIDTH);
        LocalTensor<float> scalar(TPosition::VECCALC, inputBytes + 3 * TILE_WIDTH * sizeof(float), 8);
        for (uint32_t task = group; task < d.workItems; task += d.blockDim) {
            const uint32_t validRows = Full ? STRIPE_ROW_CAP : TaskRows(task, d);
            const uint32_t phases = (validRows + MICRO_N - 1U) / MICRO_N;
            const bool hasNext = task + d.blockDim < d.workItems;
            if (task != group) {
                SetFlag<HardEvent::V_MTE2>(0);
                WaitFlag<HardEvent::V_MTE2>(0);
            }
#pragma unroll
            for (uint32_t phase = 0; phase < STRIPE_ROW_CAP / MICRO_N; ++phase) {
                if (phase < phases) {
                    const uint32_t row = phase * MICRO_N;
                    const uint32_t rows = MinU32(MICRO_N, validRows - row);
                    const uint32_t offset = phase * TILE_WIDTH * MICRO_N;
                    CrossCoreWaitFlag(READY);
                    DataCopy(input[offset], scratch[scratchOffset + offset], TILE_WIDTH * MICRO_N);
                    SetFlag<HardEvent::MTE2_V>(0);
                    WaitFlag<HardEvent::MTE2_V>(0);
                    if (hasNext && phase + 1U == phases) CrossCoreSetFlag<2, PIPE_MTE2>(CONSUMED);
                    if constexpr (Full) {
                        Max<float>(input[offset], input[offset], input[offset + 64],
                            uint64_t(64), TILE_WIDTH,
                            BinaryRepeatParams{1, 1, 1, MICRO_N / 8, MICRO_N / 8, MICRO_N / 8});
                        PipeBarrier<PIPE_V>();
                        WholeReduceMax<float, true>(phaseMax, input[offset],
                            64, TILE_WIDTH, 1, 1, MICRO_N / 8, ReduceOrder::ORDER_ONLY_VALUE);
                        PipeBarrier<PIPE_V>();
                    } else {
                        WholeReduceMax<float, true>(phaseMax, input[offset],
                            MinU32(64, rows), TILE_WIDTH, 1, 1,
                            MICRO_N / 8, ReduceOrder::ORDER_ONLY_VALUE);
                        PipeBarrier<PIPE_V>();
                        if (rows > 64) {
                            WholeReduceMax<float, true>(tailMax, input[offset + 64],
                                rows - 64, TILE_WIDTH, 1, 1,
                                MICRO_N / 8, ReduceOrder::ORDER_ONLY_VALUE);
                            PipeBarrier<PIPE_V>();
                            Max(phaseMax, phaseMax, tailMax, TILE_WIDTH);
                            PipeBarrier<PIPE_V>();
                        }
                    }
                    if (phase == 0) DataCopy(maxima, phaseMax, TILE_WIDTH);
                    else Max(maxima, maxima, phaseMax, TILE_WIDTH);
                    PipeBarrier<PIPE_V>();
                }
            }
            SetFlag<HardEvent::V_MTE3>(0);
            WaitFlag<HardEvent::V_MTE3>(0);
            DataCopy(partial[uint64_t(task) * TILE_WIDTH], maxima, TILE_WIDTH);
            SetFlag<HardEvent::MTE3_V>(0);
            WaitFlag<HardEvent::MTE3_V>(0);
        }
        CrossCoreSetFlag<0, PIPE_MTE3>(1);
        CrossCoreWaitFlag(1);
        for (uint32_t batch = group; batch < batches; batch += d.blockDim) {
            const uint64_t first = uint64_t(batch) * d.stripesPerBatch * TILE_WIDTH;
            DataCopy(input, partial[first], d.stripesPerBatch * TILE_WIDTH);
            SetFlag<HardEvent::MTE2_V>(0);
            WaitFlag<HardEvent::MTE2_V>(0);
            MaxAcrossRows(input, d.stripesPerBatch, TILE_WIDTH);
            WholeReduceSum<float, true>(scalar, input, validWidth, 1, 1, 1, 8);
            SetFlag<HardEvent::V_MTE3>(0);
            WaitFlag<HardEvent::V_MTE3>(0);
            DataCopyPad(output[batch], scalar, DataCopyExtParams{1, sizeof(float), 0, 0, 0});
            SetFlag<HardEvent::MTE3_V>(0);
            WaitFlag<HardEvent::MTE3_V>(0);
            SetFlag<HardEvent::V_MTE2>(0);
            WaitFlag<HardEvent::V_MTE2>(0);
        }
    }
}

}

extern "C" __global__ __aicore__ void batch_matmul_raw_bf16_nt_widen_shortmk(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR scratch, GM_ADDR partial,
    raw_bf16_nt_widen_shortmk::Plan plan)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
    raw_bf16_nt_widen_shortmk::Run<false>(
        x1, x2, y, scratch, partial, plan);
}
extern "C" __global__ __aicore__ void batch_matmul_raw_bf16_nt_widen_shortmk_full_capacity(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR scratch, GM_ADDR partial,
    uint32_t extent)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
    raw_bf16_nt_widen_shortmk::Plan plan{};
    plan.batch=1U;
    plan.m=raw_bf16_nt_widen_shortmk::TILE_WIDTH;
    plan.n=extent;
    plan.k=raw_bf16_nt_widen_shortmk::TILE_K;
    plan.stripeRows=raw_bf16_nt_widen_shortmk::STRIPE_ROW_CAP;
    plan.stripesPerBatch=extent/raw_bf16_nt_widen_shortmk::STRIPE_ROW_CAP;
    plan.workItems=plan.stripesPerBatch;
    plan.blockDim=GetBlockNum();
    plan.scratchElements=uint64_t(plan.blockDim)*raw_bf16_nt_widen_shortmk::STRIPE_ROW_CAP*raw_bf16_nt_widen_shortmk::TILE_WIDTH;
    plan.partialElements=uint64_t(plan.workItems)*raw_bf16_nt_widen_shortmk::TILE_WIDTH;
    plan.ubBytes=raw_bf16_nt_widen_shortmk::STRIPE_ROW_CAP*raw_bf16_nt_widen_shortmk::TILE_WIDTH*sizeof(float)+3U*raw_bf16_nt_widen_shortmk::TILE_WIDTH*sizeof(float)+32U;

    raw_bf16_nt_widen_shortmk::Run<true>(
        x1, x2, y, scratch, partial, plan);
}

inline bool GenerateRawBf16NtWideShortMkPlan(
    platform_ascendc::PlatformAscendC *platform, uint32_t batch,
    uint32_t m, uint32_t n, uint32_t k, int64_t availableCoreNum,
    raw_bf16_nt_widen_shortmk::Plan &plan)
{
    using namespace raw_bf16_nt_widen_shortmk;
    if (platform == nullptr || availableCoreNum <= 0 || batch == 0 ||
        m == 0 || m > SHORT_M_CAP || m % CUBE_ALIGN != 0 ||
        n < MIN_WIDE_N || n % CUBE_ALIGN != 0 ||
        k < MIN_K_BLOCKS * CUBE_ALIGN || k > SHORT_K_CAP ||
        k % CUBE_ALIGN != 0) {
        return false;
    }

    const uint64_t useful = std::min<uint64_t>(n, STRIPE_ROW_CAP) * m * k;
    if (useful * 4U < uint64_t(STRIPE_ROW_CAP) * TILE_WIDTH * TILE_K) return false;

    const uint64_t hardware = std::min<uint64_t>(
        platform->GetCoreNumAic(), platform->GetCoreNumAiv());
    const uint64_t coreLimit64 = std::min<uint64_t>(
        static_cast<uint64_t>(availableCoreNum), hardware);
    if (coreLimit64 == 0 || coreLimit64 > UINT32_MAX) return false;

    uint64_t l1 = 0;
    uint64_t l0a = 0;
    uint64_t l0b = 0;
    uint64_t l0c = 0;
    uint64_t ub = 0;
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1, l1);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A, l0a);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B, l0b);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C, l0c);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ub);

    const uint64_t residentBytes =
        static_cast<uint64_t>(TILE_WIDTH) * TILE_K * sizeof(bfloat16_t);
    const uint64_t l0aBytes = residentBytes;
    const uint64_t l0bBytes = uint64_t(MICRO_N) * TILE_K * sizeof(bfloat16_t);
    const uint64_t l0cBytes =
        static_cast<uint64_t>(STRIPE_ROW_CAP) * TILE_WIDTH * sizeof(float);
    if (uint64_t(STRIPE_ROW_CAP) * TILE_K * sizeof(bfloat16_t) + residentBytes > l1 || l0aBytes > l0a ||
        l0bBytes > l0b || l0cBytes > l0c || ub <= 32) {
        return false;
    }

    const uint64_t stripeRows = STRIPE_ROW_CAP;
    const uint64_t stripesPerBatch =
        (static_cast<uint64_t>(n) + stripeRows - 1U) / stripeRows;
    const uint64_t workItems =
        static_cast<uint64_t>(batch) * stripesPerBatch;
    const uint64_t blockDim = std::min(coreLimit64, workItems);
    const uint64_t scratchElements =
        blockDim * stripeRows * TILE_WIDTH;
    const uint64_t partialElements = workItems * TILE_WIDTH;
    const uint64_t ubBytes = stripeRows * TILE_WIDTH * sizeof(float) + 3U * TILE_WIDTH * sizeof(float) + 32U;
    if (stripeRows > UINT32_MAX || stripesPerBatch > UINT32_MAX ||
        stripesPerBatch > MAX_FINAL_STRIPES ||
        stripesPerBatch > stripeRows || workItems == 0 ||
        workItems > UINT32_MAX || blockDim == 0 ||
        blockDim > UINT32_MAX || ubBytes > ub || ubBytes > UINT32_MAX ||
        scratchElements > SIZE_MAX / sizeof(float) ||
        partialElements > SIZE_MAX / sizeof(float)) {
        return false;
    }

    plan.batch = batch;
    plan.m = m;
    plan.n = n;
    plan.k = k;
    plan.stripeRows = static_cast<uint32_t>(stripeRows);
    plan.stripesPerBatch = static_cast<uint32_t>(stripesPerBatch);
    plan.workItems = static_cast<uint32_t>(workItems);
    plan.blockDim = static_cast<uint32_t>(blockDim);
    plan.ubBytes = static_cast<uint32_t>(ubBytes);
    plan.scratchElements = scratchElements;
    plan.partialElements = partialElements;
    return true;
}

inline bool TryRunRawBf16NtWideShortMk(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y, uint32_t batch,
    uint32_t m, uint32_t n, uint32_t k, int32_t dtype,
    int64_t availableCoreNum, aclrtStream stream, bool transposeX1,
    bool transposeX2)
{
    if (dtype != 2 || transposeX1 || !transposeX2) return false;
    raw_bf16_nt_widen_shortmk::Plan plan{};
    if (!GenerateRawBf16NtWideShortMkPlan(
            platform_ascendc::PlatformAscendCManager::GetInstance(),
            batch, m, n, k, availableCoreNum, plan)) {
        return false;
    }

    const bool full = batch == 1U && k == raw_bf16_nt_widen_shortmk::TILE_K &&
        m == raw_bf16_nt_widen_shortmk::TILE_WIDTH &&
        n % raw_bf16_nt_widen_shortmk::STRIPE_ROW_CAP == 0U;
    uint8_t *scratch = nullptr;
    uint8_t *partial = nullptr;
    if (aclrtMalloc(reinterpret_cast<void **>(&scratch),
            static_cast<size_t>(plan.scratchElements) * sizeof(float),
            ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS ||
        aclrtMalloc(reinterpret_cast<void **>(&partial),
            static_cast<size_t>(plan.partialElements) * sizeof(float),
            ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        if (scratch != nullptr) aclrtFree(scratch);
        if (partial != nullptr) aclrtFree(partial);
        return false;
    }
    if (full) {
batch_matmul_raw_bf16_nt_widen_shortmk_full_capacity<<<
        plan.blockDim, nullptr, stream>>>(
            x1, x2, y, scratch, partial, n);
    } else {
batch_matmul_raw_bf16_nt_widen_shortmk<<<
        plan.blockDim, nullptr, stream>>>(
            x1, x2, y, scratch, partial, plan);
    }
    const aclError result = aclrtSynchronizeStream(stream);
    aclrtFree(scratch);
    aclrtFree(partial);
    if (result != ACL_SUCCESS) {
        throw std::runtime_error(
            "BF16 NT wide-N short-MK Raw device execution failed");
    }
    return true;
}


// FP16 NT streaming family for aligned medium/large matrices.  All whole-input
// geometry, task ownership and workspace offsets are derived from runtime
// metadata.  Constants below describe only the reusable on-chip tile class.
namespace raw_nt_stream128 {

constexpr uint32_t TM = 128;
constexpr uint32_t TN = 128;
constexpr uint32_t BK = 128;
constexpr uint32_t B_PAGE_K = 2 * BK;
constexpr uint32_t TILE = TM * TN;
constexpr uint32_t A_L0_SLOT = TM * BK;
constexpr uint32_t B_L1_SLOT = TN * B_PAGE_K;
constexpr uint32_t MAX_GROUPS = 20;
constexpr uint32_t INPUT_BYTES = TILE * sizeof(float);
constexpr uint32_t WORK_BYTES = 32768;
constexpr uint32_t ROW_BYTES = TM * sizeof(float);
constexpr uint32_t UB_BYTES = INPUT_BYTES + WORK_BYTES + 2 * ROW_BYTES;
constexpr uint64_t B_L1_BYTES = 2ULL * B_L1_SLOT * sizeof(half);
constexpr uint64_t L0A_BYTES = 2ULL * A_L0_SLOT * sizeof(half);
constexpr uint64_t L0B_BYTES = 2ULL * TN * BK * sizeof(half);
constexpr uint64_t L0C_BYTES = 2ULL * TILE * sizeof(float);
constexpr uint64_t WORKSPACE_BUDGET_BYTES = 64ULL * 1024 * 1024;
constexpr uint16_t READY = 8;
constexpr uint16_t CONSUMED = 9;
constexpr float LOWEST = -3.402823466e+38f;

struct Plan {
    uint32_t batch;
    uint32_t m;
    uint32_t n;
    uint32_t k;
    uint32_t mBlocks;
    uint32_t nBlocks;
    uint32_t kPages;
    uint32_t workItems;
    uint32_t blockDim;
    uint32_t partialSlotsPerGroup;
    uint32_t contributorSlots;
    uint64_t partialElements;
    uint16_t scratchPrefix[MAX_GROUPS + 1];
};
static_assert(sizeof(Plan) <= 128,
    "Direct launch metadata capacity for dynamic streaming plan");
static_assert(B_L1_BYTES == 131072 && L0A_BYTES == 65536 &&
    L0B_BYTES == 65536 && L0C_BYTES == 131072 && UB_BYTES == 99328,
    "Streaming tile class must fit the target memory hierarchy");

__aicore__ inline uint32_t GroupFirst(uint32_t group, const Plan &d)
{
    return static_cast<uint32_t>(
        static_cast<uint64_t>(group) * d.workItems / d.blockDim);
}

__aicore__ inline uint32_t GroupLast(uint32_t group, const Plan &d)
{
    return static_cast<uint32_t>(
        static_cast<uint64_t>(group + 1U) * d.workItems / d.blockDim);
}

__aicore__ inline uint32_t RowFirstTask(uint32_t row, const Plan &d)
{
    return row * d.nBlocks;
}

__aicore__ inline uint32_t GroupFirstRow(uint32_t group, const Plan &d)
{
    return GroupFirst(group, d) / d.nBlocks;
}

__aicore__ inline void StoreRows(GlobalTensor<float> partial,LocalTensor<float> row,
    uint32_t logicalRow,uint32_t group,const Plan &d,TEventID ready,TEventID done) {
    const uint32_t firstTask=logicalRow*d.nBlocks,lastTask=(logicalRow+1U)*d.nBlocks;
    const uint32_t g0=(uint64_t(firstTask+1U)*d.blockDim-1U)/d.workItems;
    const uint32_t g1=(uint64_t(lastTask)*d.blockDim-1U)/d.workItems;
    const uint64_t stride=uint64_t(d.batch)*d.m,base=uint64_t(logicalRow)*TM;
    SetFlag<HardEvent::V_MTE3>(ready);WaitFlag<HardEvent::V_MTE3>(ready);
    DataCopy(partial[base+uint64_t(group-g0)*stride],row,TM);
    SetFlag<HardEvent::MTE3_V>(done);WaitFlag<HardEvent::MTE3_V>(done);
    if(group==g0&&g1-g0+1U<d.contributorSlots) {
        Duplicate(row,LOWEST,TM);PipeBarrier<PIPE_V>();
        for(uint32_t p=g1-g0+1U;p<d.contributorSlots;++p) {
            SetFlag<HardEvent::V_MTE3>(ready);WaitFlag<HardEvent::V_MTE3>(ready);
            DataCopy(partial[base+uint64_t(p)*stride],row,TM);
            SetFlag<HardEvent::MTE3_V>(done);WaitFlag<HardEvent::MTE3_V>(done);
        }
    }
}

__aicore__ inline void Run(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    GM_ADDR scratchGm, GM_ADDR partialGm, const Plan &d)
{
    const uint32_t group = GetBlockIdx();
    const uint32_t first = GroupFirst(group, d);
    const uint32_t last = GroupLast(group, d);
    const uint32_t firstRow = first / d.nBlocks;
    const uint32_t lastRow = (last - 1U) / d.nBlocks;
    const uint32_t chunks = 2U * d.kPages;
    const uint64_t scratchElements =
        static_cast<uint64_t>(d.scratchPrefix[d.blockDim]) * TILE;
    const uint64_t partialElements =
        d.partialElements;
    const uint64_t scratchOffset =
        static_cast<uint64_t>(d.scratchPrefix[group]) * TILE;
    TPipe pipe;
    GlobalTensor<float> scratch;
    scratch.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(scratchGm),
        scratchElements);

    if ASCEND_IS_AIC {
        SetMMRowMajor();
        GlobalTensor<half> lhs;
        GlobalTensor<half> rhs;
        lhs.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(x1),
            static_cast<uint64_t>(d.batch) * d.m * d.k);
        rhs.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(x2),
            static_cast<uint64_t>(d.batch) * d.n * d.k);

        TBuf<TPosition::A1> a1Buffer;
        TBuf<TPosition::B1> b1Buffer;
        TBuf<TPosition::A2> a2Buffer;
        TBuf<TPosition::B2> b2Buffer;
        TBuf<TPosition::CO1> cBuffer;
        pipe.InitBuffer(a1Buffer,
            static_cast<uint64_t>(TM) * d.k * sizeof(half));
        pipe.InitBuffer(b1Buffer, B_L1_BYTES);
        pipe.InitBuffer(a2Buffer, L0A_BYTES);
        pipe.InitBuffer(b2Buffer, L0B_BYTES);
        pipe.InitBuffer(cBuffer, L0C_BYTES);
        auto a1 = a1Buffer.Get<half>();
        auto b1 = b1Buffer.Get<half>();
        auto a2 = a2Buffer.Get<half>();
        auto b2 = b2Buffer.Get<half>();
        auto c = cBuffer.Get<float>();

        const TEventID operandConsumed[2] = {
            pipe.AllocEventID<HardEvent::M_MTE1>(),
            pipe.AllocEventID<HardEvent::M_MTE1>()};
        const TEventID cacheReady[2] = {
            pipe.AllocEventID<HardEvent::MTE2_MTE1>(),
            pipe.AllocEventID<HardEvent::MTE2_MTE1>()};
        const TEventID cacheReusable[2] = {
            pipe.AllocEventID<HardEvent::MTE1_MTE2>(),
            pipe.AllocEventID<HardEvent::MTE1_MTE2>()};
        const TEventID cReusable[2] = {
            pipe.AllocEventID<HardEvent::FIX_M>(),
            pipe.AllocEventID<HardEvent::FIX_M>()};
        const auto a1Reusable =
            pipe.AllocEventID<HardEvent::MTE1_MTE2>();
        const auto operandsReady = pipe.FetchEventID(HardEvent::MTE1_M);
        const auto cReady = pipe.FetchEventID(HardEvent::M_FIX);
        const uint8_t padding[4] = {0, 0, 0, 0};
        SetFmatrix(1, TM, padding, FmatrixMode::FMATRIX_LEFT);
        SetLoadDataRepeat(LoadDataRepeatParam{0, 1, 0});
        SetLoadDataBoundary(0);
        SetLoadDataPaddingValue<half>(half(0.0f));

        for (uint32_t logicalRow = firstRow;
             logicalRow <= lastRow; ++logicalRow) {
            if (logicalRow != firstRow) {
                WaitFlag<HardEvent::MTE1_MTE2>(a1Reusable);
            }
            const uint32_t batch = logicalRow / d.mBlocks;
            const uint32_t mb = logicalRow - batch * d.mBlocks;
            const uint32_t rowTask = RowFirstTask(logicalRow, d);
            const uint32_t begin = first > rowTask ? first - rowTask : 0;
            const uint32_t rowEnd = rowTask + d.nBlocks;
            const uint32_t end = last < rowEnd ? last - rowTask : d.nBlocks;
            const uint64_t aOffset =
                (static_cast<uint64_t>(batch) * d.m +
                 static_cast<uint64_t>(mb) * TM) * d.k;
            DataCopy(a1, lhs[aOffset], Nd2NzParams{1, TM,
                B_PAGE_K, 0,static_cast<uint16_t>(d.k), TM, 1, 0});

            for (uint32_t nb = begin; nb < end; ++nb) {
                const uint32_t task = rowTask + nb;
                const uint32_t taskLocal = task - first;
                const uint32_t firstBank = (taskLocal * d.kPages) & 1U;
                const uint32_t firstN = nb * TN;
                const uint64_t bBatchOffset =
                    static_cast<uint64_t>(batch) * d.n * d.k;
                if (nb == begin) {
                    if (task != first) {
                        WaitFlag<HardEvent::MTE1_MTE2>(
                            cacheReusable[firstBank]);
                    }
                    DataCopy(b1[firstBank * B_L1_SLOT],
                        rhs[bBatchOffset + static_cast<uint64_t>(firstN) * d.k],
                        Nd2NzParams{1, TN, B_PAGE_K, 0,
                            static_cast<uint16_t>(d.k), TN, 1, 0});
                    SetFlag<HardEvent::MTE2_MTE1>(cacheReady[firstBank]);
                }

                for (uint32_t page = 0; page < d.kPages; ++page) {
                    const uint32_t bank = (page + firstBank) & 1U;
                    WaitFlag<HardEvent::MTE2_MTE1>(cacheReady[bank]);
                    if (page + 1U < d.kPages) {
                        const uint32_t next = bank ^ 1U;
                        if (page != 0 || task != first) {
                            WaitFlag<HardEvent::MTE1_MTE2>(
                                cacheReusable[next]);
                        }
                        if(nb==begin) {
                            const uint32_t ak=(page+1U)*B_PAGE_K;
                            DataCopy(a1[uint64_t(ak)*TM],lhs[aOffset+ak],
                                Nd2NzParams{1,TM,B_PAGE_K,0,
                                    static_cast<uint16_t>(d.k),TM,1,0});
                        }
                        DataCopy(b1[next * B_L1_SLOT],
                            rhs[bBatchOffset +
                                static_cast<uint64_t>(firstN) * d.k +
                                static_cast<uint64_t>(page + 1U) * B_PAGE_K],
                            Nd2NzParams{1, TN, B_PAGE_K, 0,
                                static_cast<uint16_t>(d.k), TN, 1, 0});
                        SetFlag<HardEvent::MTE2_MTE1>(cacheReady[next]);
                    } else if (nb + 1U < end) {
                        const uint32_t next = bank ^ 1U;
                        WaitFlag<HardEvent::MTE1_MTE2>(cacheReusable[next]);
                        DataCopy(b1[next * B_L1_SLOT],
                            rhs[bBatchOffset +
                                static_cast<uint64_t>(firstN + TN) * d.k],
                            Nd2NzParams{1, TN, B_PAGE_K, 0,
                                static_cast<uint16_t>(d.k), TN, 1, 0});
                        SetFlag<HardEvent::MTE2_MTE1>(cacheReady[next]);
                    }

#pragma unroll
                    for (uint32_t sub = 0; sub < 2; ++sub) {
                        const uint32_t chunk = 2U * page + sub;
                        const uint32_t slot = chunk & 1U;
                        const uint32_t firstK = chunk * BK;
                        if (chunk >= 2U || task != first) {
                            WaitFlag<HardEvent::M_MTE1>(
                                operandConsumed[slot]);
                        }
                        LoadData3DParamsV2Pro loadA;
                        loadA.channelSize = d.k;
                        loadA.enTranspose = false;
                        loadA.extConfig =
                            (static_cast<uint64_t>(firstK) << 32) |
                            (static_cast<uint64_t>(TM) << 16) | BK;
                        LoadData(a2[slot * A_L0_SLOT], a1, loadA);
                        const LoadData2DParams loadB{
                            0, 64, 1, 0, 0, false, 0};
                        LoadData(b2[slot * TILE],
                            b1[bank * B_L1_SLOT + sub * TILE], loadB);
                        SetFlag<HardEvent::MTE1_M>(operandsReady);
                        WaitFlag<HardEvent::MTE1_M>(operandsReady);
                        const uint32_t cSlot = taskLocal & 1U;
                        Mmad(c[cSlot * TILE], a2[slot * A_L0_SLOT],
                            b2[slot * TILE], MmadParams{TM, TN, BK,
                                uint8_t(chunk+1U==chunks?3:2), false, chunk == 0});
                        SetFlag<HardEvent::M_MTE1>(operandConsumed[slot]);
                        if (sub == 1U) {
                            SetFlag<HardEvent::MTE1_MTE2>(
                                cacheReusable[bank]);
                        }
                    }
                }

                if (nb == begin && logicalRow != firstRow) {
                    CrossCoreWaitFlag(CONSUMED);
                }
                const uint64_t tileOffset = scratchOffset +
                    static_cast<uint64_t>(nb - begin) * TILE;
                const uint32_t cSlot = taskLocal & 1U;
                FixpipeParamsV220 fix{};
                fix.nSize = TN;
                fix.mSize = TM;
                fix.srcStride = TM;
                fix.dstStride = TN;
                fix.ndNum = 1;fix.unitFlag=3;
                Fixpipe<float, float, CFG_ROW_MAJOR>(
                    scratch[tileOffset], c[cSlot * TILE], fix);
                if(taskLocal+2U>=last-first)SetFlag<HardEvent::FIX_M>(cReusable[cSlot]);
                CrossCoreSetFlag<2, PIPE_FIX>(READY);
            }
            SetFlag<HardEvent::MTE1_MTE2>(a1Reusable);
        }
        CrossCoreWaitFlag(CONSUMED);
        WaitFlag<HardEvent::MTE1_MTE2>(a1Reusable);
        pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(a1Reusable);
        const uint32_t usedCSlots = last - first < 2U ? last - first : 2U;
        for (uint32_t slot = 0; slot < 2; ++slot) {
            WaitFlag<HardEvent::M_MTE1>(operandConsumed[slot]);
            WaitFlag<HardEvent::MTE1_MTE2>(cacheReusable[slot]);
            if (slot < usedCSlots) {
                WaitFlag<HardEvent::FIX_M>(cReusable[slot]);
            }
            pipe.ReleaseEventID<HardEvent::M_MTE1>(
                operandConsumed[slot]);
            pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(cacheReady[slot]);
            pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(
                cacheReusable[slot]);
            pipe.ReleaseEventID<HardEvent::FIX_M>(cReusable[slot]);
        }
    }

    if ASCEND_IS_AIV {
        TBuf<TPosition::VECCALC> storage;
        pipe.InitBuffer(storage, UB_BYTES);
        auto input = storage.GetWithOffset<float>(TILE, 0);
        auto work = storage.GetWithOffset<uint8_t>(WORK_BYTES, INPUT_BYTES);
        auto maxima = storage.GetWithOffset<float>(TM,
            INPUT_BYTES + WORK_BYTES);
        auto row = storage.GetWithOffset<float>(TM,
            INPUT_BYTES + WORK_BYTES + ROW_BYTES);
        GlobalTensor<float> partial;
        GlobalTensor<float> output;
        partial.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(partialGm),
            partialElements);
        output.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y), d.batch);
        const auto inputReusable = pipe.FetchEventID(HardEvent::V_MTE2);
        const auto inputReady = pipe.FetchEventID(HardEvent::MTE2_V);
        const auto rowsReady = pipe.FetchEventID(HardEvent::V_MTE3);
        const auto storeDone = pipe.FetchEventID(HardEvent::MTE3_V);
        uint32_t reduceShape[2] = {TM, TN};
        uint32_t currentRow = firstRow;
        Duplicate(row, LOWEST, TM);
        PipeBarrier<PIPE_V>();
        for (uint32_t task = first; task < last; ++task) {
            CrossCoreWaitFlag(READY);
            SetFlag<HardEvent::V_MTE2>(inputReusable);
            WaitFlag<HardEvent::V_MTE2>(inputReusable);
            const uint32_t logicalRow = task / d.nBlocks;
            const uint32_t rowTask = RowFirstTask(logicalRow, d);
            const uint32_t begin = first > rowTask ? first - rowTask : 0;
            const uint32_t nb = task - rowTask;
            const uint64_t tileOffset = scratchOffset +
                static_cast<uint64_t>(nb - begin) * TILE;
            DataCopy(input, scratch[tileOffset], TILE);
            SetFlag<HardEvent::MTE2_V>(inputReady);
            WaitFlag<HardEvent::MTE2_V>(inputReady);
            const uint32_t rowEnd = rowTask + d.nBlocks;
            const uint32_t end = last < rowEnd ? last - rowTask : d.nBlocks;
            if (nb + 1U == end) {
                CrossCoreSetFlag<2, PIPE_MTE2>(CONSUMED);
            }
            if (logicalRow != currentRow) {
                StoreRows(partial,row,currentRow,group,d,rowsReady,storeDone);
                Duplicate(row, LOWEST, TM);
                PipeBarrier<PIPE_V>();
                currentRow = logicalRow;
            }
            ReduceMax<float, Pattern::Reduce::AR>(
                maxima, input, work, reduceShape, true);
            PipeBarrier<PIPE_V>();
            Max(row, row, maxima, TM);
            PipeBarrier<PIPE_V>();
        }
        StoreRows(partial,row,currentRow,group,d,rowsReady,storeDone);

        SyncAll<true>();
        if (group == 0) {
            const uint32_t partialCount =
                static_cast<uint32_t>(d.partialElements);
            const uint32_t mergedBase = partialCount;
            SetFlag<HardEvent::V_MTE2>(inputReusable);
            WaitFlag<HardEvent::V_MTE2>(inputReusable);
            DataCopy(input, partial, partialCount);
            SetFlag<HardEvent::MTE2_V>(inputReady);
            WaitFlag<HardEvent::MTE2_V>(inputReady);
            const uint32_t logicalRows = d.batch * d.mBlocks;
            const uint32_t stride=logicalRows*TM;
            if(d.contributorSlots==1) {DataCopy(input[mergedBase],input,stride);PipeBarrier<PIPE_V>();}
            else {
                Max(input[mergedBase],input,input[stride],stride);PipeBarrier<PIPE_V>();
                for(uint32_t p=2;p<d.contributorSlots;++p) {
                    Max(input[mergedBase],input[mergedBase],input[p*stride],stride);PipeBarrier<PIPE_V>();
                }
            }
            for (uint32_t batch = 0; batch < d.batch; ++batch) {
                uint32_t sumShape[2] = {1, d.m};
                ReduceSum<float, Pattern::Reduce::AR>(maxima,
                    input[mergedBase + batch * d.m], work, sumShape, true);
                SetFlag<HardEvent::V_MTE3>(rowsReady);
                WaitFlag<HardEvent::V_MTE3>(rowsReady);
                DataCopyPad(output[batch], maxima,
                    DataCopyExtParams{1, sizeof(float), 0, 0, 0});
                SetFlag<HardEvent::MTE3_V>(storeDone);
                WaitFlag<HardEvent::MTE3_V>(storeDone);
            }
        }
    }
}
}  

extern "C" __global__ __aicore__ void batch_matmul_raw_nt_stream128_fp16(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR scratch, GM_ADDR partial,
    raw_nt_stream128::Plan plan)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
    raw_nt_stream128::Run(x1, x2, y, scratch, partial, plan);
}

inline uint32_t RawNtStreamGroupRows(uint32_t group, uint32_t workItems,
    uint32_t blockDim, uint32_t nBlocks)
{
    const uint32_t first = static_cast<uint32_t>(
        static_cast<uint64_t>(group) * workItems / blockDim);
    const uint32_t last = static_cast<uint32_t>(
        static_cast<uint64_t>(group + 1U) * workItems / blockDim);
    return (last - 1U) / nBlocks - first / nBlocks + 1U;
}

inline uint32_t RawNtStreamGroupScratchSlots(uint32_t group,
    uint32_t workItems, uint32_t blockDim, uint32_t nBlocks)
{
    const uint32_t first = static_cast<uint32_t>(
        static_cast<uint64_t>(group) * workItems / blockDim);
    const uint32_t last = static_cast<uint32_t>(
        static_cast<uint64_t>(group + 1U) * workItems / blockDim);
    const uint32_t firstRow = first / nBlocks;
    const uint32_t lastRow = (last - 1U) / nBlocks;
    if (firstRow == lastRow) return last - first;
    const uint32_t left = nBlocks - first % nBlocks;
    const uint32_t right = (last - 1U) % nBlocks + 1U;
    if (lastRow > firstRow + 1U) return nBlocks;
    return std::max(left, right);
}

inline bool GenerateRawNtStream128Plan(
    platform_ascendc::PlatformAscendC *platform, uint32_t batch,
    uint32_t m, uint32_t n, uint32_t k, int64_t cores,
    raw_nt_stream128::Plan &d)
{
    using namespace raw_nt_stream128;
    if (platform == nullptr || cores <= 0 || batch == 0 ||
        m < TM || n < TN || k < 4U * BK ||
        m % TM != 0 || n % TN != 0 || k % B_PAGE_K != 0 ||
        m > UINT16_MAX || n > UINT16_MAX || k > UINT16_MAX) {
        return false;
    }
    const uint64_t hardware = std::min<uint64_t>(
        platform->GetCoreNumAic(), platform->GetCoreNumAiv());
    const uint64_t mBlocks = m / TM;
    const uint64_t nBlocks = n / TN;
    const uint64_t workItems = static_cast<uint64_t>(batch) *
        mBlocks * nBlocks;
    const uint64_t blockDim = std::min<uint64_t>(MAX_GROUPS,
        std::min<uint64_t>(hardware,
            std::min<uint64_t>(static_cast<uint64_t>(cores), workItems)));
    if (workItems == 0 || workItems > UINT32_MAX || blockDim == 0) {
        return false;
    }

    uint64_t l1 = 0, l0a = 0, l0b = 0, l0c = 0, ub = 0;
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1, l1);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A, l0a);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B, l0b);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C, l0c);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ub);
    const uint64_t aL1Bytes =
        static_cast<uint64_t>(TM) * k * sizeof(half);
    if (aL1Bytes + B_L1_BYTES > l1 || L0A_BYTES > l0a ||
        L0B_BYTES > l0b || L0C_BYTES > l0c || UB_BYTES > ub) {
        return false;
    }

    d.batch = batch;
    d.m = m;
    d.n = n;
    d.k = k;
    d.mBlocks = static_cast<uint32_t>(mBlocks);
    d.nBlocks = static_cast<uint32_t>(nBlocks);
    d.kPages = k / B_PAGE_K;
    d.workItems = static_cast<uint32_t>(workItems);
    d.blockDim = static_cast<uint32_t>(blockDim);
    uint64_t scratchSlots = 0;
    uint32_t partialSlots = 0;
    for (uint32_t group = 0; group < d.blockDim; ++group) {
        if (scratchSlots > UINT16_MAX) return false;
        d.scratchPrefix[group] = static_cast<uint16_t>(scratchSlots);
        scratchSlots += RawNtStreamGroupScratchSlots(group,
            d.workItems, d.blockDim, d.nBlocks);
        partialSlots = std::max(partialSlots, RawNtStreamGroupRows(group,
            d.workItems, d.blockDim, d.nBlocks));
    }
    if (scratchSlots > UINT16_MAX) return false;
    d.scratchPrefix[d.blockDim] = static_cast<uint16_t>(scratchSlots);
    for (uint32_t group = d.blockDim + 1U;
         group <= MAX_GROUPS; ++group) {
        d.scratchPrefix[group] = d.scratchPrefix[d.blockDim];
    }
    d.partialSlotsPerGroup = partialSlots;

    const uint64_t scratchBytes = scratchSlots * TILE * sizeof(float);
    uint32_t contributors=1;
    for(uint64_t row=0;row<uint64_t(batch)*mBlocks;++row) {
        const uint64_t firstTask=row*nBlocks,lastTask=(row+1)*nBlocks;
        const uint32_t g0=((firstTask+1)*blockDim-1)/workItems;
        const uint32_t g1=(lastTask*blockDim-1)/workItems;
        contributors=std::max(contributors,g1-g0+1U);
    }
    d.contributorSlots=contributors;
    const uint64_t partialElements=uint64_t(batch)*m*contributors;
    d.partialElements=partialElements;
    const uint64_t mergedElements =
        static_cast<uint64_t>(batch) * m;
    if (scratchBytes == 0 || scratchBytes > WORKSPACE_BUDGET_BYTES ||
        partialSlots == 0 || partialElements + mergedElements > TILE ||
        partialElements > SIZE_MAX / sizeof(float)) {
        return false;
    }
    uint32_t high = 0, low = 0;
    AscendC::GetReduceMaxMaxMinTmpSize(ge::Shape({TM, TN}),
        ge::DT_FLOAT, AscendC::ReducePattern::AR, true, false, high, low);
    if (high > WORK_BYTES || low > WORK_BYTES) return false;
    AscendC::GetReduceSumMaxMinTmpSize(ge::Shape({1, m}),
        ge::DT_FLOAT, AscendC::ReducePattern::AR, true, false, high, low);
    return high <= WORK_BYTES && low <= WORK_BYTES;
}

inline bool TryRunRawNtStream128(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    uint32_t batch, uint32_t m, uint32_t n, uint32_t k, int32_t dtype,
    int64_t cores, aclrtStream stream, bool transposeX1, bool transposeX2)
{
    if (dtype != 1 || transposeX1 || !transposeX2) return false;
    raw_nt_stream128::Plan d{};
    if (!GenerateRawNtStream128Plan(
            platform_ascendc::PlatformAscendCManager::GetInstance(),
            batch, m, n, k, cores, d)) {
        return false;
    }
    const size_t scratchBytes = static_cast<size_t>(
        d.scratchPrefix[d.blockDim]) * raw_nt_stream128::TILE *
        sizeof(float);
    const size_t partialBytes=static_cast<size_t>(d.partialElements)*sizeof(float);
    uint8_t *scratch = nullptr;
    uint8_t *partial = nullptr;
    if (aclrtMalloc(reinterpret_cast<void **>(&scratch), scratchBytes,
            ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS ||
        aclrtMalloc(reinterpret_cast<void **>(&partial), partialBytes,
            ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        if (scratch != nullptr) aclrtFree(scratch);
        if (partial != nullptr) aclrtFree(partial);
        return false;
    }
batch_matmul_raw_nt_stream128_fp16<<<d.blockDim, nullptr, stream>>>(
        x1, x2, y, scratch, partial, d);
    const aclError result = aclrtSynchronizeStream(stream);
    aclrtFree(scratch);
    aclrtFree(partial);
    if (result != ACL_SUCCESS) {
        throw std::runtime_error("FP16 NT streaming family execution failed");
    }
    return true;
}


// BF16 NN family with full-A stripes, N128/K64 cross-N streaming and a
// runtime-length full-M ReduceSum reduction.
namespace raw_bf16_nn_crossn_reduce {

constexpr uint32_t ALIGN = 16;
constexpr uint32_t TILE_N = 128;
constexpr uint32_t STEP_K = 64;
constexpr uint32_t MIN_K_STEPS = 16;
constexpr uint32_t B_SLOTS = 2;
constexpr uint32_t WORK_BYTES = 32768;
constexpr uint16_t READY = 8;
constexpr uint16_t CONSUMED = 9;
constexpr float LOWEST = -3.402823466e+38f;

struct Plan {
    uint32_t batch, m, n, k;
    uint32_t stripeCapacity, stripesPerBatch, workItems, blockDim;
    uint32_t nTiles, kSteps, inputBytes;
    uint64_t scratchElements, partialElements;
};
static_assert(sizeof(Plan) <= 80, "Direct launch metadata capacity");

__aicore__ inline uint32_t MinU32(uint32_t a, uint32_t b) {
    return a < b ? a : b;
}
__aicore__ inline uint32_t TaskBatch(uint32_t task, const Plan &d) {
    return task / d.stripesPerBatch;
}
__aicore__ inline uint32_t TaskStripe(uint32_t task, const Plan &d) {
    return task % d.stripesPerBatch;
}
__aicore__ inline uint32_t TaskRows(uint32_t task, const Plan &d) {
    const uint32_t q = TaskStripe(task, d);
    const uint32_t base = d.m / ALIGN / d.stripesPerBatch;
    const uint32_t extra = d.m / ALIGN % d.stripesPerBatch;
    return (base + (q < extra ? 1U : 0U)) * ALIGN;
}
__aicore__ inline uint32_t TaskFirstM(uint32_t task, const Plan &d) {
    const uint32_t q = TaskStripe(task, d);
    const uint32_t base = d.m / ALIGN / d.stripesPerBatch;
    const uint32_t extra = d.m / ALIGN % d.stripesPerBatch;
    return (q * base + MinU32(q, extra)) * ALIGN;
}

__aicore__ inline void Run(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    GM_ADDR scratchGm, GM_ADDR partialGm, const Plan &d)
{
    const uint32_t group = GetBlockIdx();
    const uint64_t scratchOffset =
        2ULL * group * d.stripeCapacity * TILE_N;
    TPipe pipe;
    GlobalTensor<float> scratch;
    scratch.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(scratchGm),
        d.scratchElements);

    if ASCEND_IS_AIC {
        GlobalTensor<bfloat16_t> lhs, rhs;
        lhs.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(x1),
            uint64_t(d.batch) * d.m * d.k);
        rhs.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(x2),
            uint64_t(d.batch) * d.k * d.n);
        TBuf<TPosition::A1> a1Buf; TBuf<TPosition::B1> b1Buf;
        TBuf<TPosition::A2> a2Buf; TBuf<TPosition::B2> b2Buf;
        TBuf<TPosition::CO1> cBuf;
        const uint32_t bPageElements = STEP_K * TILE_N;
        const uint32_t aSlotElements = d.stripeCapacity * STEP_K;
        pipe.InitBuffer(a1Buf, uint64_t(d.stripeCapacity) * d.k * 2);
        pipe.InitBuffer(b1Buf, uint64_t(B_SLOTS) * bPageElements * 2);
        pipe.InitBuffer(a2Buf, uint64_t(B_SLOTS) * aSlotElements * 2);
        pipe.InitBuffer(b2Buf, uint64_t(B_SLOTS) * bPageElements * 2);
        pipe.InitBuffer(cBuf, uint64_t(d.stripeCapacity) * TILE_N * 4);
        auto a1=a1Buf.Get<bfloat16_t>(); auto b1=b1Buf.Get<bfloat16_t>();
        auto a2=a2Buf.Get<bfloat16_t>(); auto b2=b2Buf.Get<bfloat16_t>();
        auto c=cBuf.Get<float>();
        TEventID bReady[B_SLOTS],bFree[B_SLOTS],used[B_SLOTS],ready[B_SLOTS];
        for(uint32_t i=0;i<B_SLOTS;++i) {
            bReady[i]=pipe.AllocEventID<HardEvent::MTE2_MTE1>();
            bFree[i]=pipe.AllocEventID<HardEvent::MTE1_MTE2>();
            used[i]=pipe.AllocEventID<HardEvent::M_MTE1>();
            ready[i]=pipe.AllocEventID<HardEvent::MTE1_M>();
        }
        const auto cReady=pipe.FetchEventID(HardEvent::M_FIX);
        const auto cFree=pipe.FetchEventID(HardEvent::FIX_M);
        const uint8_t pads[4]={0,0,0,0};
        SetFmatrix(1,STEP_K,pads,FmatrixMode::FMATRIX_RIGHT);
        SetMMRowMajor();
        SetLoadDataRepeat(LoadDataRepeatParam{0,1,0});
        SetLoadDataBoundary(0);SetLoadDataPaddingValue<half>(half(0));
        LoadData3DParamsV2Pro loadA;
        loadA.channelSize=d.k;loadA.enTranspose=false;loadA.fMatrixCtrl=false;
        LoadData3DParamsV2Pro loadB;
        loadB.channelSize=TILE_N;loadB.enTranspose=false;loadB.fMatrixCtrl=true;
        loadB.extConfig=(uint64_t(STEP_K)<<16)|TILE_N;

        for(uint32_t task=group;task<d.workItems;task+=d.blockDim) {
            const uint32_t batch=TaskBatch(task,d),firstM=TaskFirstM(task,d);
            const uint32_t rows=TaskRows(task,d),total=d.nTiles*d.kSteps;
            const uint32_t rotation=group%d.nTiles;
            const uint64_t aBase=(uint64_t(batch)*d.m+firstM)*d.k;
            const uint64_t bBase=uint64_t(batch)*d.k*d.n;
            SetFmatrix(1,static_cast<uint16_t>(rows),pads,FmatrixMode::FMATRIX_LEFT);
            DataCopy(a1,lhs[aBase],Nd2NzParams{1,static_cast<uint16_t>(rows),
                static_cast<uint16_t>(d.k),0,static_cast<uint16_t>(d.k),
                static_cast<uint16_t>(rows),1,0});
            const uint32_t initial=MinU32(B_SLOTS,total);
            for(uint32_t flat=0;flat<initial;++flat) {
                const uint32_t kt=flat%d.kSteps,nt=(flat/d.kSteps+rotation)%d.nTiles;
                DataCopy(b1[flat*bPageElements],
                    rhs[bBase+uint64_t(kt*STEP_K)*d.n+nt*TILE_N],
                    Nd2NzParams{1,STEP_K,TILE_N,0,static_cast<uint16_t>(d.n),STEP_K,1,0});
                SetFlag<HardEvent::MTE2_MTE1>(bReady[flat]);
            }
            uint32_t ntile=0,chunk=0;
            uint32_t nextChunk=initial%d.kSteps;
            uint32_t nextTile=(initial/d.kSteps+rotation)%d.nTiles;
            for(uint32_t flat=0;flat<total;++flat) {
                const uint32_t slot=flat&1U;
                WaitFlag<HardEvent::MTE2_MTE1>(bReady[slot]);
                if(flat>=B_SLOTS)WaitFlag<HardEvent::M_MTE1>(used[slot]);
                loadA.extConfig=(uint64_t(chunk*STEP_K)<<32)|
                    (uint64_t(rows)<<16)|STEP_K;
                LoadData(a2[slot*aSlotElements],a1,loadA);
                LoadData(b2[slot*bPageElements],b1[slot*bPageElements],loadB);
                SetFlag<HardEvent::MTE1_MTE2>(bFree[slot]);
                SetFlag<HardEvent::MTE1_M>(ready[slot]);WaitFlag<HardEvent::MTE1_M>(ready[slot]);
                Mmad(c,a2[slot*aSlotElements],b2[slot*bPageElements],
                    MmadParams{static_cast<uint16_t>(rows),TILE_N,STEP_K,
                    uint8_t(chunk+1==d.kSteps?3:2),false,chunk==0});
                SetFlag<HardEvent::M_MTE1>(used[slot]);
                WaitFlag<HardEvent::MTE1_MTE2>(bFree[slot]);
                const uint32_t next=flat+B_SLOTS;
                if(next<total) {
                    DataCopy(b1[slot*bPageElements],
                        rhs[bBase+uint64_t(nextChunk*STEP_K)*d.n+nextTile*TILE_N],
                        Nd2NzParams{1,STEP_K,TILE_N,0,static_cast<uint16_t>(d.n),STEP_K,1,0});
                    SetFlag<HardEvent::MTE2_MTE1>(bReady[slot]);
                    ++nextChunk;
                    if(nextChunk==d.kSteps) {
                        nextChunk=0;
                        ++nextTile;
                        if(nextTile==d.nTiles)nextTile=0;
                    }
                }
                if(chunk+1==d.kSteps) {
                    if(ntile>=2)CrossCoreWaitFlag(CONSUMED);
                    FixpipeParamsV220 fix{};fix.nSize=TILE_N;fix.mSize=rows;
                    fix.srcStride=rows;fix.dstStride=TILE_N;fix.ndNum=1;fix.unitFlag=3;
                    Fixpipe<float,float,CFG_ROW_MAJOR>(
                        scratch[scratchOffset+(ntile&1U)*d.stripeCapacity*TILE_N],c,fix);
                    if(ntile+1==d.nTiles)SetFlag<HardEvent::FIX_M>(cFree);
                    CrossCoreSetFlag<2,PIPE_FIX>(READY);
                }
                ++chunk;
                if(chunk==d.kSteps) {chunk=0;++ntile;}
            }
            for(uint32_t i=0;i<MinU32(total,B_SLOTS);++i)
                WaitFlag<HardEvent::M_MTE1>(used[i]);
            for(uint32_t i=0;i<MinU32(d.nTiles,B_SLOTS);++i)
                CrossCoreWaitFlag(CONSUMED);
            WaitFlag<HardEvent::FIX_M>(cFree);
        }
        for(uint32_t i=0;i<B_SLOTS;++i) {
            pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(bReady[i]);
            pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(bFree[i]);
            pipe.ReleaseEventID<HardEvent::M_MTE1>(used[i]);
            pipe.ReleaseEventID<HardEvent::MTE1_M>(ready[i]);
        }
    }

    if ASCEND_IS_AIV {
        TBuf<TPosition::VECCALC> inputBuf,workBuf,rowBuf;
        pipe.InitBuffer(inputBuf,d.inputBytes);pipe.InitBuffer(workBuf,WORK_BYTES);
        pipe.InitBuffer(rowBuf,d.stripeCapacity*sizeof(float));
        auto input=inputBuf.Get<float>();auto work=workBuf.Get<uint8_t>();
        auto row=rowBuf.Get<float>();
        GlobalTensor<float> partial,output;
        partial.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(partialGm),d.partialElements);
        output.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y),d.batch);
        for(uint32_t task=group;task<d.workItems;task+=d.blockDim) {
            const uint32_t firstM=TaskFirstM(task,d),rows=TaskRows(task,d);
            const uint32_t batch=TaskBatch(task,d);
            Duplicate(row,LOWEST,rows);PipeBarrier<PIPE_V>();
            for(uint32_t nt=0;nt<d.nTiles;++nt) {
                // Finish all readers before MTE2 reuses the local input tile.
                SetFlag<HardEvent::V_MTE2>(0);WaitFlag<HardEvent::V_MTE2>(0);
                CrossCoreWaitFlag(READY);
                DataCopy(input,scratch[scratchOffset+(nt&1U)*d.stripeCapacity*TILE_N],rows*TILE_N);
                SetFlag<HardEvent::MTE2_V>(0);WaitFlag<HardEvent::MTE2_V>(0);
                CrossCoreSetFlag<2,PIPE_MTE2>(CONSUMED);
                auto maxima=input[d.stripeCapacity*TILE_N];
                uint32_t head[2]={MinU32(rows,TILE_N),TILE_N};
                ReduceMax<float,Pattern::Reduce::AR>(maxima,input,work,head,true);
                PipeBarrier<PIPE_V>();
                if(rows>TILE_N) {
                    uint32_t tail[2]={rows-TILE_N,TILE_N};
                    ReduceMax<float,Pattern::Reduce::AR>(maxima[TILE_N],input[TILE_N*TILE_N],work,tail,true);
                    PipeBarrier<PIPE_V>();
                }
                Max(row,row,maxima,rows);PipeBarrier<PIPE_V>();
            }
            SetFlag<HardEvent::V_MTE3>(0);WaitFlag<HardEvent::V_MTE3>(0);
            DataCopyPad(partial[uint64_t(batch)*d.m+firstM],row,
                {1,static_cast<uint32_t>(rows*sizeof(float)),0,0,0});
            SetFlag<HardEvent::MTE3_V>(0);WaitFlag<HardEvent::MTE3_V>(0);
        }
        SyncAll<true>();
        uint32_t sumShape[2]={1,d.m};
        for(uint32_t batch=group;batch<d.batch;batch+=d.blockDim) {
            DataCopyPad(input,partial[uint64_t(batch)*d.m],
                {1,static_cast<uint32_t>(d.m*sizeof(float)),0,0,0},{false,0,0,0});
            SetFlag<HardEvent::MTE2_V>(0);WaitFlag<HardEvent::MTE2_V>(0);
            ReduceSum<float,Pattern::Reduce::AR>(row,input,work,sumShape,true);
            SetFlag<HardEvent::V_MTE3>(0);WaitFlag<HardEvent::V_MTE3>(0);
            DataCopyPad(output[batch],row,{1,sizeof(float),0,0,0});
            SetFlag<HardEvent::MTE3_V>(0);WaitFlag<HardEvent::MTE3_V>(0);
            if(batch+d.blockDim<d.batch) {
                const auto inputReusable=pipe.FetchEventID(HardEvent::MTE3_MTE2);
                SetFlag<HardEvent::MTE3_MTE2>(inputReusable);
                WaitFlag<HardEvent::MTE3_MTE2>(inputReusable);
            }
        }
    }
}
}  

extern "C" __global__ __aicore__ void batch_matmul_raw_bf16_nn_crossn_reduce(
    GM_ADDR a,GM_ADDR b,GM_ADDR y,GM_ADDR scratch,GM_ADDR partial,
    raw_bf16_nn_crossn_reduce::Plan d)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
    raw_bf16_nn_crossn_reduce::Run(a,b,y,scratch,partial,d);
}

inline bool GenerateRawBf16NnCrossNReducePlan(
    platform_ascendc::PlatformAscendC *platform,uint32_t batch,uint32_t m,
    uint32_t n,uint32_t k,int64_t cores,raw_bf16_nn_crossn_reduce::Plan &d)
{
    using namespace raw_bf16_nn_crossn_reduce;
    if(!platform||cores<=0||!batch||m<ALIGN||m%ALIGN||n<TILE_N||n%TILE_N||
       k<MIN_K_STEPS*STEP_K||k%STEP_K)return false;
    const uint64_t hardware=std::min<uint64_t>(platform->GetCoreNumAic(),platform->GetCoreNumAiv());
    const uint64_t coreLimit=std::min<uint64_t>(cores,hardware);if(!coreLimit)return false;
    uint64_t l1=0,l0a=0,l0b=0,l0c=0,ub=0;
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,l0a);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,l0b);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,l0c);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
    const uint64_t bPages=uint64_t(B_SLOTS)*STEP_K*TILE_N*2;
    if(bPages>=l1||uint64_t(B_SLOTS)*STEP_K*TILE_N*2>l0b)return false;
    uint64_t cap=std::min<uint64_t>((l1-bPages)/(uint64_t(k)*2),
        std::min<uint64_t>(l0a/(uint64_t(B_SLOTS)*STEP_K*2),l0c/(uint64_t(TILE_N)*4)));
    cap=cap/ALIGN*ALIGN;if(cap<ALIGN)return false;
    while(cap>=ALIGN) {
        const uint64_t tileFloats=cap*(TILE_N+2ULL);
        const uint64_t sumFloats=uint64_t(m);
        const uint64_t inputBytes=std::max(tileFloats,sumFloats)*4;
        if(inputBytes+WORK_BYTES+cap*4<=ub)break;
        cap-=ALIGN;
    }
    if(cap<ALIGN)return false;
    const uint64_t ownerGoal=std::max<uint64_t>(1,(coreLimit+batch-1)/batch);
    const uint64_t minTasks=(m+cap-1)/cap;
    const uint64_t stripes=std::max(ownerGoal,minTasks)>m/ALIGN?m/ALIGN:std::max(ownerGoal,minTasks);
    const uint64_t work=uint64_t(batch)*stripes,blocks=std::min(coreLimit,work);
    // This direct pipeline assigns one complete M stripe to each core.
    // Other task distributions use the complete general implementation.
    if(work!=blocks)return false;
    const uint64_t tileFloats=cap*(TILE_N+2ULL),sumFloats=uint64_t(m);
    const uint64_t inputBytes=std::max(tileFloats,sumFloats)*4;
    const uint64_t scratch=2*blocks*cap*TILE_N,partial=uint64_t(batch)*m;
    uint32_t maxTmp=0,minTmp=0;
    GetReduceMaxMaxMinTmpSize(ge::Shape({static_cast<int64_t>(std::min<uint64_t>(cap,TILE_N)),TILE_N}),
        ge::DT_FLOAT,ReducePattern::AR,true,false,maxTmp,minTmp);
    if(maxTmp>WORK_BYTES||minTmp>WORK_BYTES||work>UINT32_MAX||inputBytes>UINT32_MAX||
       scratch>SIZE_MAX/4||partial>SIZE_MAX/4)return false;
    GetReduceSumMaxMinTmpSize(ge::Shape({1,m}),ge::DT_FLOAT,
        ReducePattern::AR,true,false,maxTmp,minTmp);
    if(maxTmp>WORK_BYTES||minTmp>WORK_BYTES)return false;
    d={batch,m,n,k,static_cast<uint32_t>(cap),static_cast<uint32_t>(stripes),
       static_cast<uint32_t>(work),static_cast<uint32_t>(blocks),n/TILE_N,k/STEP_K,
       static_cast<uint32_t>(inputBytes),scratch,partial};
    return true;
}

inline bool TryRunRawBf16NnCrossNReduce(GM_ADDR a,GM_ADDR b,GM_ADDR y,
    uint32_t batch,uint32_t m,uint32_t n,uint32_t k,int32_t dtype,
    int64_t cores,aclrtStream stream,bool ta,bool tb)
{
    if(dtype!=2||ta||tb)return false;
    raw_bf16_nn_crossn_reduce::Plan d{};
    if(!GenerateRawBf16NnCrossNReducePlan(
        platform_ascendc::PlatformAscendCManager::GetInstance(),batch,m,n,k,cores,d))return false;
    uint8_t *scratch=nullptr,*partial=nullptr;
    if(aclrtMalloc(reinterpret_cast<void **>(&scratch),d.scratchElements*4,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS||
       aclrtMalloc(reinterpret_cast<void **>(&partial),d.partialElements*4,ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS) {
        if(scratch)aclrtFree(scratch);if(partial)aclrtFree(partial);return false;
    }
batch_matmul_raw_bf16_nn_crossn_reduce<<<d.blockDim,nullptr,stream>>>(a,b,y,scratch,partial,d);
    const aclError rc=aclrtSynchronizeStream(stream);aclrtFree(scratch);aclrtFree(partial);
    if(rc!=ACL_SUCCESS)throw std::runtime_error("BF16 NN cross-N TwoSum device execution failed");
    return true;
}


// FP16 TT small-matrix / long-K family.  The constants below are reusable
// on-chip tile capacities.  Batch geometry, K slices, task ownership, merge
// rows and workspace sizes are derived from runtime metadata and resources.
namespace raw_tt_splitk {
constexpr uint32_t CAP_M = 64;
constexpr uint32_t CAP_N = 64;
constexpr uint32_t CAP_TILE_K = 512;
constexpr uint32_t CAP_C_ELEMENTS = CAP_M * CAP_N;
constexpr uint32_t STORE_ELEMENTS = 128;
constexpr uint64_t A_CAP_BYTES = uint64_t(CAP_M) * CAP_TILE_K * sizeof(half);
constexpr uint64_t B_CAP_BYTES = uint64_t(CAP_N) * CAP_TILE_K * sizeof(half);
constexpr uint64_t C_CAP_BYTES = uint64_t(CAP_C_ELEMENTS) * sizeof(float);
constexpr uint32_t ACC_OFFSET = 0;
constexpr uint32_t NEXT_OFFSET = CAP_C_ELEMENTS * sizeof(float);
constexpr uint32_t ROW_OFFSET = NEXT_OFFSET + CAP_C_ELEMENTS * sizeof(float);
constexpr uint32_t SCALAR_OFFSET = ROW_OFFSET + STORE_ELEMENTS * sizeof(float);
constexpr uint32_t FINAL_OFFSET = SCALAR_OFFSET + 32;
constexpr uint32_t UB_BYTES = FINAL_OFFSET + CAP_M * STORE_ELEMENTS * sizeof(float);
constexpr uint16_t READY = 8;
constexpr uint16_t CONSUMED = 9;
static_assert(A_CAP_BYTES == 65536 && B_CAP_BYTES == 65536 &&
    C_CAP_BYTES == 16384 && UB_BYTES == 66080 &&
    CAP_M % 16 == 0 && CAP_N % 16 == 0 && CAP_TILE_K % 16 == 0,
    "Split-K capacities must fit the reusable Cube/Vector tile class");

struct Plan {
    uint32_t batch;
    uint32_t m;
    uint32_t n;
    uint32_t k;
    uint32_t blockDim;
    uint32_t tileK;
    uint32_t splitCount;
    uint32_t taskCount;
    uint32_t rowsPerMerge;
    uint32_t mergeGroups;
    uint32_t partialMatrixElements;
    uint32_t mergeWorkItems;
    uint64_t partialElements;
    uint64_t mergeElements;
};
static_assert(sizeof(Plan) <= 64, "Direct launch metadata capacity");

template <uint32_t Count> struct FixedSplitTree {
    __aicore__ static inline void Run(LocalTensor<float> accum, uint32_t rowElements)
    {
        Add(accum, accum, accum[(Count / 2U) * rowElements], (Count / 2U) * rowElements);
        PipeBarrier<PIPE_V>();
        FixedSplitTree<Count / 2U>::Run(accum, rowElements);
    }
};
template <> struct FixedSplitTree<1> {
    __aicore__ static inline void Run(LocalTensor<float>, uint32_t) {}
};
__aicore__ inline void FoldSplits(LocalTensor<float> accum, uint32_t count, uint32_t rowElements)
{
    switch (count) {
        case 1: return;
        case 2: FixedSplitTree<2>::Run(accum, rowElements); return;
        case 4: FixedSplitTree<4>::Run(accum, rowElements); return;
        case 8: FixedSplitTree<8>::Run(accum, rowElements); return;
        case 16: FixedSplitTree<16>::Run(accum, rowElements); return;
        case 32: FixedSplitTree<32>::Run(accum, rowElements); return;
        case 64: FixedSplitTree<64>::Run(accum, rowElements); return;
        default: break;
    }
    uint32_t live = count;
    while (live > 1U) {
        const uint32_t pairs = live / 2U;
        Add(accum, accum, accum[pairs * rowElements], pairs * rowElements);
        PipeBarrier<PIPE_V>();
        if (live & 1U) {
            Add(accum, accum, accum[(live - 1U) * rowElements], rowElements);
            PipeBarrier<PIPE_V>();
        }
        live = pairs;
    }
}

template <bool Full>
__aicore__ inline void Run(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    GM_ADDR partialGm, GM_ADDR mergeGm, const Plan &d)
{
    const uint32_t validMSize = Full ? CAP_M : d.m;
    const uint32_t validNSize = Full ? CAP_N : d.n;
    const uint32_t batches = Full ? 1U : d.batch;
    const uint32_t group = GetBlockIdx();

    GlobalTensor<float> partial;
    partial.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(partialGm),
        d.partialElements);

    if ASCEND_IS_AIC {
        GlobalTensor<half> lhs;
        GlobalTensor<half> rhs;
        lhs.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(x1),
            uint64_t(batches) * d.k * validMSize);
        rhs.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(x2),
            uint64_t(batches) * validNSize * d.k);
        LocalTensor<half> a1(TPosition::A1, 0, CAP_M * CAP_TILE_K);
        LocalTensor<half> b1(TPosition::B1, (CAP_M * CAP_TILE_K) * sizeof(half), CAP_N * CAP_TILE_K);
        LocalTensor<half> a2(TPosition::A2, 0, CAP_M * CAP_TILE_K);
        LocalTensor<half> b2(TPosition::B2, 0, CAP_N * CAP_TILE_K);
        LocalTensor<float> c(TPosition::CO1, 0, CAP_C_ELEMENTS);

        constexpr uint16_t l1Ready = 0;
        constexpr uint16_t l0Ready = 0;
        SetMMRowMajor();

        for (uint32_t task = group; task < d.taskCount; task += d.blockDim) {
            const uint32_t batch = Full ? 0U : task / d.splitCount;
            const uint32_t split = task - batch * d.splitCount;
            const uint32_t firstK = split * CAP_TILE_K;
            const uint32_t validK = Full ? CAP_TILE_K :
                (d.k - firstK < d.tileK ? d.k - firstK : d.tileK);
            const uint64_t aOffset = uint64_t(batch) * d.k * validMSize +
                uint64_t(firstK) * validMSize;
            const uint64_t bOffset = uint64_t(batch) * validNSize * d.k + firstK;

            if (task != group) {
                SetFlag<HardEvent::MTE1_MTE2>(0);
                WaitFlag<HardEvent::MTE1_MTE2>(0);
                SetFlag<HardEvent::FIX_M>(0);
                WaitFlag<HardEvent::FIX_M>(0);
                SetFlag<HardEvent::M_MTE1>(0);
                WaitFlag<HardEvent::M_MTE1>(0);
            }
            const bool padA = validMSize < CAP_M || validK < CAP_TILE_K;
            const bool padB = validNSize < CAP_N || validK < CAP_TILE_K;
            if (padA) InitConstValue(a1, InitConstValueParams<half>{1,
                static_cast<uint16_t>(A_CAP_BYTES / 32U), 0, half(0.0f)});
            if (padB) InitConstValue(b1, InitConstValueParams<half>{1,
                static_cast<uint16_t>(B_CAP_BYTES / 32U), 0, half(0.0f)});
            if (padA || padB) PipeBarrier<PIPE_MTE2>();

            DataCopy(a1, lhs[aOffset], Nd2NzParams{1,
                static_cast<uint16_t>(validK), static_cast<uint16_t>(validMSize),
                0, static_cast<uint16_t>(validMSize),
                static_cast<uint16_t>(CAP_TILE_K), 1, 0});
            DataCopy(b1, rhs[bOffset], Nd2NzParams{1,
                static_cast<uint16_t>(validNSize), static_cast<uint16_t>(validK),
                0, static_cast<uint16_t>(d.k),
                static_cast<uint16_t>(CAP_N), 1, 0});
            SetFlag<HardEvent::MTE2_MTE1>(l1Ready);
            WaitFlag<HardEvent::MTE2_MTE1>(l1Ready);

            const uint32_t aFractals = CAP_M * CAP_TILE_K / 256;
            const uint32_t bFractals = CAP_N * CAP_TILE_K / 256;
            LoadData(a2, a1, LoadData2DParams{0,
                static_cast<uint8_t>(aFractals), 1, 0, 0, true, 0});
            LoadData(b2, b1, LoadData2DParams{0,
                static_cast<uint8_t>(bFractals), 1, 0, 0, false, 0});
            SetFlag<HardEvent::MTE1_M>(l0Ready);
            WaitFlag<HardEvent::MTE1_M>(l0Ready);

            Mmad(c, a2, b2, MmadParams{static_cast<uint16_t>(CAP_M),
                static_cast<uint16_t>(CAP_N), static_cast<uint16_t>(CAP_TILE_K),
                uint8_t(3), false, true});
            FixpipeParamsV220 fix{};
            fix.nSize = CAP_N;
            fix.mSize = CAP_M;
            fix.srcStride = CAP_M;
            fix.dstStride = CAP_N;
            fix.ndNum = 1;
            fix.unitFlag = 3;
            Fixpipe<float, float, CFG_ROW_MAJOR>(
                partial[uint64_t(task) * CAP_C_ELEMENTS], c, fix);
        }
        CrossCoreSetFlag<0, PIPE_FIX>(0);
        CrossCoreWaitFlag(0);
        CrossCoreSetFlag<2, PIPE_FIX>(READY);
    }

    if ASCEND_IS_AIV {
        GlobalTensor<float> merge;
        GlobalTensor<float> output;
        merge.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(mergeGm),
            d.mergeElements);
        output.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y), batches);
        LocalTensor<float> accum(TPosition::VECCALC, ACC_OFFSET, CAP_C_ELEMENTS);
        LocalTensor<float> next(TPosition::VECCALC, NEXT_OFFSET, CAP_C_ELEMENTS);
        LocalTensor<float> rowValues(TPosition::VECCALC, ROW_OFFSET, STORE_ELEMENTS);
        LocalTensor<float> scalar(TPosition::VECCALC, SCALAR_OFFSET, 8);
        LocalTensor<float> finalValues(TPosition::VECCALC, FINAL_OFFSET, CAP_M * STORE_ELEMENTS);
        constexpr uint16_t inputReady = 0;
        constexpr uint16_t inputReusable = 0;
        constexpr uint16_t outputReady = 0;
        constexpr uint16_t outputDone = 0;
        const DataCopyPadExtParams<float> noPad{false, 0, 0, 0};





        CrossCoreWaitFlag(READY);

        for (uint32_t work = group; work < d.mergeWorkItems;
             work += d.blockDim) {
            const uint32_t batch = work / d.mergeGroups;
            const uint32_t mergeGroup = work - batch * d.mergeGroups;
            const uint32_t firstM = mergeGroup * d.rowsPerMerge;
            const uint32_t validM = validMSize - firstM < d.rowsPerMerge ?
                validMSize - firstM : d.rowsPerMerge;
            const uint32_t rowElements = validM * CAP_N;
            const uint64_t first =
                (uint64_t(batch) * d.splitCount) * CAP_C_ELEMENTS +
                uint64_t(firstM) * CAP_N;
            if (uint64_t(d.splitCount) * rowElements <= CAP_C_ELEMENTS) {
                DataCopyPad(accum, partial[first],
                    DataCopyExtParams{static_cast<uint16_t>(d.splitCount),
                        static_cast<uint32_t>(rowElements * sizeof(float)),
                        static_cast<uint32_t>((CAP_C_ELEMENTS - rowElements) * sizeof(float)),
                        0, 0}, noPad);
                SetFlag<HardEvent::MTE2_V>(inputReady);
                WaitFlag<HardEvent::MTE2_V>(inputReady);
                FoldSplits(accum, d.splitCount, rowElements);
            } else {
            DataCopyPad(accum, partial[first], DataCopyExtParams{1,
                static_cast<uint32_t>(rowElements * sizeof(float)), 0, 0, 0},
                noPad);
            SetFlag<HardEvent::MTE2_V>(inputReady);
            WaitFlag<HardEvent::MTE2_V>(inputReady);



            for (uint32_t split = 1; split < d.splitCount; ++split) {
                const uint64_t splitOffset = first +
                    uint64_t(split) * CAP_C_ELEMENTS;
                DataCopyPad(next, partial[splitOffset], DataCopyExtParams{1,
                    static_cast<uint32_t>(rowElements * sizeof(float)),
                    0, 0, 0}, noPad);
                SetFlag<HardEvent::MTE2_V>(inputReady);
                WaitFlag<HardEvent::MTE2_V>(inputReady);
                Add(accum, accum, next, rowElements);
                PipeBarrier<PIPE_V>();
                SetFlag<HardEvent::V_MTE2>(inputReusable);
                WaitFlag<HardEvent::V_MTE2>(inputReusable);
            }

            }

            Duplicate(rowValues,0.0f,STORE_ELEMENTS);
            PipeBarrier<PIPE_V>();
            WholeReduceMax<float, true>(rowValues, accum,
                static_cast<int32_t>(validNSize), static_cast<int32_t>(validM),
                1, 1, static_cast<int32_t>(CAP_N / 8),
                ReduceOrder::ORDER_ONLY_VALUE);
            PipeBarrier<PIPE_V>();
            SetFlag<HardEvent::V_MTE3>(outputReady);
            WaitFlag<HardEvent::V_MTE3>(outputReady);
            DataCopy(merge[(uint64_t(batch) * d.mergeGroups + mergeGroup) * STORE_ELEMENTS],
                rowValues, STORE_ELEMENTS);
            SetFlag<HardEvent::MTE3_V>(outputDone);
            WaitFlag<HardEvent::MTE3_V>(outputDone);
            SetFlag<HardEvent::V_MTE2>(inputReusable);
            WaitFlag<HardEvent::V_MTE2>(inputReusable);
        }

        CrossCoreSetFlag<0, PIPE_MTE3>(1);
        CrossCoreWaitFlag(1);
        for (uint32_t batch = group; batch < batches; batch += d.blockDim) {
            DataCopy(finalValues,merge[uint64_t(batch)*d.mergeGroups*STORE_ELEMENTS],d.mergeGroups*STORE_ELEMENTS);
            SetFlag<HardEvent::MTE2_V>(inputReady);
            WaitFlag<HardEvent::MTE2_V>(inputReady);
            const uint32_t groups = d.mergeGroups * STORE_ELEMENTS / 64;
            WholeReduceSum<float,true>(rowValues,finalValues,64,groups,1,1,8);
            PipeBarrier<PIPE_V>();
            if (groups <= 64) WholeReduceSum<float,true>(scalar,rowValues,groups,1,1,1,8);
            else {
                const uint32_t full=groups/64,tail=groups%64;
                WholeReduceSum<float,true>(finalValues,rowValues,64,full,1,1,8);
                if(tail)WholeReduceSum<float,true>(finalValues[full],rowValues[full*64],tail,1,1,1,8);
                PipeBarrier<PIPE_V>();
                WholeReduceSum<float,true>(scalar,finalValues,full+(tail!=0),1,1,1,8);
            }
            SetFlag<HardEvent::V_MTE3>(outputReady);
            WaitFlag<HardEvent::V_MTE3>(outputReady);
            DataCopyPad(output[batch], scalar,
                DataCopyExtParams{1, sizeof(float), 0, 0, 0});
            SetFlag<HardEvent::MTE3_V>(outputDone);
            WaitFlag<HardEvent::MTE3_V>(outputDone);
            SetFlag<HardEvent::V_MTE2>(inputReusable);
            WaitFlag<HardEvent::V_MTE2>(inputReusable);
        }
    }
}
}

extern "C" __global__ __aicore__ void batch_matmul_raw_tt_splitk_fp16(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR partial, GM_ADDR merge,
    raw_tt_splitk::Plan plan)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
    raw_tt_splitk::Run<false>(x1, x2, y, partial, merge, plan);
}
extern "C" __global__ __aicore__ void batch_matmul_raw_tt_splitk_fp16_full_capacity(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y, GM_ADDR partial, GM_ADDR merge,
    uint32_t depth)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
    raw_tt_splitk::Plan plan{};
    plan.batch=1U;
    plan.m=raw_tt_splitk::CAP_M;
    plan.n=raw_tt_splitk::CAP_N;
    plan.k=depth;
    plan.blockDim=GetBlockNum();
    plan.tileK=raw_tt_splitk::CAP_TILE_K;
    plan.splitCount=depth/raw_tt_splitk::CAP_TILE_K;
    plan.taskCount=plan.splitCount;
    const uint32_t groups=plan.blockDim<raw_tt_splitk::CAP_M ? plan.blockDim : raw_tt_splitk::CAP_M;
    plan.rowsPerMerge=(raw_tt_splitk::CAP_M+groups-1U)/groups;
    plan.mergeGroups=(raw_tt_splitk::CAP_M+plan.rowsPerMerge-1U)/plan.rowsPerMerge;
    plan.partialMatrixElements=raw_tt_splitk::CAP_C_ELEMENTS;
    plan.mergeWorkItems=plan.mergeGroups;
    plan.partialElements=uint64_t(plan.taskCount)*raw_tt_splitk::CAP_C_ELEMENTS;
    plan.mergeElements=uint64_t(plan.mergeWorkItems)*raw_tt_splitk::STORE_ELEMENTS;

    raw_tt_splitk::Run<true>(x1, x2, y, partial, merge, plan);
}

inline bool GenerateRawTtSplitKPlan(
    platform_ascendc::PlatformAscendC *platform, uint32_t batch,
    uint32_t m, uint32_t n, uint32_t k, int64_t cores,
    raw_tt_splitk::Plan &plan)
{
    using namespace raw_tt_splitk;
    if (platform == nullptr || cores <= 0 || batch == 0 || m == 0 || n == 0 ||
        k == 0 || k > UINT16_MAX || m > CAP_M || n > CAP_N ||
        m % 16 != 0 || n % 16 != 0 || k % 16 != 0) {
        return false;
    }
    const uint32_t coreLimit = static_cast<uint32_t>(std::min<int64_t>(cores,
        std::min<int64_t>(platform->GetCoreNumAic(),
            platform->GetCoreNumAiv())));
    if (coreLimit == 0) return false;

    uint64_t l1 = 0, l0a = 0, l0b = 0, l0c = 0, ub = 0;
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1, l1);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A, l0a);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B, l0b);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C, l0c);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ub);
    if (A_CAP_BYTES + B_CAP_BYTES > l1 || A_CAP_BYTES > l0a ||
        B_CAP_BYTES > l0b || C_CAP_BYTES > l0c || UB_BYTES > ub) {
        return false;
    }

    const uint32_t tileK = CAP_TILE_K;
    if (tileK == 0 || tileK > CAP_TILE_K || k <= tileK) return false;
    const uint32_t splitCount = (k + tileK - 1) / tileK;
    const uint64_t taskCount64 = uint64_t(batch) * splitCount;
    if (taskCount64 == 0 || taskCount64 > UINT32_MAX) return false;
    const uint32_t taskCount = static_cast<uint32_t>(taskCount64);
    const uint32_t blockDim = taskCount < coreLimit ? taskCount : coreLimit;

    const uint32_t targetGroups = batch <= blockDim ?
        std::max<uint32_t>(1, blockDim / batch) : 1;
    const uint32_t desiredGroups = std::min<uint32_t>(m, targetGroups);
    const uint32_t rowsPerMerge = (m + desiredGroups - 1) / desiredGroups;
    const uint32_t mergeGroups = (m + rowsPerMerge - 1) / rowsPerMerge;
    const uint64_t mergeWork64 = uint64_t(batch) * mergeGroups;
    const uint64_t partialMatrix = CAP_C_ELEMENTS;
    const uint64_t partialElements = taskCount64 * partialMatrix;
    if (mergeWork64 > UINT32_MAX || partialMatrix > UINT32_MAX ||
        partialElements > SIZE_MAX / sizeof(float) ||
        mergeWork64 > SIZE_MAX / (STORE_ELEMENTS * sizeof(float))) {
        return false;
    }

    plan.batch = batch;
    plan.m = m;
    plan.n = n;
    plan.k = k;
    plan.blockDim = blockDim;
    plan.tileK = tileK;
    plan.splitCount = splitCount;
    plan.taskCount = taskCount;
    plan.rowsPerMerge = rowsPerMerge;
    plan.mergeGroups = mergeGroups;
    plan.partialMatrixElements = static_cast<uint32_t>(partialMatrix);
    plan.mergeWorkItems = static_cast<uint32_t>(mergeWork64);
    plan.partialElements = partialElements;
    plan.mergeElements = mergeWork64 * STORE_ELEMENTS;
    return true;
}

inline bool TryRunRawTtSplitKSmall(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
    uint32_t batch, uint32_t m, uint32_t n, uint32_t k, int32_t dtype,
    int64_t cores, aclrtStream stream, bool transposeX1, bool transposeX2)
{
    if (dtype != 1 || !transposeX1 || !transposeX2) return false;
    raw_tt_splitk::Plan plan{};
    if (!GenerateRawTtSplitKPlan(
            platform_ascendc::PlatformAscendCManager::GetInstance(),
            batch, m, n, k, cores, plan)) {
        return false;
    }
    const bool full = batch == 1U && m == raw_tt_splitk::CAP_M &&
        n == raw_tt_splitk::CAP_N && k % raw_tt_splitk::CAP_TILE_K == 0U;
uint8_t *partial = nullptr;
    uint8_t *merge = nullptr;
    const size_t partialBytes = static_cast<size_t>(
        plan.partialElements * sizeof(float));
    const size_t mergeBytes = static_cast<size_t>(
        plan.mergeElements * sizeof(float));
    if (aclrtMalloc(reinterpret_cast<void **>(&partial), partialBytes,
            ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS ||
        aclrtMalloc(reinterpret_cast<void **>(&merge), mergeBytes,
            ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        if (partial) aclrtFree(partial);
        if (merge) aclrtFree(merge);
        return false;
    }
        if (full) {
batch_matmul_raw_tt_splitk_fp16_full_capacity<<<plan.blockDim, nullptr, stream>>>(
        x1, x2, y, partial, merge, k);
    } else {
batch_matmul_raw_tt_splitk_fp16<<<plan.blockDim, nullptr, stream>>>(
        x1, x2, y, partial, merge, plan);
    }
    const aclError result = aclrtSynchronizeStream(stream);
    aclrtFree(partial);
    aclrtFree(merge);
    if (result != ACL_SUCCESS) {
        throw std::runtime_error("FP16 TT split-K device execution failed");
    }
    return true;
}


// TN full-A algorithm family. All whole-input geometry is runtime metadata.
namespace raw_tn_fulla {
constexpr uint32_t TM=128, TN=256, BK=64, BSLOTS=3;
constexpr uint32_t BE=TN*BK, L0AE=TM*BK, L0BE=TN*BK;
constexpr uint32_t INPUT=TM*TN*4, WORK=32768, ROWS=TM*4;
constexpr uint64_t L1B=uint64_t(BSLOTS)*BE*2;
constexpr uint64_t L0A_BYTES=2*uint64_t(L0AE)*2;
constexpr uint64_t L0B_BYTES=2*uint64_t(L0BE)*2;
constexpr uint64_t L0C_BYTES=uint64_t(TM)*TN*4;
constexpr uint64_t UB_BYTES=INPUT+WORK+2*ROWS;
constexpr uint16_t READY=8, CONSUMED=9;
struct Plan {
    uint32_t batch,m,n,k,mBlocks,nBlocks,kSteps,nGroups,workItems,blockDim;
    uint64_t scratchElements,partialElements;
};
static_assert(sizeof(Plan)<=128,"Direct launch metadata capacity");

template<typename T>
__aicore__ inline void Run(GM_ADDR x1,GM_ADDR x2,GM_ADDR y,
    GM_ADDR tileScratch,GM_ADDR partialRows,const Plan &d)
{
    const uint32_t group=GetBlockIdx();
    const uint64_t scratchOffset=2*uint64_t(group)*TM*TN;
    TPipe pipe;
    GlobalTensor<float> scratch;
    scratch.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(tileScratch),d.scratchElements);
    if ASCEND_IS_AIC {
        GlobalTensor<T> lhs,rhs;
        lhs.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x1),uint64_t(d.batch)*d.k*d.m);
        rhs.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x2),uint64_t(d.batch)*d.k*d.n);
        TBuf<TPosition::A1> a1Buf; TBuf<TPosition::B1> b1Buf;
        TBuf<TPosition::A2> a2Buf; TBuf<TPosition::B2> b2Buf; TBuf<TPosition::CO1> cBuf;
        pipe.InitBuffer(a1Buf,uint64_t(TM)*d.k*2);pipe.InitBuffer(b1Buf,L1B);
        pipe.InitBuffer(a2Buf,L0A_BYTES);pipe.InitBuffer(b2Buf,L0B_BYTES);pipe.InitBuffer(cBuf,L0C_BYTES);
        auto a1=a1Buf.template Get<T>(); auto b1=b1Buf.template Get<T>();
        auto a2=a2Buf.template Get<T>(); auto b2=b2Buf.template Get<T>(); auto c=cBuf.Get<float>();
        TEventID bReady[BSLOTS],bFree[BSLOTS];
        for(uint32_t i=0;i<BSLOTS;++i) {
            bReady[i]=pipe.AllocEventID<HardEvent::MTE2_MTE1>();
            bFree[i]=pipe.AllocEventID<HardEvent::MTE1_MTE2>();
        }
        const auto aReady=pipe.FetchEventID(HardEvent::MTE2_MTE1);
        const TEventID used[2]={pipe.AllocEventID<HardEvent::M_MTE1>(),pipe.AllocEventID<HardEvent::M_MTE1>()};
        const TEventID ready[2]={pipe.AllocEventID<HardEvent::MTE1_M>(),pipe.AllocEventID<HardEvent::MTE1_M>()};
        const auto cReady=pipe.FetchEventID(HardEvent::M_FIX),cFree=pipe.FetchEventID(HardEvent::FIX_M);
        const uint8_t pads[4]={0,0,0,0};
        SetFmatrix(1,d.k,pads,FmatrixMode::FMATRIX_LEFT);
        SetFmatrix(1,BK,pads,FmatrixMode::FMATRIX_RIGHT);
        SetMMRowMajor();
        SetLoadDataRepeat(LoadDataRepeatParam{0,1,0});SetLoadDataBoundary(0);
        SetLoadDataPaddingValue<half>(half(0.0f));
        LoadData3DParamsV2Pro loadA;
        loadA.channelSize=TM;loadA.enTranspose=true;loadA.fMatrixCtrl=false;
        LoadData3DParamsV2Pro loadB;
        loadB.channelSize=TN;loadB.enTranspose=false;loadB.fMatrixCtrl=true;
        loadB.extConfig=(uint64_t(BK)<<16)|uint64_t(TN);
        for(uint32_t task=group;task<d.workItems;task+=d.blockDim) {
            const uint32_t p=task%d.nGroups, bm=task/d.nGroups;
            const uint32_t mb=bm%d.mBlocks,b=bm/d.mBlocks;
            const uint32_t nBegin=uint64_t(p)*d.nBlocks/d.nGroups;
            const uint32_t nEnd=uint64_t(p+1)*d.nBlocks/d.nGroups;
            const uint32_t tiles=nEnd-nBegin,total=tiles*d.kSteps;
            const uint32_t rotation=group%tiles;
            const uint64_t aBase=uint64_t(b)*d.m*d.k+mb*TM;
            const uint64_t bBase=uint64_t(b)*d.k*d.n;
            DataCopy(a1,lhs[aBase],Nd2NzParams{1,static_cast<uint16_t>(d.k),TM,0,
                static_cast<uint16_t>(d.m),static_cast<uint16_t>(d.k),1,0});
            SetFlag<HardEvent::MTE2_MTE1>(aReady);WaitFlag<HardEvent::MTE2_MTE1>(aReady);
            const uint32_t initial=total<BSLOTS?total:BSLOTS;
            for(uint32_t page=0;page<initial;++page) {
                const uint32_t tile=page/d.kSteps,chunk=page%d.kSteps;
                const uint32_t column=nBegin+(tile+rotation)%tiles;
                DataCopy(b1[page*BE],rhs[bBase+uint64_t(chunk*BK)*d.n+column*TN],
                    Nd2NzParams{1,BK,TN,0,static_cast<uint16_t>(d.n),BK,1,0});
                SetFlag<HardEvent::MTE2_MTE1>(bReady[page]);
            }
             
            uint32_t nextChunk=initial%d.kSteps,nextColumn=(initial/d.kSteps+rotation)%tiles;
            uint32_t flat=0,bs=0,slot=0;
            for(uint32_t tile=0;tile<tiles;++tile) {
                for(uint32_t chunk=0;chunk<d.kSteps;++chunk,++flat) {
                    WaitFlag<HardEvent::MTE2_MTE1>(bReady[bs]);
                    if(flat>=2)WaitFlag<HardEvent::M_MTE1>(used[slot]);
                    loadA.extConfig=(uint64_t(chunk*BK)<<48)|(uint64_t(BK)<<16)|uint64_t(TM);
                    LoadData(a2[slot*L0AE],a1,loadA);
                    LoadData(b2[slot*L0BE],b1[bs*BE],loadB);
                    SetFlag<HardEvent::MTE1_MTE2>(bFree[bs]);
                    SetFlag<HardEvent::MTE1_M>(ready[slot]);WaitFlag<HardEvent::MTE1_M>(ready[slot]);
                     
                    Mmad(c,a2[slot*L0AE],b2[slot*L0BE],MmadParams{TM,TN,BK,uint8_t(chunk+1==d.kSteps?3:2),false,chunk==0});
                    SetFlag<HardEvent::M_MTE1>(used[slot]);
                    WaitFlag<HardEvent::MTE1_MTE2>(bFree[bs]);
                    if(flat+BSLOTS<total) {
                        DataCopy(b1[bs*BE],rhs[bBase+uint64_t(nextChunk*BK)*d.n+(nBegin+nextColumn)*TN],
                            Nd2NzParams{1,BK,TN,0,static_cast<uint16_t>(d.n),BK,1,0});
                        SetFlag<HardEvent::MTE2_MTE1>(bReady[bs]);
                        if(++nextChunk==d.kSteps) {
                            nextChunk=0;if(++nextColumn==tiles)nextColumn=0;
                        }
                    }
                    if(chunk+1==d.kSteps) {
                        if(tile>=2)CrossCoreWaitFlag(CONSUMED);
                        FixpipeParamsV220 fix{};fix.nSize=TN;fix.mSize=TM;fix.srcStride=TM;fix.dstStride=TN;fix.ndNum=1;fix.unitFlag=3;
                        Fixpipe<float,float,CFG_ROW_MAJOR>(scratch[scratchOffset+(tile%2)*TM*TN],c,fix);
                        if(tile+1==tiles)SetFlag<HardEvent::FIX_M>(cFree);
                        CrossCoreSetFlag<2,PIPE_FIX>(READY);
                    }
                    if(++bs==BSLOTS)bs=0;slot^=1;
                }
            }
            for(uint32_t i=0;i<(total<2?total:2);++i)WaitFlag<HardEvent::M_MTE1>(used[i]);
            for(uint32_t i=0;i<(tiles<2?tiles:2);++i)CrossCoreWaitFlag(CONSUMED);
            WaitFlag<HardEvent::FIX_M>(cFree);
        }
        for(uint32_t i=0;i<BSLOTS;++i) {
            pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(bReady[i]);pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(bFree[i]);
        }
        for(uint32_t i=0;i<2;++i) {
            pipe.ReleaseEventID<HardEvent::M_MTE1>(used[i]);pipe.ReleaseEventID<HardEvent::MTE1_M>(ready[i]);
        }
    }
    if ASCEND_IS_AIV {
        TBuf<TPosition::VECCALC> inputBuf,workBuf,maxBuf,rowBuf;
        pipe.InitBuffer(inputBuf,INPUT);pipe.InitBuffer(workBuf,WORK);
        pipe.InitBuffer(maxBuf,ROWS);pipe.InitBuffer(rowBuf,ROWS);
        auto inputLocal=inputBuf.Get<float>();auto workLocal=workBuf.Get<uint8_t>();
        auto maxLocal=maxBuf.Get<float>();auto rowLocal=rowBuf.Get<float>();
        GlobalTensor<float> partial,output;
        partial.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(partialRows),d.partialElements);
        output.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y),d.batch);
        const auto inputReusable=pipe.FetchEventID(HardEvent::V_MTE2),inputReady=pipe.FetchEventID(HardEvent::MTE2_V);
        const auto rowsReady=pipe.FetchEventID(HardEvent::V_MTE3),rowsStored=pipe.FetchEventID(HardEvent::MTE3_V);
        uint32_t reduceShape[2]={TM,TN};
        for(uint32_t task=group;task<d.workItems;task+=d.blockDim) {
            const uint32_t p=task%d.nGroups;
            const uint32_t tiles=uint64_t(p+1)*d.nBlocks/d.nGroups-uint64_t(p)*d.nBlocks/d.nGroups;
            Duplicate(rowLocal,-3.402823466e+38f,TM);PipeBarrier<PIPE_V>();
            for(uint32_t tile=0;tile<tiles;++tile) {
                SetFlag<HardEvent::V_MTE2>(inputReusable);WaitFlag<HardEvent::V_MTE2>(inputReusable);
                CrossCoreWaitFlag(READY);
                DataCopy(inputLocal,scratch[scratchOffset+(tile%2)*TM*TN],TM*TN);
                SetFlag<HardEvent::MTE2_V>(inputReady);WaitFlag<HardEvent::MTE2_V>(inputReady);
                CrossCoreSetFlag<2,PIPE_MTE2>(CONSUMED);
                ReduceMax<float,Pattern::Reduce::AR>(maxLocal,inputLocal,workLocal,reduceShape,true);
                PipeBarrier<PIPE_V>();Max(rowLocal,rowLocal,maxLocal,TM);PipeBarrier<PIPE_V>();
            }
            SetFlag<HardEvent::V_MTE3>(rowsReady);WaitFlag<HardEvent::V_MTE3>(rowsReady);
            const uint32_t bm=task/d.nGroups,batch=bm/d.mBlocks,mb=bm%d.mBlocks;
            const uint64_t outOffset=uint64_t(batch)*d.m*d.nGroups+
                uint64_t(task%d.nGroups)*d.m+mb*TM;
            DataCopy(partial[outOffset],rowLocal,TM);
            SetFlag<HardEvent::MTE3_V>(rowsStored);WaitFlag<HardEvent::MTE3_V>(rowsStored);
        }
         
        SyncAll<true>();
        const uint32_t count=d.mBlocks*d.nGroups*TM;
        auto merged=inputLocal[count];
        uint32_t sumShape[2]={d.mBlocks,TM};
        for(uint32_t b=group;b<d.batch;b+=d.blockDim) {
            DataCopyPad(inputLocal,partial[uint64_t(b)*count],
                {1,static_cast<uint32_t>(count*sizeof(float)),0,0,0},{false,0,0,0});
            SetFlag<HardEvent::MTE2_V>(inputReady);WaitFlag<HardEvent::MTE2_V>(inputReady);
            if(d.nGroups==2) {
                Max(merged,inputLocal,inputLocal[d.m],d.m);PipeBarrier<PIPE_V>();
            } else {
                DataCopy(merged,inputLocal,d.m);PipeBarrier<PIPE_V>();
                for(uint32_t p=1;p<d.nGroups;++p) {
                    Max(merged,merged,inputLocal[p*d.m],d.m);PipeBarrier<PIPE_V>();
                }
            }
            ReduceSum<float,Pattern::Reduce::AR>(maxLocal,merged,workLocal,sumShape,true);
            const auto vToS=pipe.FetchEventID(HardEvent::V_S);
            SetFlag<HardEvent::V_S>(vToS);WaitFlag<HardEvent::V_S>(vToS);
            float score=0.0f,correction=0.0f;
            for(uint32_t mb=0;mb<d.mBlocks;++mb) {
                const float adjusted=maxLocal.GetValue(mb)-correction,next=score+adjusted;
                correction=(next-score)-adjusted;score=next;
            }
            rowLocal.SetValue(0,score);
            const auto sToMte3=pipe.FetchEventID(HardEvent::S_MTE3);
            SetFlag<HardEvent::S_MTE3>(sToMte3);WaitFlag<HardEvent::S_MTE3>(sToMte3);
            SetFlag<HardEvent::V_MTE3>(rowsReady);WaitFlag<HardEvent::V_MTE3>(rowsReady);
            DataCopyPad(output[b],rowLocal,{1,sizeof(float),0,0,0});
            SetFlag<HardEvent::MTE3_V>(rowsStored);WaitFlag<HardEvent::MTE3_V>(rowsStored);
        }
    }
}
}  

#define DEFINE_RAW_FULLA(NAME, TYPE) \
extern "C" __global__ __aicore__ void NAME(GM_ADDR a,GM_ADDR b,GM_ADDR y, \
    GM_ADDR scratch,GM_ADDR partial,raw_tn_fulla::Plan d) { \
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1); \
    raw_tn_fulla::Run<TYPE>(a,b,y,scratch,partial,d); }
DEFINE_RAW_FULLA(batch_matmul_raw_tn_fulla_fp16,half)
DEFINE_RAW_FULLA(batch_matmul_raw_tn_fulla_bf16,bfloat16_t)
#undef DEFINE_RAW_FULLA

inline bool GenerateRawFullAPlan(platform_ascendc::PlatformAscendC *platform,
    uint32_t batch,uint32_t m,uint32_t n,uint32_t k,int64_t cores,raw_tn_fulla::Plan &d)
{
    using namespace raw_tn_fulla;
    if(!platform||cores<=0||m%TM||n%TN||k%BK)return false;
    if(m/TM>TM)return false;
    const uint32_t coreLimit=std::min<int64_t>(cores,
        std::min<int64_t>(platform->GetCoreNumAic(),platform->GetCoreNumAiv()));
    if(!coreLimit)return false;
    uint64_t l1=0,l0a=0,l0b=0,l0c=0,ub=0;
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,l0a);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,l0b);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,l0c);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
    if(uint64_t(TM)*k*2+L1B>l1||L0A_BYTES>l0a||L0B_BYTES>l0b||L0C_BYTES>l0c||UB_BYTES>ub)return false;
    uint32_t high=0,low=0;
    GetReduceMaxMaxMinTmpSize(ge::Shape({TM,TN}),ge::DT_FLOAT,ReducePattern::AR,true,false,high,low);
    if(high>WORK||low>WORK)return false;
    GetReduceSumMaxMinTmpSize(ge::Shape({m/TM,TM}),ge::DT_FLOAT,ReducePattern::AR,true,false,high,low);
    if(high>WORK||low>WORK)return false;
    d.batch=batch;d.m=m;d.n=n;d.k=k;d.mBlocks=m/TM;d.nBlocks=n/TN;d.kSteps=k/BK;
    const uint64_t natural=uint64_t(batch)*d.mBlocks;
    const uint32_t groups=natural<coreLimit?uint32_t((coreLimit+natural-1)/natural):1;
    d.nGroups=std::min(d.nBlocks,groups);
    const uint64_t work=natural*d.nGroups;
    if(!work||work>UINT32_MAX||(uint64_t(d.mBlocks)*d.nGroups*TM+m)*sizeof(float)>INPUT)return false;
    d.workItems=work;d.blockDim=std::min(coreLimit,d.workItems);
    d.scratchElements=2*uint64_t(d.blockDim)*TM*TN;
    d.partialElements=work*TM;
    return true;
}

inline bool TryRunRawFullATn(GM_ADDR x1,GM_ADDR x2,GM_ADDR y,
    uint32_t batch,uint32_t m,uint32_t n,uint32_t k,int32_t dtype,
    int64_t cores,aclrtStream stream,bool ta,bool tb)
{
    if(!ta||tb)return false;
    raw_tn_fulla::Plan d{};
    if(!GenerateRawFullAPlan(platform_ascendc::PlatformAscendCManager::GetInstance(),batch,m,n,k,cores,d))return false;
    uint8_t *scratch=nullptr,*partial=nullptr;
    if(aclrtMalloc(reinterpret_cast<void **>(&scratch),d.scratchElements*sizeof(float),ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS||
       aclrtMalloc(reinterpret_cast<void **>(&partial),d.partialElements*sizeof(float),ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS) {
        if(scratch)aclrtFree(scratch);if(partial)aclrtFree(partial);return false;
    }
    if(dtype==1)batch_matmul_raw_tn_fulla_fp16<<<d.blockDim,nullptr,stream>>>(x1,x2,y,scratch,partial,d);
    else batch_matmul_raw_tn_fulla_bf16<<<d.blockDim,nullptr,stream>>>(x1,x2,y,scratch,partial,d);
    const aclError result=aclrtSynchronizeStream(stream);
    aclrtFree(scratch);aclrtFree(partial);
    if(result!=ACL_SUCCESS)throw std::runtime_error("TN full-A Raw device execution failed");
    return true;
}


namespace raw_tt_m256n128 {
constexpr uint32_t TM=256,TN=128,BK=64,AP=128,BP=256;
constexpr uint32_t ASLOTS=4,BSLOTS=3;
constexpr uint32_t MAX_GROUPS=20;
constexpr uint32_t AE=TM*AP,BE=TN*BP,L0AE=TM*BK,L0BE=TN*BK;
constexpr uint32_t INPUT=TM*TN*4,WORK=32768,ROWS=TM*4;
constexpr uint32_t ASTRIDE=AE+1024,BSTRIDE=BE+1024;
constexpr uint64_t L1A=uint64_t(ASLOTS)*ASTRIDE*2,L1B=uint64_t(BSLOTS)*BSTRIDE*2;
constexpr uint64_t L1_BYTES=L1A+L1B;
constexpr uint64_t L0A_BYTES=2*uint64_t(L0AE)*2;
constexpr uint64_t L0B_BYTES=2*uint64_t(L0BE)*2;
constexpr uint64_t L0C_BYTES=uint64_t(TM)*TN*4;
constexpr uint64_t UB_BYTES=INPUT+WORK+2*ROWS;
constexpr uint16_t READY=8,CONSUMED=9;
constexpr float LOWEST=-3.402823466e+38f;

struct Plan {
    uint32_t batch,m,n,k,mBlocks,nBlocks,kSteps,aPages,bPages,workItems,blockDim;
    uint32_t contributorSlots;
    uint16_t segmentPrefix[21];
    uint64_t scratchElements,partialElements;
};
static_assert(sizeof(Plan)<=128,"Direct launch metadata capacity");

__aicore__ inline uint32_t TaskMb(uint32_t tile,uint32_t first,uint32_t nBlocks) {
    return (first+tile)/nBlocks;
}

__aicore__ inline uint32_t TaskN(uint32_t tile,uint32_t first,uint32_t last,
    uint32_t group,uint32_t nBlocks)
{
    const uint32_t mb=TaskMb(tile,first,nBlocks);
    const uint32_t begin=first>mb*nBlocks?first-mb*nBlocks:0;
    const uint32_t end=last<(mb+1)*nBlocks?last-mb*nBlocks:nBlocks;
    return begin+((first+tile-mb*nBlocks-begin+group)%(end-begin));
}

__aicore__ inline uint32_t AStart(uint32_t page,uint32_t group,
    uint32_t aPages,uint32_t bPages)
{
    const uint32_t rotation=(2U*group)%bPages;
    return ((page%aPages+rotation*(BP/AP))%aPages)*AP;
}

__aicore__ inline uint32_t BStart(uint32_t page,uint32_t group,uint32_t bPages) {
    return ((page%bPages+(2U*group)%bPages)%bPages)*BP;
}

template<typename T>
__aicore__ inline void Run(GM_ADDR x1,GM_ADDR x2,GM_ADDR y,
    GM_ADDR scratchGm,GM_ADDR partialGm,const Plan &d)
{
    const uint32_t group=GetBlockIdx();
    const uint32_t first=uint64_t(group)*d.workItems/d.blockDim;
    const uint32_t last=uint64_t(group+1)*d.workItems/d.blockDim;
    const uint32_t tiles=last-first;
    const uint32_t aTotal=tiles*d.aPages,bTotal=tiles*d.bPages;
    const uint32_t total=tiles*d.kSteps;
    const uint64_t scratchOffset=2*uint64_t(group)*TM*TN;
    TPipe pipe;
    GlobalTensor<float> scratch;
    scratch.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(scratchGm),d.scratchElements);
    if ASCEND_IS_AIC {
        SetMMRowMajor();
        GlobalTensor<T> lhs,rhs;
        lhs.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x1),uint64_t(d.batch)*d.k*d.m);
        rhs.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x2),uint64_t(d.batch)*d.n*d.k);
        TBuf<TPosition::A1> a1Buf;TBuf<TPosition::B1> b1Buf;
        TBuf<TPosition::A2> a2Buf;TBuf<TPosition::B2> b2Buf;TBuf<TPosition::CO1> cBuf;
        pipe.InitBuffer(a1Buf,L1A);pipe.InitBuffer(b1Buf,L1B);
        pipe.InitBuffer(a2Buf,L0A_BYTES);pipe.InitBuffer(b2Buf,L0B_BYTES);pipe.InitBuffer(cBuf,L0C_BYTES);
        auto a1=a1Buf.template Get<T>();auto b1=b1Buf.template Get<T>();
        auto a2=a2Buf.template Get<T>();auto b2=b2Buf.template Get<T>();auto c=cBuf.Get<float>();
        TEventID aReady[ASLOTS],aFree[ASLOTS],bReady[BSLOTS],bFree[BSLOTS];
        for(uint32_t i=0;i<ASLOTS;++i) {
            aReady[i]=pipe.AllocEventID<HardEvent::MTE2_MTE1>();
            aFree[i]=pipe.AllocEventID<HardEvent::MTE1_MTE2>();
        }
        for(uint32_t i=0;i<BSLOTS;++i) {
            bReady[i]=pipe.AllocEventID<HardEvent::MTE2_MTE1>();
            bFree[i]=pipe.AllocEventID<HardEvent::MTE1_MTE2>();
        }
        const TEventID used[2]={pipe.AllocEventID<HardEvent::M_MTE1>(),pipe.AllocEventID<HardEvent::M_MTE1>()};
        const TEventID ready[2]={pipe.AllocEventID<HardEvent::MTE1_M>(),pipe.AllocEventID<HardEvent::MTE1_M>()};
        const auto cReady=pipe.FetchEventID(HardEvent::M_FIX),cFree=pipe.FetchEventID(HardEvent::FIX_M);
        const uint32_t aInitial=aTotal<ASLOTS?aTotal:ASLOTS;
        for(uint32_t page=0;page<aInitial;++page) {
            const uint32_t tile=page/d.aPages;
            const uint32_t bm=TaskMb(tile,first,d.nBlocks);
            const uint32_t b=bm/d.mBlocks,mb=bm%d.mBlocks;
            const uint32_t kStart=AStart(page,group,d.aPages,d.bPages);
            DataCopy(a1[page*ASTRIDE],lhs[uint64_t(b)*d.k*d.m+uint64_t(kStart)*d.m+mb*TM],
                Nd2NzParams{1,AP,TM,0,static_cast<uint16_t>(d.m),AP,1,0});
            SetFlag<HardEvent::MTE2_MTE1>(aReady[page]);
        }
        const uint32_t bInitial=bTotal<BSLOTS?bTotal:BSLOTS;
        for(uint32_t page=0;page<bInitial;++page) {
            const uint32_t tile=page/d.bPages;
            const uint32_t task=first+tile,b=task/(d.mBlocks*d.nBlocks);
            const uint32_t nb=TaskN(tile,first,last,group,d.nBlocks);
            const uint32_t kStart=BStart(page,group,d.bPages);
            DataCopy(b1[page*BSTRIDE],rhs[uint64_t(b)*d.n*d.k+uint64_t(nb*TN)*d.k+kStart],
                Nd2NzParams{1,TN,BP,0,static_cast<uint16_t>(d.k),TN,1,0});
            SetFlag<HardEvent::MTE2_MTE1>(bReady[page]);
        }
        for(uint32_t flat=0;flat<total;++flat) {
            const uint32_t tile=flat/d.kSteps,chunk=flat%d.kSteps;
            const uint32_t apage=flat/(AP/BK),as=apage%ASLOTS;
            const uint32_t bpage=flat/(BP/BK),bs=bpage%BSLOTS,slot=flat&1U;
            if(flat%(AP/BK)==0)WaitFlag<HardEvent::MTE2_MTE1>(aReady[as]);
            if(flat%(BP/BK)==0)WaitFlag<HardEvent::MTE2_MTE1>(bReady[bs]);
            if(flat>=2)WaitFlag<HardEvent::M_MTE1>(used[slot]);
            const LoadData2DParams loadA{0,static_cast<uint8_t>(TM/16),AP/16,0,3,true,0};
            for(uint32_t kk=0;kk<BK;kk+=16)
                LoadData(a2[slot*L0AE+kk*16],a1[as*ASTRIDE+(flat%(AP/BK)*BK+kk)*16],loadA);
            const LoadData2DParams loadB{0,static_cast<uint8_t>((BK/16)*(TN/16)),1,0,0,false,0};
            LoadData(b2[slot*L0BE],b1[bs*BSTRIDE+(chunk%(BP/BK))*BK*TN],loadB);
            if(flat%(AP/BK)==AP/BK-1)SetFlag<HardEvent::MTE1_MTE2>(aFree[as]);
            if(flat%(BP/BK)==BP/BK-1)SetFlag<HardEvent::MTE1_MTE2>(bFree[bs]);
            SetFlag<HardEvent::MTE1_M>(ready[slot]);WaitFlag<HardEvent::MTE1_M>(ready[slot]);
            Mmad(c,a2[slot*L0AE],b2[slot*L0BE],MmadParams{TM,TN,BK,uint8_t(chunk+1==d.kSteps?3:2),false,chunk==0});
            SetFlag<HardEvent::M_MTE1>(used[slot]);
            if(flat%(AP/BK)==AP/BK-1) {
                WaitFlag<HardEvent::MTE1_MTE2>(aFree[as]);
                const uint32_t next=apage+ASLOTS;
                if(next<aTotal) {
                    const uint32_t nextTile=next/d.aPages;
                    const uint32_t bm=TaskMb(nextTile,first,d.nBlocks);
                    const uint32_t b=bm/d.mBlocks,mb=bm%d.mBlocks;
                    const uint32_t kStart=AStart(next,group,d.aPages,d.bPages);
                    DataCopy(a1[as*ASTRIDE],lhs[uint64_t(b)*d.k*d.m+uint64_t(kStart)*d.m+mb*TM],
                        Nd2NzParams{1,AP,TM,0,static_cast<uint16_t>(d.m),AP,1,0});
                    SetFlag<HardEvent::MTE2_MTE1>(aReady[as]);
                }
            }
            if(flat%(BP/BK)==BP/BK-1) {
                WaitFlag<HardEvent::MTE1_MTE2>(bFree[bs]);
                const uint32_t next=bpage+BSLOTS;
                if(next<bTotal) {
                    const uint32_t nextTile=next/d.bPages;
                    const uint32_t task=first+nextTile,b=task/(d.mBlocks*d.nBlocks);
                    const uint32_t nb=TaskN(nextTile,first,last,group,d.nBlocks);
                    const uint32_t kStart=BStart(next,group,d.bPages);
                    DataCopy(b1[bs*BSTRIDE],rhs[uint64_t(b)*d.n*d.k+uint64_t(nb*TN)*d.k+kStart],
                        Nd2NzParams{1,TN,BP,0,static_cast<uint16_t>(d.k),TN,1,0});
                    SetFlag<HardEvent::MTE2_MTE1>(bReady[bs]);
                }
            }
            if(chunk+1==d.kSteps) {
                if(tile>=2)CrossCoreWaitFlag(CONSUMED);
                FixpipeParamsV220 fix{};fix.nSize=TN;fix.mSize=TM;fix.srcStride=TM;fix.dstStride=TN;fix.ndNum=1;fix.unitFlag=3;
                Fixpipe<float,float,CFG_ROW_MAJOR>(scratch[scratchOffset+(tile&1U)*TM*TN],c,fix);
                if(tile+1==tiles)SetFlag<HardEvent::FIX_M>(cFree);
                CrossCoreSetFlag<2,PIPE_FIX>(READY);
            }
        }
        for(uint32_t i=0;i<(total<2?total:2);++i)WaitFlag<HardEvent::M_MTE1>(used[i]);
        for(uint32_t i=0;i<(tiles<2?tiles:2);++i)CrossCoreWaitFlag(CONSUMED);
        WaitFlag<HardEvent::FIX_M>(cFree);
        for(uint32_t i=0;i<ASLOTS;++i) {
            pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(aReady[i]);pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(aFree[i]);
        }
        for(uint32_t i=0;i<BSLOTS;++i) {
            pipe.ReleaseEventID<HardEvent::MTE2_MTE1>(bReady[i]);pipe.ReleaseEventID<HardEvent::MTE1_MTE2>(bFree[i]);
        }
        for(uint32_t i=0;i<2;++i) {
            pipe.ReleaseEventID<HardEvent::M_MTE1>(used[i]);pipe.ReleaseEventID<HardEvent::MTE1_M>(ready[i]);
        }
    }
    if ASCEND_IS_AIV {
        TBuf<TPosition::VECCALC> inputBuf,workBuf,maxBuf,rowBuf;
        pipe.InitBuffer(inputBuf,INPUT);pipe.InitBuffer(workBuf,WORK);
        pipe.InitBuffer(maxBuf,ROWS);pipe.InitBuffer(rowBuf,ROWS);
        auto input=inputBuf.Get<float>();auto work=workBuf.Get<uint8_t>();
        auto maxima=maxBuf.Get<float>();auto row=rowBuf.Get<float>();
        GlobalTensor<float> partial,output;
        partial.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(partialGm),d.partialElements);
        output.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y),d.batch);
        const auto inputReusable=pipe.FetchEventID(HardEvent::V_MTE2),inputReady=pipe.FetchEventID(HardEvent::MTE2_V);
        const auto rowsReady=pipe.FetchEventID(HardEvent::V_MTE3),rowsStored=pipe.FetchEventID(HardEvent::MTE3_V);
        uint32_t reduceShape[2]={128,TN},sumShape[2]={1,TM};
        const uint32_t firstBm=first/d.nBlocks;
        Duplicate(row,LOWEST,TM);PipeBarrier<PIPE_V>();
        for(uint32_t tile=0;tile<tiles;++tile) {
            const uint32_t bm=TaskMb(tile,first,d.nBlocks);
            SetFlag<HardEvent::V_MTE2>(inputReusable);WaitFlag<HardEvent::V_MTE2>(inputReusable);
            CrossCoreWaitFlag(READY);
            DataCopy(input,scratch[scratchOffset+(tile&1U)*TM*TN],TM*TN);
            SetFlag<HardEvent::MTE2_V>(inputReady);WaitFlag<HardEvent::MTE2_V>(inputReady);
            CrossCoreSetFlag<2,PIPE_MTE2>(CONSUMED);
            for(uint32_t rr=0;rr<TM;rr+=128) {
                ReduceMax<float,Pattern::Reduce::AR>(maxima[rr],input[rr*TN],work,reduceShape,true);
                PipeBarrier<PIPE_V>();Max(row[rr],row[rr],maxima[rr],128);PipeBarrier<PIPE_V>();
            }
            if(tile+1==tiles||TaskMb(tile+1,first,d.nBlocks)!=bm) {
                const uint32_t firstTask=bm*d.nBlocks,lastTask=(bm+1)*d.nBlocks;
                const uint32_t g0=(uint64_t(firstTask+1)*d.blockDim-1)/d.workItems;
                const uint32_t g1=(uint64_t(lastTask)*d.blockDim-1)/d.workItems;
                const uint32_t batch=bm/d.mBlocks,mb=bm%d.mBlocks;
                const uint64_t base=uint64_t(batch)*d.contributorSlots*d.m+mb*TM;
                SetFlag<HardEvent::V_MTE3>(rowsReady);WaitFlag<HardEvent::V_MTE3>(rowsReady);
                DataCopy(partial[base+uint64_t(group-g0)*d.m],row,TM);
                SetFlag<HardEvent::MTE3_V>(rowsStored);WaitFlag<HardEvent::MTE3_V>(rowsStored);
                if(group==g0 && g1-g0+1<d.contributorSlots) {
                    Duplicate(row,LOWEST,TM);PipeBarrier<PIPE_V>();
                    for(uint32_t p=g1-g0+1;p<d.contributorSlots;++p) {
                        SetFlag<HardEvent::V_MTE3>(rowsReady);WaitFlag<HardEvent::V_MTE3>(rowsReady);
                        DataCopy(partial[base+uint64_t(p)*d.m],row,TM);
                        SetFlag<HardEvent::MTE3_V>(rowsStored);WaitFlag<HardEvent::MTE3_V>(rowsStored);
                    }
                }
                if(tile+1<tiles) {Duplicate(row,LOWEST,TM);PipeBarrier<PIPE_V>();}
            }
        }
        SyncAll<true>();
        if(group==0) {
            DataCopyPad(input,partial,{1,static_cast<uint32_t>(d.partialElements*sizeof(float)),0,0,0},{false,0,0,0});
            SetFlag<HardEvent::MTE2_V>(inputReady);WaitFlag<HardEvent::MTE2_V>(inputReady);
            auto merged=input[d.partialElements];
            uint32_t fullSumShape[2]={1,d.m};
            for(uint32_t b=0;b<d.batch;++b) {
                const uint64_t base=uint64_t(b)*d.contributorSlots*d.m;
                DataCopy(merged,input[base],d.m);PipeBarrier<PIPE_V>();
                for(uint32_t p=1;p<d.contributorSlots;++p) {
                    Max(merged,merged,input[base+uint64_t(p)*d.m],d.m);PipeBarrier<PIPE_V>();
                }
                ReduceSum<float,Pattern::Reduce::AR>(maxima,merged,work,fullSumShape,true);
                SetFlag<HardEvent::V_MTE3>(rowsReady);WaitFlag<HardEvent::V_MTE3>(rowsReady);
                DataCopyPad(output[b],maxima,{1,sizeof(float),0,0,0});
                SetFlag<HardEvent::MTE3_V>(rowsStored);WaitFlag<HardEvent::MTE3_V>(rowsStored);
            }
        }
    }
}
}  

#define DEFINE_RAW_TT_M256N128(NAME,TYPE) \
extern "C" __global__ __aicore__ void NAME(GM_ADDR a,GM_ADDR b,GM_ADDR y, \
    GM_ADDR scratch,GM_ADDR partial,raw_tt_m256n128::Plan d) { \
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1); \
    raw_tt_m256n128::Run<TYPE>(a,b,y,scratch,partial,d); }
DEFINE_RAW_TT_M256N128(batch_matmul_raw_tt_m256n128_fp16,half)
#undef DEFINE_RAW_TT_M256N128

inline bool GenerateRawTtM256N128Plan(platform_ascendc::PlatformAscendC *platform,
    uint32_t batch,uint32_t m,uint32_t n,uint32_t k,int64_t cores,raw_tt_m256n128::Plan &d)
{
    using namespace raw_tt_m256n128;
    if(!platform||batch==0||m<TM||n<TN||k<BP||m%TM||n%TN||k%BP||
       m>65535||n>65535||k>65535||cores<1)return false;
    uint64_t l1=0,l0a=0,l0b=0,l0c=0,ub=0;
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L1,l1);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_A,l0a);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_B,l0b);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::L0_C,l0c);
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB,ub);
    if(L1_BYTES>l1||L0A_BYTES>l0a||L0B_BYTES>l0b||L0C_BYTES>l0c||UB_BYTES>ub)return false;
    uint32_t maximum=0,minimum=0;
    GetReduceMaxMaxMinTmpSize(ge::Shape({128,TN}),ge::DT_FLOAT,
        ReducePattern::AR,true,false,maximum,minimum);
    if(maximum>WORK||minimum>WORK)return false;
    GetReduceSumMaxMinTmpSize(ge::Shape({1,m}),ge::DT_FLOAT,
        ReducePattern::AR,true,false,maximum,minimum);
    if(maximum>WORK||minimum>WORK)return false;
    const uint64_t mBlocks=m/TM,nBlocks=n/TN,kSteps=k/BK;
    const uint64_t workItems=uint64_t(batch)*mBlocks*nBlocks;
    if(workItems==0||workItems>0xffffffffULL)return false;
    const uint64_t hardware=std::min<uint64_t>(platform->GetCoreNumAic(),platform->GetCoreNumAiv());
    const uint64_t blockDim=std::min<uint64_t>(
        std::min<uint64_t>(std::min<uint64_t>(cores,hardware),workItems),MAX_GROUPS);
    if(blockDim==0)return false;
    d.batch=batch;d.m=m;d.n=n;d.k=k;
    d.mBlocks=static_cast<uint32_t>(mBlocks);d.nBlocks=static_cast<uint32_t>(nBlocks);
    d.kSteps=static_cast<uint32_t>(kSteps);d.aPages=k/AP;d.bPages=k/BP;
    d.workItems=static_cast<uint32_t>(workItems);d.blockDim=static_cast<uint32_t>(blockDim);
    uint32_t segments=0;
    for(uint32_t g=0;g<d.blockDim;++g) {
        d.segmentPrefix[g]=static_cast<uint16_t>(segments);
        const uint32_t first=uint64_t(g)*d.workItems/d.blockDim;
        const uint32_t last=uint64_t(g+1)*d.workItems/d.blockDim;
        segments+=(last-1)/d.nBlocks-first/d.nBlocks+1;
    }
    d.segmentPrefix[d.blockDim]=static_cast<uint16_t>(segments);
    uint32_t contributorSlots=1;
    for(uint64_t bm=0;bm<uint64_t(batch)*mBlocks;++bm) {
        const uint64_t firstTask=bm*nBlocks,lastTask=(bm+1)*nBlocks;
        const uint32_t g0=((firstTask+1)*blockDim-1)/workItems;
        const uint32_t g1=(lastTask*blockDim-1)/workItems;
        contributorSlots=std::max(contributorSlots,g1-g0+1);
    }
    const uint64_t partialElements=uint64_t(batch)*contributorSlots*m;
    if(partialElements+m>INPUT/sizeof(float))return false;
    d.contributorSlots=contributorSlots;
    d.scratchElements=2*blockDim*TM*TN;d.partialElements=partialElements;
    return true;
}

inline bool TryRunRawTtM256N128(GM_ADDR x1,GM_ADDR x2,GM_ADDR y,
    uint32_t batch,uint32_t m,uint32_t n,uint32_t k,int32_t dtype,
    int64_t cores,aclrtStream stream,bool ta,bool tb)
{
    if(dtype!=1||!ta||!tb)return false;
    raw_tt_m256n128::Plan d{};
    if(!GenerateRawTtM256N128Plan(platform_ascendc::PlatformAscendCManager::GetInstance(),
        batch,m,n,k,cores,d))return false;
    uint8_t *scratch=nullptr,*partial=nullptr;
    if(aclrtMalloc(reinterpret_cast<void **>(&scratch),d.scratchElements*sizeof(float),ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS||
       aclrtMalloc(reinterpret_cast<void **>(&partial),d.partialElements*sizeof(float),ACL_MEM_MALLOC_HUGE_FIRST)!=ACL_SUCCESS) {
        if(scratch)aclrtFree(scratch);if(partial)aclrtFree(partial);return false;
    }
batch_matmul_raw_tt_m256n128_fp16<<<d.blockDim,nullptr,stream>>>(x1,x2,y,scratch,partial,d);
    const aclError result=aclrtSynchronizeStream(stream);
    aclrtFree(scratch);aclrtFree(partial);
    if(result!=ACL_SUCCESS)throw std::runtime_error("TT M256/N128 Raw device execution failed");
    return true;
}


extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo &info_x1,
    GM_ADDR x2, const TensorGroupInfo &info_x2, GM_ADDR y, const TensorGroupInfo &info_y,
    int64_t availableCoreNum, aclrtStream stream, bool transposeX1, bool transposeX2)
{
    if (!x1 || !x2 || !y || info_x1.numTensors != 1 || info_x2.numTensors != 1 ||
        info_y.numTensors != 1 || !info_x1.tensors || !info_x2.tensors || !info_y.tensors)
        throw std::runtime_error("Invalid tensor group");
    const auto &a = info_x1.tensors[0];
    const auto &b = info_x2.tensors[0];
    const auto &out = info_y.tensors[0];
    if (a.numDims != 3 || b.numDims != 3 || out.numDims != 1 ||
        !a.shape || !b.shape || !out.shape || a.dtype != b.dtype ||
        (a.dtype != 1 && a.dtype != 2) || out.dtype != 0)
        throw std::runtime_error("Invalid tensor type or rank");
    const int64_t batch = a.shape[0];
    const int64_t m = a.shape[transposeX1 ? 2 : 1];
    const int64_t k = a.shape[transposeX1 ? 1 : 2];
    const int64_t n = b.shape[transposeX2 ? 1 : 2];
    // These limits are the operator's documented input domain, not case routes.
    if (batch < 1 || batch > 64 || m < 1 || m > 8192 || n < 1 || n > 8192 ||
        k < 32 || k > 8192 || k % 8 != 0 || b.shape[0] != batch ||
        b.shape[transposeX2 ? 2 : 1] != k || out.shape[0] != batch ||
        batch * m * k > (int64_t(1) << 26) || batch * n * k > (int64_t(1) << 26))
        throw std::runtime_error("Input outside documented operator domain");
    if (TryRunTinySingleOutputShortK(x1,x2,y,batch,m,n,k,a.dtype,availableCoreNum,stream,transposeX1,transposeX2)) return;
    if (TryRunBf16TtVectorTile(x1,x2,y,batch,m,n,k,a.dtype,availableCoreNum,stream,transposeX1,transposeX2)) return;
    if (TryRunRawBf16TtFullAM112N64(x1,x2,y,batch,m,n,k,a.dtype,availableCoreNum,stream,transposeX1,transposeX2)) return;
    if (TryRunTinyStridedGather(x1,x2,y,batch,m,n,k,a.dtype,availableCoreNum,stream,transposeX1,transposeX2)) return;
    if (TryRunTinyContiguousVector(x1,x2,y,batch,m,n,k,a.dtype,availableCoreNum,stream,transposeX1,transposeX2)) return;
    if (TryRunRawNnFullTileFp16(x1,x2,y,batch,m,n,k,a.dtype,availableCoreNum,stream,transposeX1,transposeX2)) return;
    if (TryRunSmallVectorFamily(x1,x2,y,batch,m,n,k,a.dtype,availableCoreNum,stream,transposeX1,transposeX2)) return;
    if (TryRunRawNnTallMShortNk(x1,x2,y,batch,m,n,k,a.dtype,availableCoreNum,stream,transposeX1,transposeX2)) return;
    if (TryRunRawTnFullTile(x1,x2,y,batch,m,n,k,a.dtype,availableCoreNum,stream,transposeX1,transposeX2)) return;
    if (TryRunRawNtFullTileBf16(x1,x2,y,batch,m,n,k,a.dtype,availableCoreNum,stream,transposeX1,transposeX2)) return;
    if (TryRunRawBf16NtWideShortMk(x1,x2,y,batch,m,n,k,a.dtype,availableCoreNum,stream,transposeX1,transposeX2)) return;
    if (TryRunRawNtStream128(x1,x2,y,batch,m,n,k,a.dtype,availableCoreNum,stream,transposeX1,transposeX2)) return;
    if (TryRunRawBf16NnCrossNReduce(x1,x2,y,batch,m,n,k,a.dtype,availableCoreNum,stream,transposeX1,transposeX2)) return;
    if (TryRunRawTtSplitKSmall(x1,x2,y,batch,m,n,k,a.dtype,availableCoreNum,stream,transposeX1,transposeX2)) return;
    if (TryRunRawTtM256N128(x1,x2,y,batch,m,n,k,a.dtype,availableCoreNum,stream,transposeX1,transposeX2)) return;
    if (TryRunRawFullATn(x1,x2,y,batch,m,n,k,a.dtype,availableCoreNum,stream,transposeX1,transposeX2)) return;
    if (!run_fused_base_tiles(x1, x2, y, batch, m, n, k, a.dtype,
            availableCoreNum, stream, transposeX1, transposeX2))
        throw std::runtime_error("Generic tiling or workspace allocation failed before launch");
}
