// Fixed evaluator carrier. The controller supplies kernel.asc in this directory.
// Legacy Host C++ shares this process: the carrier is not a security boundary.
// Inputs are exact contiguous FP16/BF16 storage bytes; outputs are FP32.
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cmath>
#include <cstring>
#include <cerrno>
#include <algorithm>
#include <chrono>
#include <fstream>
#include <iomanip>
#include <iostream>
#include <limits>
#include <sstream>
#include <stdexcept>
#include <string>
#include <utility>
#include <vector>
#include "acl/acl.h"

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
// Exact ABI from the original official main.asc.
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include "kernel.asc"

namespace op_eval_harness {

constexpr size_t kGuardBytes = 512;
constexpr uint8_t kGuardValue = 0xD3;

struct Config {
    std::string x1, x2, output, mode = "correctness";
    int64_t batch = 0, m = 0, n = 0, k = 0, cores = 0;
    int32_t dtype = -1, device = 0;
    int32_t repeat = 3, warmup = 0;
    bool transposeX1 = false, transposeX2 = false;
};

std::string JsonString(const std::string &value)
{
    std::ostringstream out;
    out << '"';
    for (unsigned char c : value) {
        switch (c) {
        case '"': out << "\\\""; break;
        case '\\': out << "\\\\"; break;
        case '\n': out << "\\n"; break;
        case '\r': out << "\\r"; break;
        case '\t': out << "\\t"; break;
        default:
            if (c < 0x20) {
                out << "\\u" << std::hex << std::setw(4) << std::setfill('0')
                    << unsigned(c) << std::dec;
            } else {
                out << char(c);
            }
        }
    }
    out << '"';
    return out.str();
}

void CheckAcl(aclError code, const char *operation)
{
    if (code != ACL_SUCCESS) {
        throw std::runtime_error(std::string(operation) + ": acl_error=" +
            std::to_string(static_cast<int>(code)));
    }
}

int64_t ParseInteger(const std::string &text, const std::string &name)
{
    if (text.empty()) throw std::runtime_error("Missing integer for " + name);
    size_t used = 0;
    long long result = 0;
    try { result = std::stoll(text, &used, 10); }
    catch (const std::exception &) { throw std::runtime_error("Invalid integer for " + name); }
    if (used != text.size()) throw std::runtime_error("Invalid integer for " + name);
    return static_cast<int64_t>(result);
}

int32_t ParseBoundedInt(const std::string &value, const std::string &name,
    int64_t minimum, int64_t maximum)
{
    const int64_t parsed = ParseInteger(value, name);
    if (parsed < minimum || parsed > maximum)
        throw std::runtime_error("Out of range: " + name);
    return static_cast<int32_t>(parsed);
}

void PrintUsage()
{
    std::cout << "Usage: op_eval_runner --x1 FILE --x2 FILE --output FILE"
        " --b B --m M --n N --k K --dtype fp16|bf16"
        " [--transpose-x1 0|1] [--transpose-x2 0|1]"
        " [--device ID] [--cores N] [--mode correctness|timing|profile]"
        " [--repeat N] [--warmup N]\n"
        "cores=0 queries ACL Cube core count. repeat excludes warmup.\n"
        "correctness: repeated poison/input/guard/finite checks; bitwise equality is diagnostic.\n"
        "timing: ACL event span (secondary) and Host call+sync span.\n"
        "profile: no ACL events; use external msprof Task Duration.\n"
        "The controller checks numerical precision against an independent golden.\n";
}

Config ParseArgs(int argc, char **argv)
{
    Config c;
    std::vector<std::string> seen;
    for (int i = 1; i < argc; i += 2) {
        const std::string key(argv[i]);
        if (i + 1 >= argc) throw std::runtime_error("Missing value for " + key);
        if (std::find(seen.begin(), seen.end(), key) != seen.end())
            throw std::runtime_error("Duplicate option " + key);
        seen.push_back(key);
        const std::string value(argv[i + 1]);
        if (key == "--x1") c.x1 = value;
        else if (key == "--x2") c.x2 = value;
        else if (key == "--output") c.output = value;
        else if (key == "--b") c.batch = ParseInteger(value, key);
        else if (key == "--m") c.m = ParseInteger(value, key);
        else if (key == "--n") c.n = ParseInteger(value, key);
        else if (key == "--k") c.k = ParseInteger(value, key);
        else if (key == "--cores") c.cores = ParseInteger(value, key);
        else if (key == "--device") c.device = ParseBoundedInt(value, key, 0, 1023);
        else if (key == "--repeat") c.repeat = ParseBoundedInt(value, key, 1, 100000);
        else if (key == "--warmup") c.warmup = ParseBoundedInt(value, key, 0, 10000);
        else if (key == "--transpose-x1")
            c.transposeX1 = ParseBoundedInt(value, key, 0, 1) != 0;
        else if (key == "--transpose-x2")
            c.transposeX2 = ParseBoundedInt(value, key, 0, 1) != 0;
        else if (key == "--dtype") {
            if (value == "fp16" || value == "float16" || value == "1") c.dtype = 1;
            else if (value == "bf16" || value == "bfloat16" || value == "2") c.dtype = 2;
            else throw std::runtime_error("dtype must be fp16 or bf16");
        } else if (key == "--mode") c.mode = value;
        else throw std::runtime_error("Unknown option " + key);
    }
    if (c.x1.empty() || c.x2.empty() || c.output.empty())
        throw std::runtime_error("--x1, --x2 and --output are required");
    if (c.output == c.x1 || c.output == c.x2)
        throw std::runtime_error("Output must not replace an input file");
    if (c.dtype != 1 && c.dtype != 2) throw std::runtime_error("--dtype is required");
    if (c.batch < 1 || c.batch > 64 || c.m < 1 || c.m > 8192 ||
        c.n < 1 || c.n > 8192 || c.k < 32 || c.k > 8192 || c.k % 8 != 0 ||
        c.batch * c.m * c.k > (int64_t(1) << 26) ||
        c.batch * c.n * c.k > (int64_t(1) << 26))
        throw std::runtime_error("Shape outside documented BatchMatmulMaxSum domain");
    if (c.cores < 0 || c.cores > 65536) throw std::runtime_error("Invalid --cores");
    if (c.mode != "correctness" && c.mode != "timing" && c.mode != "profile")
        throw std::runtime_error("Unknown mode; use correctness, timing or profile");
    return c;
}

std::vector<uint8_t> ReadExact(const std::string &path, size_t bytes)
{
    std::ifstream file(path, std::ios::binary | std::ios::ate);
    if (!file) throw std::runtime_error("Cannot open input " + path);
    const std::streampos size = file.tellg();
    if (size < 0 || static_cast<uint64_t>(size) != static_cast<uint64_t>(bytes))
        throw std::runtime_error("Input size mismatch: " + path);
    file.seekg(0, std::ios::beg);
    std::vector<uint8_t> data(bytes);
    if (!file.read(reinterpret_cast<char *>(data.data()), static_cast<std::streamsize>(bytes)))
        throw std::runtime_error("Input read failed: " + path);
    return data;
}

void WriteExact(const std::string &path, const std::vector<float> &data)
{
    std::ofstream file(path, std::ios::binary | std::ios::trunc);
    if (!file) throw std::runtime_error("Cannot open output " + path);
    file.write(reinterpret_cast<const char *>(data.data()),
        static_cast<std::streamsize>(data.size() * sizeof(float)));
    file.flush();
    if (!file) throw std::runtime_error("Output write failed: " + path);
    file.close();
    if (file.fail()) throw std::runtime_error("Output close failed: " + path);
}

struct Session {
    bool initialized = false, deviceSet = false;
    int32_t device = 0;
    aclrtStream stream = nullptr;
    aclrtEvent start = nullptr, end = nullptr;
    std::vector<void *> allocations;

    void *Allocate(size_t bytes)
    {
        void *address = nullptr;
        CheckAcl(aclrtMalloc(&address, bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc");
        allocations.push_back(address);
        return address;
    }

    bool Cleanup()
    {
        bool ok = true;
        auto release = [&ok](aclError code, const char *operation) {
            if (code != ACL_SUCCESS) {
                ok = false;
                std::cerr << "{\"type\":\"cleanup_error\",\"operation\":"
                    << JsonString(operation) << ",\"acl_error\":" << int(code) << "}\n";
            }
        };
        if (stream) release(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream(cleanup)");
        if (end) { release(aclrtDestroyEvent(end), "aclrtDestroyEvent(end)"); end = nullptr; }
        if (start) { release(aclrtDestroyEvent(start), "aclrtDestroyEvent(start)"); start = nullptr; }
        for (auto it = allocations.rbegin(); it != allocations.rend(); ++it)
            release(aclrtFree(*it), "aclrtFree");
        allocations.clear();
        if (stream) { release(aclrtDestroyStream(stream), "aclrtDestroyStream"); stream = nullptr; }
        if (deviceSet) { release(aclrtResetDevice(device), "aclrtResetDevice"); deviceSet = false; }
        if (initialized) { release(aclFinalize(), "aclFinalize"); initialized = false; }
        return ok;
    }

    ~Session() { Cleanup(); }
};

std::vector<uint8_t> GuardedInput(const std::vector<uint8_t> &input)
{
    std::vector<uint8_t> data(input.size() + 2 * kGuardBytes, kGuardValue);
    std::memcpy(data.data() + kGuardBytes, input.data(), input.size());
    return data;
}

void PoisonOutput(std::vector<uint8_t> &data, size_t batch, uint32_t round)
{
    std::fill(data.begin(), data.end(), kGuardValue);
    const uint32_t poison = 0x7FC00000U | ((round + 1U) & 0x003FFFFFU);
    for (size_t b = 0; b < batch; ++b)
        std::memcpy(data.data() + kGuardBytes + b * sizeof(float), &poison, sizeof(poison));
}

void CheckGuards(const std::vector<uint8_t> &data, size_t payload, const char *name)
{
    for (size_t i = 0; i < kGuardBytes; ++i) {
        if (data[i] != kGuardValue || data[kGuardBytes + payload + i] != kGuardValue)
            throw std::runtime_error(std::string(name) + " guard changed");
    }
}

struct CallRecord {
    int32_t iteration;
    bool warmup;
    double hostUs;
    double eventUs;
    std::vector<float> output;
};

void PrintRecords(const std::vector<CallRecord> &records, bool events)
{
    std::cout << std::setprecision(17);
    for (const auto &r : records) {
        std::cout << "{\"type\":\"call\",\"iteration\":" << r.iteration
            << ",\"warmup\":" << (r.warmup ? "true" : "false")
            << ",\"host_us\":" << r.hostUs << ",\"event_us\":";
        if (events) std::cout << r.eventUs;
        else std::cout << "null";
        if (!r.output.empty()) {
            std::cout << ",\"output\":[";
            for (size_t i = 0; i < r.output.size(); ++i) {
                if (i) std::cout << ',';
                std::cout << r.output[i];
            }
            std::cout << ']';
        }
        std::cout << "}\n";
    }
}

int Run(const Config &c, std::string &stage)
{
    stage = "input";
    const size_t aBytes = size_t(c.batch) * size_t(c.m) * size_t(c.k) * sizeof(uint16_t);
    const size_t bBytes = size_t(c.batch) * size_t(c.n) * size_t(c.k) * sizeof(uint16_t);
    const size_t yBytes = size_t(c.batch) * sizeof(float);
    const auto aHost = GuardedInput(ReadExact(c.x1, aBytes));
    const auto bHost = GuardedInput(ReadExact(c.x2, bBytes));
    std::vector<uint8_t> yHost(yBytes + 2 * kGuardBytes);
    PoisonOutput(yHost, size_t(c.batch), 0);

    Session s;
    s.device = c.device;
    stage = "device_init";
    CheckAcl(aclInit(nullptr), "aclInit"); s.initialized = true;
    CheckAcl(aclrtSetDevice(c.device), "aclrtSetDevice"); s.deviceSet = true;
    CheckAcl(aclrtCreateStream(&s.stream), "aclrtCreateStream");
    int64_t cores = c.cores;
    if (!cores) CheckAcl(aclrtGetDeviceInfo(c.device, ACL_DEV_ATTR_CUBE_CORE_NUM, &cores),
        "aclrtGetDeviceInfo(CUBE_CORE_NUM)");
    if (cores <= 0) throw std::runtime_error("Device reported no available Cube cores");

    stage = "allocation";
    auto *aBase = static_cast<uint8_t *>(s.Allocate(aHost.size()));
    auto *bBase = static_cast<uint8_t *>(s.Allocate(bHost.size()));
    auto *yBase = static_cast<uint8_t *>(s.Allocate(yHost.size()));
    CheckAcl(aclrtMemcpy(aBase, aHost.size(), aHost.data(), aHost.size(), ACL_MEMCPY_HOST_TO_DEVICE), "Upload A");
    CheckAcl(aclrtMemcpy(bBase, bHost.size(), bHost.data(), bHost.size(), ACL_MEMCPY_HOST_TO_DEVICE), "Upload B");
    CheckAcl(aclrtMemcpy(yBase, yHost.size(), yHost.data(), yHost.size(), ACL_MEMCPY_HOST_TO_DEVICE), "Initialize output");
    const bool correctness = c.mode == "correctness";
    // Audit every profiled invocation too. These transfers are outside the
    // measured device compute task; reference/candidates share this protocol.
    const bool auditCalls = correctness || c.mode == "profile";
    const bool events = c.mode == "timing";
    if (events) {
        CheckAcl(aclrtCreateEventExWithFlag(&s.start, ACL_EVENT_TIME_LINE), "Create start event");
        CheckAcl(aclrtCreateEventExWithFlag(&s.end, ACL_EVENT_TIME_LINE), "Create end event");
    }

    int64_t aShape[3] = {c.batch, c.transposeX1 ? c.k : c.m, c.transposeX1 ? c.m : c.k};
    int64_t bShape[3] = {c.batch, c.transposeX2 ? c.n : c.k, c.transposeX2 ? c.k : c.n};
    int64_t yShape[1] = {c.batch};
    TensorInfo aTensor{aShape, 3, c.dtype}, bTensor{bShape, 3, c.dtype}, yTensor{yShape, 1, 0};
    TensorGroupInfo aInfo{&aTensor, 1}, bInfo{&bTensor, 1}, yInfo{&yTensor, 1};

    std::vector<CallRecord> records;
    records.reserve(size_t(c.warmup) + size_t(c.repeat));
    std::vector<float> output(size_t(c.batch), 0.0f), firstOutput;
    bool repeatBitwiseEqual = true;
    std::vector<uint8_t> aRead(aHost.size()), bRead(bHost.size());
    stage = "execute";
    for (int32_t i = 0; i < c.warmup + c.repeat; ++i) {
        if (auditCalls) {
            PoisonOutput(yHost, size_t(c.batch), uint32_t(i + 1));
            CheckAcl(aclrtMemcpy(yBase, yHost.size(), yHost.data(), yHost.size(), ACL_MEMCPY_HOST_TO_DEVICE), "Poison output");
        }
        CheckAcl(aclrtSynchronizeStream(s.stream), "Synchronize before call");
        if (events) CheckAcl(aclrtRecordEvent(s.start, s.stream), "Record start event");
        const auto startWall = std::chrono::steady_clock::now();
        // Match the official Host ABI's address-space cast accepted by ASC.
        run_kernel((GM_ADDR)(aBase + kGuardBytes), aInfo,
            (GM_ADDR)(bBase + kGuardBytes), bInfo,
            (GM_ADDR)(yBase + kGuardBytes), yInfo,
            cores, s.stream, c.transposeX1, c.transposeX2);
        if (events) CheckAcl(aclrtRecordEvent(s.end, s.stream), "Record end event");
        CheckAcl(aclrtSynchronizeStream(s.stream), "Synchronize after call");
        const auto endWall = std::chrono::steady_clock::now();
        double eventUs = 0.0;
        if (events) {
            float milliseconds = 0.0f;
            CheckAcl(aclrtEventElapsedTime(&milliseconds, s.start, s.end), "Event elapsed time");
            if (!std::isfinite(milliseconds) || milliseconds < 0.0f)
                throw std::runtime_error("Invalid ACL event duration");
            eventUs = double(milliseconds) * 1000.0;
        }
        CallRecord record{i - c.warmup, i < c.warmup,
            std::chrono::duration<double, std::micro>(endWall - startWall).count(), eventUs, {}};
        if (auditCalls) {
            stage = "correctness_memory_checks";
            CheckAcl(aclrtMemcpy(aRead.data(), aRead.size(), aBase, aRead.size(), ACL_MEMCPY_DEVICE_TO_HOST), "Read A");
            CheckAcl(aclrtMemcpy(bRead.data(), bRead.size(), bBase, bRead.size(), ACL_MEMCPY_DEVICE_TO_HOST), "Read B");
            CheckAcl(aclrtMemcpy(yHost.data(), yHost.size(), yBase, yHost.size(), ACL_MEMCPY_DEVICE_TO_HOST), "Read output");
            if (aRead != aHost) throw std::runtime_error("A input or its guard changed");
            if (bRead != bHost) throw std::runtime_error("B input or its guard changed");
            CheckGuards(yHost, yBytes, "Output");
            std::memcpy(output.data(), yHost.data() + kGuardBytes, yBytes);
            for (float v : output)
                if (!std::isfinite(v)) throw std::runtime_error("Non-finite or unwritten output");
            if (firstOutput.empty()) firstOutput = output;
            else if (std::memcmp(firstOutput.data(), output.data(), yBytes) != 0)
                repeatBitwiseEqual = false;
            record.output = output;
            // v2 external numerical verifier reads every call's raw bytes.
            // No golden value is passed into the candidate execution process.
            WriteExact(c.output + ".call-" + std::to_string(i), output);
            stage = "execute";
        }
        records.push_back(std::move(record));
    }

    // The legacy secondary timing mode audits its final state here. Correctness
    // and profile modes have already captured/checksummed every invocation.
    stage = "final_memory_checks";
    if (!auditCalls) {
        CheckAcl(aclrtMemcpy(aRead.data(), aRead.size(), aBase, aRead.size(), ACL_MEMCPY_DEVICE_TO_HOST), "Read final A");
        CheckAcl(aclrtMemcpy(bRead.data(), bRead.size(), bBase, bRead.size(), ACL_MEMCPY_DEVICE_TO_HOST), "Read final B");
        CheckAcl(aclrtMemcpy(yHost.data(), yHost.size(), yBase, yHost.size(), ACL_MEMCPY_DEVICE_TO_HOST), "Read final output");
        if (aRead != aHost) throw std::runtime_error("A input or its guard changed");
        if (bRead != bHost) throw std::runtime_error("B input or its guard changed");
        CheckGuards(yHost, yBytes, "Output");
        std::memcpy(output.data(), yHost.data() + kGuardBytes, yBytes);
        for (float v : output)
            if (!std::isfinite(v)) throw std::runtime_error("Non-finite or unwritten final output");
    }
    stage = "output";
    WriteExact(c.output, output);
    stage = "cleanup";
    if (!s.Cleanup()) throw std::runtime_error("ACL cleanup failed");
    PrintRecords(records, events);
    std::cout << "{\"type\":\"summary\",\"status\":\"ok\",\"mode\":" << JsonString(c.mode)
        << ",\"shape\":[" << c.batch << ',' << c.m << ',' << c.n << ',' << c.k << ']'
        << ",\"dtype\":" << c.dtype << ",\"device\":" << c.device << ",\"cores\":" << cores
        << ",\"measured_calls\":" << c.repeat << ",\"warmup_calls\":" << c.warmup
        << ",\"guard_bytes\":" << kGuardBytes << ",\"input_unchanged\":true,\"guards_ok\":true"
        << ",\"output_finite\":true,\"repeat_bitwise_equal\":" << (correctness ? (repeatBitwiseEqual ? "true" : "false") : "null")
        << ",\"event_available\":" << (events ? "true" : "false")
        << ",\"numerical_golden_checked\":false,\"output_file\":" << JsonString(c.output) << "}\n";
    std::cout.flush();
    return 0;
}

} // namespace op_eval_harness

int main(int argc, char **argv)
{
    std::string stage = "arguments";
    try {
        if (argc == 2 && (std::string(argv[1]) == "--help" || std::string(argv[1]) == "-h")) {
            op_eval_harness::PrintUsage();
            return 0;
        }
        const auto config = op_eval_harness::ParseArgs(argc, argv);
        return op_eval_harness::Run(config, stage);
    } catch (const std::exception &e) {
        std::cerr << "{\"type\":\"error\",\"status\":\"failed\",\"stage\":"
            << op_eval_harness::JsonString(stage) << ",\"message\":"
            << op_eval_harness::JsonString(e.what()) << "}\n";
    } catch (...) {
        std::cerr << "{\"type\":\"error\",\"status\":\"failed\",\"stage\":"
            << op_eval_harness::JsonString(stage) << ",\"message\":\"Unknown exception\"}\n";
    }
    return 1;
}
