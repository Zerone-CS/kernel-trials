{
  "schema_version": 1,
  "id": "batch_matmul_reduce",
  "version": "2.0.0-dev",
  "task": "task.md",
  "editable_file": "kernel.asc",
  "tracks": {
    "from_scratch": "starters/from_scratch/kernel.asc",
    "optimize": "starters/optimize/kernel.asc"
  },
  "harness": "harness",
  "public_files": {},
  "adapter": "judge.py",
  "cases": "cases.json",
  "protocol": "protocol.json",
  "reference": "reference/kernel.asc",
  "security": {"operator_profile": "legacy_host_untrusted"},
  "build": {
    "commands": [
      ["cmake", "-S", "{project}", "-B", "{build}", "-DNPU_ARCH=dav-2201"],
      ["cmake", "--build", "{build}", "--parallel", "2"]
    ],
    "runner": "op_eval_runner"
  },
  "candidate_policy": {
    "maximum_source_bytes": 2097152,
    "allowed_include_headers": [
      "kernel_operator.h", "kernel_tiling/kernel_tiling.h", "lib/matmul_intf.h",
      "tiling/tiling_api.h", "tiling/platform/platform_ascendc.h", "acl/acl.h",
      "cstddef", "cstdint", "cmath", "cstring", "cstdio", "cstdlib",
      "algorithm", "array", "vector", "type_traits", "limits", "utility", "stdexcept"
    ]
  }
}
